---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeaderV2 from '../components/layout/HeaderV2.astro';
import FooterV2 from '../components/layout/FooterV2.astro';
import { withBase } from '../utils/base';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** `v2` aplica o Design System 2.0 (Header/Footer V2); padrão preserva o atual. */
  variant?: 'default' | 'v2';
}

const {
  title,
  description = 'Blog pessoal e acervo tecnológico de Guilherme Gomes: desenvolvimento web, Linux, projetos open source, jogos, leituras e cultura.',
  image = 'https://github.com/Guilhermegomeslima.png',
  type = 'website',
  noindex = false,
  variant = 'default',
} = Astro.props;

const isV2 = variant === 'v2';

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={isV2 ? '#080808' : '#060910'} />
    {isV2 &&
      [
        'cormorant-garamond-normal-latin',
        'cormorant-garamond-italic-latin',
        'inter-latin',
      ].map((font) => (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          crossorigin
          href={withBase(`/fonts/${font}.woff2`)}
        />
      ))}
    <meta name="author" content="Guilherme Gomes" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="guilherme.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body
    class={
      isV2
        ? 'bg-v2-bg text-v2-text v2-scope flex min-h-screen flex-col'
        : 'bg-bg text-text flex min-h-screen flex-col'
    }
    id={isV2 ? 'top' : undefined}
  >
    <a
      href="#main-content"
      class={
        isV2
          ? 'sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:border focus:border-v2-border focus:bg-v2-text focus:px-4 focus:py-2 font-mono text-xs font-bold text-v2-bg focus:shadow-lg focus:outline-hidden'
          : 'sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:border focus:border-border focus:bg-accent focus:px-4 focus:py-2 font-mono text-xs font-bold text-bg focus:shadow-lg focus:outline-hidden'
      }
    >
      Pular para o conteúdo principal
    </a>
    {isV2 ? <HeaderV2 /> : <Header />}
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    {isV2 ? <FooterV2 /> : <Footer />}
  </body>
</html>
