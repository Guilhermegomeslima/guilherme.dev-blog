---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import { categories } from '../../data/categories';
---

<Section id="secoes">
  <Container>
    <SectionHeading
      eyebrow="// ACERVO & MÓDULOS"
      title="Explorar seções"
      description="Módulos temáticos de conhecimento, projetos, registros técnicos e acervo cultural em desenvolvimento."
    />

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {categories.map((item) => (
        <Card
          interactive={item.available}
          class="flex flex-col justify-between border-border/70 bg-surface/90 backdrop-blur-xs transition-colors duration-200"
        >
          <div>
            <div class="mb-4 flex items-center justify-between border-b border-border/50 pb-3">
              <span class="font-mono text-xs font-semibold tracking-wider text-accent/80">
                {item.code}
              </span>
              <span class="rounded border border-border/80 bg-surface-raised px-2 py-0.5 font-mono text-[11px] tracking-wide text-text-muted uppercase">
                {item.badge}
              </span>
            </div>

            <h3 class="font-display text-lg font-bold tracking-tight text-text">
              {item.title}
            </h3>

            <p class="font-body mt-2 text-sm leading-relaxed text-text-muted">
              {item.description}
            </p>
          </div>

          <div class="mt-6 border-t border-border/40 pt-4">
            {item.available ? (
              <a
                href={item.href}
                class="group inline-flex items-center gap-2 font-mono text-xs text-accent transition-colors hover:text-accent-alt focus-visible:outline-accent"
              >
                <span>Acessar seção</span>
                <span
                  aria-hidden="true"
                  class="transition-transform duration-200 group-hover:translate-x-1"
                >
                  &rarr;
                </span>
              </a>
            ) : (
              <div class="flex items-center justify-between font-mono text-xs text-text-muted/70">
                <span class="inline-flex items-center gap-1.5">
                  <span class="h-1.5 w-1.5 rounded-full bg-border" />
                  Módulo em preparação
                </span>
                <span class="text-[10px] uppercase text-text-muted/50">
                  Pós-MVP
                </span>
              </div>
            )}
          </div>
        </Card>
      ))}
    </div>
  </Container>
</Section>
