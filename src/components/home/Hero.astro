---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
---

<section
  aria-labelledby="hero-title"
  class="relative overflow-hidden border-b border-border py-20 sm:py-28 lg:py-32"
>
  <!-- Efeito de gradiente atmosférico cyberpunk de fundo -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-30"
    aria-hidden="true"
  >
    <div class="h-96 w-[42rem] rounded-full bg-gradient-to-tr from-accent/20 via-accent-alt/15 to-transparent blur-3xl"></div>
  </div>

  <Container>
    <div class="max-w-3xl">
      <!-- Rótulo / Status de sistema -->
      <div class="mb-6 flex items-center gap-3">
        <span
          class="inline-block h-2 w-2 rounded-full bg-accent shadow-[0_0_8px_var(--color-accent)] motion-safe:animate-pulse"
          aria-hidden="true"
        ></span>
        <span class="font-mono text-xs uppercase tracking-widest text-accent">
          Sistema // Terminal pessoal ativo
        </span>
      </div>

      <!-- Título principal com tipografia display de alto impacto -->
      <h1
        id="hero-title"
        class="font-display text-4xl font-extrabold tracking-tight text-text sm:text-6xl lg:text-7xl"
      >
        Guilherme <span class="text-accent">Gomes</span>
      </h1>

      <!-- Apresentação curta e autêntica -->
      <p class="font-display mt-4 text-lg font-medium text-text sm:text-2xl">
        Desenvolvedor em formação, apaixonado por Linux, tecnologia e sistemas.
      </p>

      <!-- Subtítulo situando o acervo do blog -->
      <p class="font-body mt-4 text-base leading-relaxed text-text-muted sm:text-lg">
        Estudante de Análise e Desenvolvimento de Sistemas (FAMINAS). Este é o
        meu espaço autoral e acervo digital sobre desenvolvimento web, open
        source, jogos, filmes, leituras e o sonho contínuo de construir meu
        próprio sistema operacional.
      </p>

      <!-- Ações rápidas e acessíveis -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href="#sobre-resumo"> Conhecer trajetória </Button>
        <Button
          href="https://github.com/Guilhermegomeslima"
          external
          variant="secondary"
        >
          GitHub Profile
        </Button>
      </div>
    </div>
  </Container>
</section>
