---
/**
 * Hero da Home V2 (docs/DESIGN_SYSTEM_V2.md §4.1 e references/home-hero.png).
 * Fotografia integrada ao fundo, sem moldura; texto à esquerda.
 */
import { withBase } from '../../utils/base';
---

<section
  aria-labelledby="hero-title"
  class="border-v2-border/60 relative isolate flex min-h-[34rem] items-center overflow-hidden border-b lg:min-h-[min(calc(100svh-4.7rem),52rem)]"
>
  <!-- Fotografia decorativa (alt vazio): telhados e névoa. Prioridade de carga por ser LCP. -->
  <img
    src={withBase('/images/home/hero.webp')}
    alt=""
    width="2200"
    height="1238"
    fetchpriority="high"
    decoding="async"
    class="v2-hero-photo absolute inset-0 -z-20 h-full w-full object-cover object-[62%_40%] grayscale-[0.85] contrast-[1.05] brightness-[0.85] lg:inset-y-0 lg:right-auto lg:left-[34%] lg:w-[78%] lg:max-w-none lg:object-left lg:[mask-image:linear-gradient(to_right,transparent,black_40%)]"
  />
  <!-- Contraste em telas estreitas: o texto cobre a fotografia. -->
  <div
    aria-hidden="true"
    class="v2-hero-mobile-veil absolute inset-0 -z-10 bg-v2-bg/50 lg:hidden"
  ></div>
  <!-- Sombreamento: esquerda mergulha no preto; base funde com a próxima seção. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-linear-to-r from-v2-bg from-15% via-v2-bg/75 via-40% to-transparent to-85%"
  ></div>
  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-linear-to-t from-v2-bg to-transparent"
  ></div>

  <!-- Detalhes editoriais laterais (presentes na referência) -->
  <p
    aria-hidden="true"
    class="font-v2-mono text-v2-text-muted/50 absolute top-10 right-[4.5rem] hidden text-[0.5rem] tracking-[0.12em] lg:block"
  >
    35.0116° N &nbsp;&nbsp; 135.7681° E
  </p>
  <div
    aria-hidden="true"
    class="absolute top-[45%] right-[4.5rem] hidden flex-col items-center gap-3 lg:flex"
  >
    <span class="font-v2-mono text-v2-text-muted/60 text-[0.5rem]">001</span>
    <span class="bg-v2-accent/80 h-28 w-px"></span>
  </div>
  <p
    aria-hidden="true"
    class="font-v2-mono text-v2-text-muted/60 absolute bottom-10 left-[4.5rem] hidden items-center gap-4 text-[0.5rem] tracking-[0.2em] uppercase lg:flex"
  >
    Descer <span class="bg-v2-text-muted/40 h-px w-14"></span>
  </p>

  <div class="w-full px-6 py-20 sm:px-10 lg:px-[7.2%]">
    <p class="v2-eyebrow text-v2-text-muted flex items-center gap-4 text-[0.625rem] tracking-[0.25em]">
      <span aria-hidden="true" class="bg-v2-accent h-px w-7"></span>
      Arquivo pessoal
      <span aria-hidden="true" class="text-v2-text-muted/50">
        /
      </span>
      guilherme.dev
    </p>

    <h1
      id="hero-title"
      class="font-v2-display text-v2-text mt-9 text-[clamp(3.25rem,6.5vw,7.8rem)] leading-[0.85] font-medium tracking-[-0.02em]"
    >
      Ideias, código
      <br />e{' '}
      <em class="from-v2-text to-v2-text-muted bg-linear-to-r bg-clip-text pr-[0.1em] font-medium text-transparent italic">
        histórias.
      </em>
    </h1>

    <p class="font-v2-sans text-v2-text-muted mt-10 max-w-[31rem] text-sm leading-[1.85] font-light">
      Um espaço pessoal sobre tecnologia, Linux, jogos, cinema, música e tudo
      aquilo que merece ser registrado.
    </p>

    <div class="mt-12 flex flex-col items-start gap-4">
      <a
        href="#acervo"
        class="v2-focus group border-v2-accent hover:border-v2-text font-v2-sans text-v2-text inline-flex items-center gap-5 border-b pb-3 text-[0.625rem] tracking-[0.2em] uppercase transition-colors motion-reduce:transition-none"
      >
        Explorar o acervo
        <span
          aria-hidden="true"
          class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
        >
          →
        </span>
      </a>

      <a
        href={withBase('/sobre/')}
        class="v2-focus group font-v2-sans text-v2-text-muted hover:text-v2-text inline-flex min-h-8 items-center gap-3 text-[0.5625rem] tracking-[0.22em] uppercase transition-colors motion-reduce:transition-none"
      >
        Conheça o autor
        <span
          aria-hidden="true"
          class="text-v2-accent-warm/80 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-v2-accent-warm motion-reduce:transition-none"
        >
          →
        </span>
      </a>
    </div>
  </div>
</section>
