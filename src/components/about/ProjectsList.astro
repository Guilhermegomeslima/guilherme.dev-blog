---
/**
 * Registro 005 — Projetos e conexões
 * Encerramento da página Sobre com os projetos reais selecionados,
 * acesso direto à página /projetos/ e aos links reais de presença online.
 */
import { socialLinks } from '../../data/social';
import { withBase } from '../../utils/base';

interface ProjectItem {
  id: string;
  name: string;
  tagline: string;
  description: string;
  tags: string[];
  repoUrl: string;
}

const projects: ProjectItem[] = [
  {
    id: 'PRJ-01',
    name: 'Ludoteca Pessoal',
    tagline: 'Gestão e catálogo de acervo lúdico',
    description:
      'Sistema para catalogação, organização e acompanhamento de jogos de tabuleiro e digitais com filtros e parâmetros personalizados.',
    tags: ['Web', 'TypeScript', 'Interface'],
    repoUrl: 'https://github.com/Guilhermegomeslima/Ludoteca-Digital-Pessoal',
  },
  {
    id: 'PRJ-02',
    name: 'A Chave para o Combate às Queimadas',
    tagline: 'Conscientização socioambiental',
    description:
      'Iniciativa web voltada à disseminação de dados e alertas sobre preservação ecológica e impactos ambientais das queimadas.',
    tags: ['HTML5', 'CSS3', 'Impacto Social'],
    repoUrl:
      'https://github.com/Guilhermegomeslima/A-Chave-Para-o-Combate-as-Queimadas',
  },
  {
    id: 'PRJ-03',
    name: 'Minecraft Fanmade Site',
    tagline: 'Experimento de interface temática',
    description:
      'Aplicação web explorando a atmosfera, elementos visuais e universo de Minecraft com foco em fidelidade estética e layout.',
    tags: ['Design', 'Web Front-end', 'CSS'],
    repoUrl: 'https://github.com/Guilhermegomeslima/Minecraft-Fanmade-Website',
  },
  {
    id: 'PRJ-04',
    name: 'Exercícios de Java',
    tagline: 'Algoritmos e estruturas de dados',
    description:
      'Laboratório prático contendo soluções de problemas, conceitos essenciais de programação orientada a objetos (POO) e lógica computacional.',
    tags: ['Java', 'POO', 'Algoritmos'],
    repoUrl: 'https://github.com/Guilhermegomeslima/Exercicios-de-Java',
  },
  {
    id: 'PRJ-05',
    name: 'BloomTech Gardens',
    tagline: 'Conceito web ecológico e moderno',
    description:
      'Interface desenvolvida com ênfase em tecnologia sustentável, estética verde e usabilidade responsiva em múltiplos dispositivos.',
    tags: ['UI Design', 'Front-end', 'Sustentabilidade'],
    repoUrl: 'https://github.com/Guilhermegomeslima/BloomTech-Gardens',
  },
];
---

<section aria-labelledby="projetos-conexoes-title" class="pt-20 pb-12 lg:pt-28">
  <!-- Cabeçalho editorial -->
  <div class="grid gap-6 lg:grid-cols-[16.5rem_minmax(0,1fr)_20rem] lg:items-end lg:gap-0">
    <p class="font-v2-mono text-v2-text-muted flex items-center gap-4 text-[0.5625rem] tracking-[0.2em] uppercase lg:self-start lg:pt-2">
      <span class="text-v2-accent">005</span>
      <span aria-hidden="true" class="bg-v2-border h-px w-6"></span>
      <span>Projetos e conexões</span>
    </p>

    <h2
      id="projetos-conexoes-title"
      class="font-v2-display text-v2-text max-w-[38rem] text-[clamp(2.1rem,3.2vw,3.5rem)] leading-[1.04] font-medium tracking-[-0.01em]"
    >
      Obras selecionadas e canais de contato.
    </h2>

    <div class="lg:justify-self-end">
      <a
        href={withBase('/projetos/')}
        class="v2-focus group border-v2-accent hover:border-v2-text font-v2-sans text-v2-text inline-flex items-center gap-4 border-b pb-2.5 text-[0.625rem] tracking-[0.2em] uppercase transition-colors motion-reduce:transition-none"
      >
        <span>Explorar página Projetos</span>
        <span
          aria-hidden="true"
          class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
        >
          →
        </span>
      </a>
    </div>
  </div>

  <!-- Composição assimétrica: Índice de projetos (8 colunas) + Presença online (4 colunas) -->
  <div class="mt-14 grid grid-cols-1 gap-12 lg:mt-20 lg:grid-cols-12 lg:items-start lg:gap-12">
    <!-- Subbloco 05.A — Índice editorial dos projetos selecionados -->
    <div class="lg:col-span-8">
      <div class="border-v2-border/80 flex items-center justify-between border-b pb-3.5">
        <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
          05.A // Repositórios em destaque
        </span>
        <a
          href="https://github.com/Guilhermegomeslima?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="v2-focus font-v2-mono text-v2-text-muted hover:text-v2-text text-[0.5625rem] tracking-[0.16em] uppercase transition-colors motion-reduce:transition-none"
        >
          GitHub completo ↗
        </a>
      </div>

      <ul class="divide-v2-border/60 divide-y border-b border-v2-border/80">
        {projects.map((project) => (
          <li>
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="v2-focus group hover:bg-v2-surface/50 grid grid-cols-1 gap-4 py-6 transition-colors duration-300 sm:grid-cols-12 sm:items-baseline sm:gap-6 sm:px-3 motion-reduce:transition-none"
            >
              <div class="sm:col-span-3">
                <span class="font-v2-mono text-v2-accent text-[0.5625rem] tracking-[0.18em]">
                  {project.id}
                </span>
                <p class="font-v2-mono text-v2-text-muted/80 mt-1 text-[0.625rem]">
                  {project.tagline}
                </p>
              </div>

              <div class="sm:col-span-7">
                <h3 class="font-v2-display text-v2-text group-hover:text-v2-accent-warm text-2xl leading-tight font-medium transition-colors motion-reduce:transition-none">
                  {project.name}
                </h3>
                <p class="font-v2-sans text-v2-text-muted mt-2 text-xs leading-[1.75] font-light sm:text-sm">
                  {project.description}
                </p>
                <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
                  {project.tags.map((tag) => (
                    <span class="font-v2-mono text-v2-text-muted/75 text-[0.5625rem] tracking-[0.14em] uppercase">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex items-center justify-end sm:col-span-2">
                <span
                  aria-hidden="true"
                  class="border-v2-border text-v2-text group-hover:border-v2-accent group-hover:bg-v2-accent inline-flex size-8 items-center justify-center border text-xs transition-colors duration-300 motion-reduce:transition-none"
                >
                  ↗
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Subbloco 05.B — Canais de contato e presença online -->
    <aside aria-label="Canais de contato" class="lg:col-span-4">
      <div class="border-v2-border/90 bg-v2-surface/60 relative border p-7 sm:p-8">
        <span
          aria-hidden="true"
          class="border-v2-accent pointer-events-none absolute -top-px -left-px h-3 w-3 border-t border-l"
        ></span>
        <span
          aria-hidden="true"
          class="border-v2-accent-warm/70 pointer-events-none absolute -right-px -bottom-px h-3 w-3 border-r border-b"
        ></span>

        <div class="border-v2-border/60 mb-5 border-b pb-3.5">
          <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
            05.B // Canais de contato
          </span>
          <h3 class="font-v2-display text-v2-text mt-2 text-2xl font-medium tracking-tight">
            Presença online
          </h3>
        </div>

        <p class="font-v2-sans text-v2-text-muted text-xs leading-[1.75] font-light">
          Links oficiais e perfis ativos para troca de ideias, colaborações ou
          conexões profissionais.
        </p>

        <ul class="divide-v2-border/50 mt-6 divide-y border-t border-v2-border/60">
          {socialLinks.map((link, index) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="v2-focus group flex min-h-11 items-center justify-between py-3.5 transition-colors motion-reduce:transition-none"
              >
                <div class="flex items-center gap-3">
                  <span class="font-v2-mono text-v2-text-muted/60 text-[0.5625rem]">
                    0{index + 1}
                  </span>
                  <span class="font-v2-sans text-v2-text group-hover:text-v2-accent-warm text-xs tracking-[0.14em] uppercase transition-colors motion-reduce:transition-none">
                    {link.label}
                  </span>
                </div>
                <span
                  aria-hidden="true"
                  class="font-v2-mono text-v2-text-muted group-hover:text-v2-text text-xs transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none"
                >
                  ↗
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="border-v2-border/60 mt-6 border-t pt-5">
          <a
            href={withBase('/projetos/')}
            class="v2-focus group border-v2-border hover:border-v2-accent hover:bg-v2-accent/15 flex min-h-11 w-full items-center justify-between border px-4 py-2.5 transition-colors duration-300 motion-reduce:transition-none"
          >
            <span class="font-v2-sans text-v2-text text-[0.625rem] tracking-[0.18em] uppercase">
              Ver catálogo de projetos
            </span>
            <span
              aria-hidden="true"
              class="text-v2-text transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
            >
              →
            </span>
          </a>
        </div>
      </div>
    </aside>
  </div>
</section>
