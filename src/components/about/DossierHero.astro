---
/**
 * Abertura da página Sobre + Fotografia vertical 3:4 + Registro 001 (Quem sou)
 * Segue o Design System 2.0 (docs/DESIGN_SYSTEM_V2.md).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header
  aria-labelledby="sobre-hero-title"
  class:list={[
    'border-v2-border/80 relative border-b pt-12 pb-20 lg:pt-20 lg:pb-28',
    className,
  ]}
>
  <!-- Detalhe lateral discreto de arquivo -->
  <div
    aria-hidden="true"
    class="font-v2-mono text-v2-text-muted/50 absolute top-12 right-0 hidden items-center gap-3 text-[0.5rem] tracking-[0.2em] uppercase lg:top-20 lg:flex"
  >
    <span>Dossiê // 0x474C</span>
    <span class="bg-v2-accent/80 h-px w-8"></span>
  </div>

  <!-- Eyebrow e Título de Abertura -->
  <div class="max-w-4xl">
    <p class="v2-eyebrow text-v2-text-muted flex items-center gap-4 text-[0.625rem] tracking-[0.25em]">
      <span aria-hidden="true" class="bg-v2-accent h-px w-7"></span>
      Arquivo pessoal
      <span aria-hidden="true" class="text-v2-text-muted/50">
        /
      </span>
      Sobre
    </p>

    <h1
      id="sobre-hero-title"
      class="font-v2-display text-v2-text mt-7 text-[clamp(2.75rem,5vw,5.25rem)] leading-[0.94] font-medium tracking-[-0.02em]"
    >
      A pessoa por trás
      <br />
      dos{' '}
      <em class="from-v2-text to-v2-text-muted bg-linear-to-r bg-clip-text pr-[0.08em] font-medium text-transparent italic">
        projetos.
      </em>
    </h1>
  </div>

  <!-- Composição principal: Fotografia 3:4 + Registro 001 (Quem sou) -->
  <div class="mt-14 grid grid-cols-1 gap-12 lg:mt-20 lg:grid-cols-12 lg:items-start lg:gap-14">
    <!-- Coluna da Fotografia (Proporção 4:5 com moldura editorial minimalista) -->
    <div class="mx-auto w-full max-w-[22rem] lg:col-span-4 lg:mx-0 lg:max-w-none">
      <figure class="border-v2-border/80 bg-v2-bg relative border p-1.5 sm:p-2">
        <!-- Cantoneiras geométricas finas em bronze e vermelho envelhecido -->
        <span
          aria-hidden="true"
          class="border-v2-accent pointer-events-none absolute -top-px -left-px h-3.5 w-3.5 border-t border-l"
        ></span>
        <span
          aria-hidden="true"
          class="border-v2-accent-warm/70 pointer-events-none absolute -top-px -right-px h-3.5 w-3.5 border-t border-r"
        ></span>
        <span
          aria-hidden="true"
          class="border-v2-accent-warm/70 pointer-events-none absolute -bottom-px -left-px h-3.5 w-3.5 border-b border-l"
        ></span>
        <span
          aria-hidden="true"
          class="border-v2-accent pointer-events-none absolute -right-px -bottom-px h-3.5 w-3.5 border-r border-b"
        ></span>

        <!-- Retrato 4:5 sem borda interna -->
        <div class="relative aspect-[4/5] w-full overflow-hidden">
          <img
            src="https://github.com/Guilhermegomeslima.png"
            alt="Foto de perfil de Guilherme Gomes"
            width="480"
            height="600"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="h-full w-full object-cover object-[center_20%] brightness-[0.88] contrast-[1.08] saturate-[0.86]"
          />
          <!-- Overlay escuro sutil e vinheta cinematográfica para conter o fundo claro -->
          <div
            aria-hidden="true"
            class="from-v2-bg/80 via-v2-bg/20 to-v2-bg/35 pointer-events-none absolute inset-0 bg-linear-to-t"
          ></div>
        </div>

        <!-- Legenda arquivística do retrato -->
        <figcaption class="border-v2-border/60 font-v2-mono text-v2-text-muted mt-2 flex items-center justify-between border-t pt-2 text-[0.625rem] tracking-[0.16em] uppercase">
          <span>ID // GUILHERME.DEV</span>
          <span class="flex items-center gap-2">
            <span
              aria-hidden="true"
              class="bg-v2-accent inline-block h-1.5 w-1.5"
            ></span>
            <span>Registro ativo</span>
          </span>
        </figcaption>
      </figure>
    </div>

    <!-- Registro 001 — Quem sou -->
    <div class="lg:col-span-8 lg:pt-1">
      <div class="flex items-center gap-4">
        <span class="font-v2-mono text-v2-accent text-[0.5625rem] tracking-[0.2em] uppercase">
          001
        </span>
        <span aria-hidden="true" class="bg-v2-border h-px w-6"></span>
        <span class="font-v2-mono text-v2-text-muted text-[0.5625rem] tracking-[0.2em] uppercase">
          Quem sou
        </span>
      </div>

      <h2 class="font-v2-display text-v2-text mt-4 text-[clamp(2rem,3vw,3.1rem)] leading-[1.05] font-medium tracking-[-0.01em]">
        Guilherme Gomes
      </h2>

      <p class="font-v2-sans text-v2-accent-warm mt-2 text-xs tracking-[0.14em] uppercase">
        Desenvolvedor em aprendizado &amp; entusiasta de sistemas operacionais
      </p>

      <!-- Biografia narrativa real -->
      <div class="font-v2-sans text-v2-text-muted mt-7 max-w-[42rem] space-y-4 text-sm leading-[1.85] font-light sm:text-[0.9375rem]">
        <p class="text-v2-text/95">
          Olá! Sou{' '}
          <strong class="text-v2-text font-medium">Guilherme Gomes</strong>,
          estudante de Análise e Desenvolvimento de Sistemas pela FAMINAS. Minha
          relação com a tecnologia começou pela curiosidade sobre como softwares
          funcionam nos bastidores e rapidamente se transformou em uma dedicação
          diária à engenharia de software e ao código aberto.
        </p>
        <p>
          Minha trajetória na tecnologia é impulsionada pela curiosidade de
          entender o funcionamento dos computadores em camadas profundas — desde
          os comandos no terminal e a organização do kernel até as interfaces
          web modernas e responsivas.
        </p>
        <p>
          No dia a dia, programo em Linux e busco construir software limpo,
          acessível e bem documentado. Acredito na aprendizagem contínua através
          da prática, da experimentação e do compartilhamento em comunidade.
        </p>
      </div>

      <!-- Ficha síntese do arquivo pessoal -->
      <div class="border-v2-border/80 bg-v2-surface/60 mt-10 border p-6 sm:p-7">
        <div class="border-v2-border/60 mb-5 flex items-center justify-between border-b pb-3">
          <span class="font-v2-mono text-v2-text-muted text-[0.5625rem] tracking-[0.2em] uppercase">
            Especificações do registro
          </span>
          <span
            aria-hidden="true"
            class="font-v2-mono text-v2-accent-warm/70 text-[0.5625rem] tracking-[0.15em]"
          >
            REF. 001-A
          </span>
        </div>

        <dl class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
          <div class="border-v2-border/40 border-l pl-3.5">
            <dt class="font-v2-mono text-v2-text-muted/75 text-[0.5625rem] tracking-[0.16em] uppercase">
              Formação acadêmica
            </dt>
            <dd class="font-v2-sans text-v2-text mt-1.5 text-xs sm:text-sm">
              Análise e Desenvolvimento de Sistemas (FAMINAS)
            </dd>
          </div>

          <div class="border-v2-border/40 border-l pl-3.5">
            <dt class="font-v2-mono text-v2-text-muted/75 text-[0.5625rem] tracking-[0.16em] uppercase">
              Ambiente de trabalho
            </dt>
            <dd class="font-v2-sans text-v2-text mt-1.5 text-xs sm:text-sm">
              Fedora Linux // GNOME
            </dd>
          </div>

          <div class="border-v2-border/40 border-l pl-3.5">
            <dt class="font-v2-mono text-v2-text-muted/75 text-[0.5625rem] tracking-[0.16em] uppercase">
              Foco técnico atual
            </dt>
            <dd class="font-v2-sans text-v2-text mt-1.5 text-xs sm:text-sm">
              Desenvolvimento Web &amp; TypeScript
            </dd>
          </div>

          <div class="border-v2-accent/70 border-l pl-3.5">
            <dt class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.16em] uppercase">
              Meta de longo prazo
            </dt>
            <dd class="font-v2-sans text-v2-text mt-1.5 text-xs sm:text-sm">
              Criar meu próprio sistema operacional
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</header>
