---
/**
 * Listagem cinematográfica da seção Resenhas (/resenhas/) — EXP-03A.
 *
 * Contempla hero editorial, filtros acessíveis por Jogos, Filmes e Livros,
 * contador de resultados e estado vazio informativo.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from './ReviewCard.astro';
import { withBase } from '../../utils/base';
import {
  countReviewsByMediaType,
  REVIEW_MEDIA_ORDER,
  REVIEW_MEDIA_TYPES,
} from '../../utils/reviews';

interface Props {
  reviews: CollectionEntry<'reviews'>[];
  isPreview?: boolean;
}

const { reviews, isPreview = false } = Astro.props;
const counts = countReviewsByMediaType(reviews);
const featuredReview = reviews.find((r) => r.data.featured) ?? reviews[0];
const remainingReviews = featuredReview
  ? reviews.filter((r) => r.id !== featuredReview.id)
  : [];
---

<BaseLayout
  variant="v2"
  title="Resenhas — guilherme.dev"
  description="Textos críticos e experiências pessoais sobre jogos, filmes e livros no guilherme.dev."
  noindex={isPreview}
>
  <div class="relative overflow-hidden pb-20 md:pb-28">
    {/* Atmosfera cinematográfica de abertura */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-[480px] overflow-hidden"
    >
      <img
        src={withBase('/images/home/jogos.webp')}
        alt=""
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        class="v2-section-hero-photo h-full w-full object-cover object-center opacity-[0.13] blur-[2px] filter"
      />
      <div class="v2-atmosphere-crimson absolute inset-0"></div>
      <div class="v2-atmosphere-fade absolute inset-0"></div>
    </div>

    <div class="relative mx-auto w-full max-w-[var(--container-v2)] px-5 sm:px-8">
      {/* Hero Editorial */}
      <header class="border-b border-[var(--color-v2-border)] pt-12 pb-10 md:pt-16 md:pb-14">
        <div class="mb-4 flex items-center gap-3">
          <span
            aria-hidden="true"
            class="inline-block h-px w-8 bg-[var(--color-v2-accent)]"
          ></span>
          <p class="v2-eyebrow text-[var(--color-v2-accent-warm)]">
            ARQUIVO CRÍTICO / RESENHAS
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <h1 class="font-[family-name:var(--font-v2-display)] text-4xl leading-[1.04] font-normal tracking-[-0.02em] text-[var(--color-v2-heading)] sm:text-5xl lg:text-6xl">
              Resenhas &amp; <span class="italic">impressões.</span>
            </h1>
          </div>

          <div class="lg:col-span-5">
            <p class="font-[family-name:var(--font-v2-sans)] text-sm leading-relaxed font-light text-[var(--color-v2-text-body)] sm:text-base">
              Textos críticos e experiências pessoais sobre jogos, filmes e
              livros que marcaram minha trajetória — em formato narrativo livre,
              com tempo para cada detalhe.
            </p>
          </div>
        </div>

        {/* Filtros por tipo de mídia */}
        <div
          class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--color-v2-border)] pt-5"
          data-reviews-filter-bar
        >
          <div
            role="group"
            aria-label="Filtrar resenhas por tipo de mídia"
            class="flex flex-wrap items-center gap-2"
          >
            <button
              type="button"
              data-review-filter="all"
              aria-pressed="true"
              class="v2-focus min-h-10 cursor-pointer border border-[var(--color-v2-accent)] bg-[var(--color-v2-accent)] px-3.5 py-2 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.14em] text-[var(--color-v2-on-accent)] uppercase transition-colors"
            >
              Todas ({counts.all})
            </button>

            {REVIEW_MEDIA_ORDER.map((type) => {
              const meta = REVIEW_MEDIA_TYPES[type];
              return (
                <button
                  type="button"
                  data-review-filter={type}
                  aria-pressed="false"
                  class="v2-focus min-h-10 cursor-pointer border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)] px-3.5 py-2 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.14em] text-[var(--color-v2-text-muted)] uppercase transition-colors hover:border-[var(--color-v2-border-hover)] hover:text-[var(--color-v2-heading)]"
                >
                  {meta.plural} ({counts[type]})
                </button>
              );
            })}
          </div>

          <p
            id="reviews-count-status"
            aria-live="polite"
            class="font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.12em] text-[var(--color-v2-text-muted)] uppercase"
          >
            {reviews.length === 1
              ? '1 resenha exibida'
              : `${reviews.length} resenhas exibidas`}
          </p>
        </div>
      </header>

      {/* Listagem de Resenhas */}
      {reviews.length > 0 ? (
        <section
          aria-label="Listagem de resenhas"
          class="mt-12 space-y-10"
          data-reviews-grid
        >
          {featuredReview && (
            <div data-review-featured-wrapper>
              <ReviewCard review={featuredReview} featured />
            </div>
          )}

          {remainingReviews.length > 0 && (
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
              {remainingReviews.map((review) => (
                <ReviewCard review={review} />
              ))}
            </div>
          )}

          {/* Estado vazio quando um filtro específico não encontra itens */}
          <div
            data-reviews-empty-filter
            hidden
            class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/70 px-6 py-12 text-center"
          >
            <p class="font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
              // Nenhuma resenha nesta categoria
            </p>
            <p class="mx-auto mt-3 max-w-md font-[family-name:var(--font-v2-sans)] text-sm font-light text-[var(--color-v2-text-body)]">
              Ainda não há resenhas publicadas para o tipo de mídia selecionado.
            </p>
            <button
              type="button"
              data-review-reset-filter
              class="v2-focus mt-6 inline-flex min-h-10 cursor-pointer items-center border border-[var(--color-v2-border-hover)] bg-[var(--color-v2-bg)] px-4 py-2 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.14em] text-[var(--color-v2-heading)] uppercase transition-colors hover:border-[var(--color-v2-accent-warm)] hover:text-[var(--color-v2-accent-warm)]"
            >
              Mostrar todas as resenhas
            </button>
          </div>
        </section>
      ) : (
        <section
          aria-label="Estado vazio de resenhas"
          class="mt-12 border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/70 px-6 py-16 text-center"
        >
          <p class="font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
            // Arquivo em preparação
          </p>
          <h2 class="mt-3 font-[family-name:var(--font-v2-display)] text-3xl font-normal text-[var(--color-v2-heading)]">
            Nenhuma resenha publicada ainda.
          </h2>
          <p class="mx-auto mt-3 max-w-lg font-[family-name:var(--font-v2-sans)] text-sm leading-relaxed font-light text-[var(--color-v2-text-body)]">
            Esta seção reunirá análises e experiências pessoais sobre jogos,
            filmes e livros assim que os primeiros textos forem integrados e
            aprovados.
          </p>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  function setupReviewsFilters() {
    const filterBar = document.querySelector<HTMLElement>(
      '[data-reviews-filter-bar]',
    );
    const grid = document.querySelector<HTMLElement>('[data-reviews-grid]');
    if (!filterBar || !grid || filterBar.dataset.bound === 'true') return;
    filterBar.dataset.bound = 'true';

    const buttons = Array.from(
      filterBar.querySelectorAll<HTMLButtonElement>('[data-review-filter]'),
    );
    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>('[data-review-card]'),
    );
    const emptyState = grid.querySelector<HTMLElement>(
      '[data-reviews-empty-filter]',
    );
    const resetBtn = grid.querySelector<HTMLButtonElement>(
      '[data-review-reset-filter]',
    );
    const statusElem = document.getElementById('reviews-count-status');

    const activeClasses = [
      'border-[var(--color-v2-accent)]',
      'bg-[var(--color-v2-accent)]',
      'text-[var(--color-v2-on-accent)]',
    ];
    const inactiveClasses = [
      'border-[var(--color-v2-border)]',
      'bg-[var(--color-v2-surface)]',
      'text-[var(--color-v2-text-muted)]',
    ];

    function applyFilter(selected: string) {
      let visibleCount = 0;

      for (const card of cards) {
        const matches =
          selected === 'all' || card.dataset.mediaType === selected;
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      }

      for (const btn of buttons) {
        const isSelected = btn.dataset.reviewFilter === selected;
        btn.setAttribute('aria-pressed', String(isSelected));
        if (isSelected) {
          btn.classList.remove(...inactiveClasses);
          btn.classList.add(...activeClasses);
        } else {
          btn.classList.remove(...activeClasses);
          btn.classList.add(...inactiveClasses);
        }
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }

      if (statusElem) {
        statusElem.textContent =
          visibleCount === 1
            ? '1 resenha exibida'
            : `${visibleCount} resenhas exibidas`;
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyFilter(btn.dataset.reviewFilter || 'all');
      });
    });

    resetBtn?.addEventListener('click', () => {
      applyFilter('all');
      buttons[0]?.focus();
    });
  }

  setupReviewsFilters();
  document.addEventListener('astro:page-load', setupReviewsFilters);
</script>
