---
/**
 * Página institucional de ambiente `/diario-linux/meu-ambiente/` (EXP-04A / EXP-04C.2).
 *
 * Exibe somente informações técnicas confirmadas em `src/data/linuxEnvironment.ts`,
 * sem dados presumidos ou privados, respeitando os temas claro/escuro e a visibilidade
 * das rotas conforme `editorial-flags.ts`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialLightbox from '../editorial/EditorialLightbox.astro';
import TechnicalNotice from '../editorial/TechnicalNotice.astro';
import { linuxEnvironmentSpec } from '../../data/linuxEnvironment';
import { withBase } from '../../utils/base';

interface Props {
  isPreview?: boolean;
  availableDiarySlugs?: string[];
}

const { isPreview = false, availableDiarySlugs = [] } = Astro.props;
const { confirmed, lastVerifiedAt, coverImage, sections, relatedReadings } =
  linuxEnvironmentSpec;

const availableSlugSet = new Set(availableDiarySlugs);

const visibleRelatedReadings = relatedReadings.filter(
  (reading) => !reading.diarySlug || availableSlugSet.has(reading.diarySlug),
);
---

<BaseLayout
  variant="v2"
  title="Meu ambiente — Diário Linux — guilherme.dev"
  description="Referência sobre hardware, Fedora Workstation, GNOME, memória, energia e ferramentas de desenvolvimento utilizadas no guilherme.dev."
  image={coverImage?.url}
  noindex={isPreview || !confirmed}
>
  <div class="relative overflow-hidden pb-20 md:pb-28">
    {/* Atmosfera sutil no topo */}
    {coverImage && (
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 h-[380px] overflow-hidden"
      >
        <img
          src={withBase(coverImage.url)}
          alt=""
          width={coverImage.width}
          height={coverImage.height}
          loading="eager"
          decoding="async"
          class="h-full w-full scale-105 object-cover object-center opacity-[0.09] blur-3xl filter"
        />
        <div class="v2-atmosphere-warm absolute inset-0"></div>
      </div>
    )}

    <div class="relative mx-auto w-full max-w-[var(--container-v2)] px-5 pt-10 sm:px-8 md:pt-14">
      <div class="mb-10 flex flex-wrap items-center justify-between gap-4 border-b border-[var(--color-v2-border)] pb-4">
        <a
          href={withBase('/diario-linux/')}
          class="v2-focus inline-flex items-center gap-2 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.14em] text-[var(--color-v2-text-muted)] uppercase transition-colors hover:text-[var(--color-v2-heading)]"
        >
          <span aria-hidden="true" class="text-[var(--color-v2-accent-warm)]">
            &larr;
          </span>
          <span>Voltar para o Diário Linux</span>
        </a>

        <span class="font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.18em] text-[var(--color-v2-text-muted)] uppercase">
          DIÁRIO LINUX // MEU AMBIENTE
        </span>
      </div>

      {/* Cabeçalho editorial + captura discreta do desktop */}
      <header class="grid grid-cols-1 gap-8 border-b border-[var(--color-v2-border)] pb-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="v2-eyebrow text-[var(--color-v2-accent-warm)]">
            CONFIGURAÇÃO E HARDWARE
          </p>
          <h1 class="mt-3 font-[family-name:var(--font-v2-display)] text-4xl leading-[1.06] font-normal tracking-[-0.02em] text-[var(--color-v2-heading)] sm:text-5xl">
            Meu ambiente.
          </h1>
          <p class="mt-4 max-w-2xl font-[family-name:var(--font-v2-sans)] text-base leading-relaxed font-light text-[var(--color-v2-text-body)]">
            Referência central sobre o hardware do notebook, Fedora Workstation
            com GNOME, personalizações, ajustes de memória e energia e
            ferramentas que utilizo no dia a dia.
          </p>
          {confirmed && lastVerifiedAt && (
            <p class="mt-5 inline-flex items-center gap-2 border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/80 px-3 py-1.5 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.12em] text-[var(--color-v2-text-muted)] uppercase">
              <span class="text-[var(--color-v2-accent-warm)]">
                Última verificação:
              </span>
              <span class="text-[var(--color-v2-heading)]">
                {lastVerifiedAt}
              </span>
            </p>
          )}
        </div>

        {confirmed && coverImage && (
          <figure class="v2-shadow-card border border-[var(--color-v2-border-hover)] bg-[var(--color-v2-media-surface)] p-2 lg:col-span-5">
            <div class="overflow-hidden border border-[var(--color-v2-media-border)] bg-[var(--color-v2-media-bg)]">
              <img
                src={withBase(coverImage.url)}
                alt={coverImage.alt}
                width={coverImage.width}
                height={coverImage.height}
                loading="eager"
                decoding="async"
                data-editorial-lightbox-trigger="true"
                data-lightbox-src={withBase(coverImage.url)}
                data-lightbox-alt={coverImage.alt}
                data-lightbox-caption={coverImage.caption || coverImage.alt}
                tabindex="0"
                role="button"
                aria-label={`Ampliar imagem: ${coverImage.alt}`}
                class="block h-auto max-h-[260px] w-full cursor-zoom-in object-contain"
              />
            </div>
            {coverImage.caption && (
              <figcaption class="px-2 pt-2 pb-0.5 font-[family-name:var(--font-v2-mono)] text-[10px] leading-relaxed text-[var(--color-v2-media-muted)]">
                // {coverImage.caption}
              </figcaption>
            )}
          </figure>
        )}
      </header>

      {!confirmed ? (
        <div class="mt-8 max-w-3xl">
          <TechnicalNotice variant="info" title="Dados aguardando confirmação">
            <p>
              A estrutura desta página está pronta para receber as
              especificações reais de hardware, versão do Fedora, extensões e
              ferramentas assim que forem confirmadas editorialmente.
            </p>
          </TechnicalNotice>

          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {sections.map((section) => (
              <section class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/70 p-5">
                <h2 class="font-[family-name:var(--font-v2-display)] text-2xl text-[var(--color-v2-heading)]">
                  {section.title}
                </h2>
                <p class="mt-2 font-[family-name:var(--font-v2-sans)] text-sm font-light text-[var(--color-v2-text-body)]">
                  {section.description}
                </p>
              </section>
            ))}
          </div>
        </div>
      ) : (
        <div class="mt-10 space-y-12">
          {/* Grade principal das seções confirmadas */}
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            {sections
              .filter((section) => section.items.length > 0)
              .map((section) => {
                const showCta =
                  section.cta &&
                  (!section.cta.diarySlug ||
                    availableSlugSet.has(section.cta.diarySlug));
                const isWide = section.layout === 'wide';

                return (
                  <section
                    id={section.id}
                    class:list={[
                      'flex flex-col border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/80 p-6 sm:p-7',
                      isWide && 'lg:col-span-2',
                    ]}
                  >
                    <div class="border-b border-[var(--color-v2-border)] pb-4">
                      {section.eyebrow && (
                        <p class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
                          {section.eyebrow}
                        </p>
                      )}
                      <h2 class="mt-1.5 font-[family-name:var(--font-v2-display)] text-2xl leading-tight font-normal text-[var(--color-v2-heading)] sm:text-[1.75rem]">
                        {section.title}
                      </h2>
                      <p class="mt-1.5 font-[family-name:var(--font-v2-sans)] text-sm font-light text-[var(--color-v2-text-body)]">
                        {section.description}
                      </p>
                    </div>

                    <dl
                      class:list={[
                        'mt-5 gap-x-8 gap-y-4 text-sm',
                        isWide
                          ? 'grid grid-cols-1 md:grid-cols-2'
                          : 'space-y-4',
                      ]}
                    >
                      {section.items.map((item) => (
                        <div class="border-l border-[var(--color-v2-border)] pl-3.5">
                          <dt class="font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.12em] text-[var(--color-v2-text-muted)] uppercase">
                            {item.label}
                          </dt>
                          <dd class="mt-1 font-[family-name:var(--font-v2-sans)] text-[0.96875rem] font-normal text-[var(--color-v2-heading)]">
                            {item.value}
                          </dd>
                          {item.notes && (
                            <dd class="mt-0.5 font-[family-name:var(--font-v2-sans)] text-xs font-light text-[var(--color-v2-text-muted)]">
                              {item.notes}
                            </dd>
                          )}
                          {item.items && item.items.length > 0 && (
                            <dd class="mt-2.5">
                              <ul class="flex flex-wrap gap-2">
                                {item.items.map((entry) => (
                                  <li class="border border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]/70 px-2.5 py-1 font-[family-name:var(--font-v2-mono)] text-xs text-[var(--color-v2-text)]">
                                    {entry}
                                  </li>
                                ))}
                              </ul>
                            </dd>
                          )}
                        </div>
                      ))}
                    </dl>

                    {showCta && section.cta && (
                      <div class="mt-6 border-t border-[var(--color-v2-border)] pt-4">
                        <a
                          href={withBase(section.cta.href)}
                          class="v2-focus inline-flex items-center gap-2 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.12em] text-[var(--color-v2-accent-warm)] uppercase transition-colors hover:text-[var(--color-v2-heading)]"
                        >
                          <span>{section.cta.label}</span>
                          <span aria-hidden="true">&rarr;</span>
                        </a>
                      </div>
                    )}
                  </section>
                );
              })}
          </div>

          {/* Tutoriais e leituras relacionadas */}
          {visibleRelatedReadings.length > 0 && (
            <aside
              aria-label="Tutoriais e leituras relacionadas"
              class="border-t border-[var(--color-v2-border)] pt-10"
            >
              <p class="font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
                // Tutoriais e leituras relacionadas
              </p>
              <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-3">
                {visibleRelatedReadings.map((reading) => (
                  <a
                    href={withBase(reading.href)}
                    class="v2-focus group flex flex-col justify-between border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/80 p-5 transition-colors hover:border-[var(--color-v2-border-hover)]"
                  >
                    <div>
                      <span class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.16em] text-[var(--color-v2-accent-warm)] uppercase">
                        {reading.categoryLabel}
                      </span>
                      <h2 class="mt-2 font-[family-name:var(--font-v2-display)] text-2xl leading-snug font-normal text-[var(--color-v2-heading)] transition-colors group-hover:text-[var(--color-v2-accent-warm)]">
                        {reading.title}
                      </h2>
                      <p class="mt-2 font-[family-name:var(--font-v2-sans)] text-sm leading-relaxed font-light text-[var(--color-v2-text-body)]">
                        {reading.description}
                      </p>
                    </div>
                    <span class="mt-4 inline-flex items-center gap-1.5 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.14em] text-[var(--color-v2-text-muted)] uppercase transition-colors group-hover:text-[var(--color-v2-heading)]">
                      <span>Acessar</span>
                      <span aria-hidden="true">&rarr;</span>
                    </span>
                  </a>
                ))}
              </div>
            </aside>
          )}
        </div>
      )}
    </div>
  </div>

  <EditorialLightbox />
</BaseLayout>
