---
import Container from './Container.astro';

interface Props {
  id?: string;
  ariaLabelledby?: string;
  divider?: boolean;
  class?: string;
}

const { id, ariaLabelledby, divider = false, class: className } = Astro.props;
---

<section
  id={id}
  aria-labelledby={ariaLabelledby}
  class:list={[
    'py-12 md:py-16',
    divider && 'border-border border-b',
    className,
  ]}
>
  <Container>
    <slot />
  </Container>
</section>
