---
type Variant = 'primary' | 'secondary' | 'ghost';

interface Props {
  href?: string;
  external?: boolean;
  type?: 'button' | 'submit' | 'reset';
  variant?: Variant;
  ariaLabel?: string;
  class?: string;
}

const {
  href,
  external = false,
  type = 'button',
  variant = 'primary',
  ariaLabel,
  class: className,
} = Astro.props;

const baseClasses =
  'v2-focus inline-flex min-h-11 items-center justify-center gap-2 px-5 py-2.5 font-v2-mono text-[11px] font-normal tracking-[0.18em] uppercase motion-safe:transition-colors';

const variantClasses: Record<Variant, string> = {
  primary:
    'border border-v2-accent bg-v2-accent text-v2-text hover:bg-v2-accent/85',
  secondary:
    'border border-v2-border bg-v2-surface text-v2-text hover:border-v2-accent-warm hover:text-v2-accent-warm',
  ghost:
    'text-v2-accent-warm underline-offset-4 hover:text-v2-text hover:underline',
};
---

{href ? (
  <a
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    aria-label={ariaLabel}
    class:list={[baseClasses, variantClasses[variant], className]}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    aria-label={ariaLabel}
    class:list={[baseClasses, variantClasses[variant], className]}
  >
    <slot />
  </button>
)}
