---
interface Props {
  as?: 'article' | 'div';
  interactive?: boolean;
  class?: string;
}

const {
  as: Tag = 'article',
  interactive = false,
  class: className,
} = Astro.props;
---

<Tag
  class:list={[
    'border-border bg-surface rounded-lg border p-6',
    interactive &&
      'group focus-within:border-accent hover:border-accent/70 hover:bg-surface-raised relative motion-safe:transition-colors',
    className,
  ]}
>
  <slot />
</Tag>

