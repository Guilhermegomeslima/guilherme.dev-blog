---
interface Props {
  as?: 'article' | 'div';
  interactive?: boolean;
  class?: string;
}

const {
  as: Tag = 'article',
  interactive = false,
  class: className,
} = Astro.props;
---

<Tag
  class:list={[
    'border-v2-border bg-v2-surface border p-6',
    interactive &&
      'group focus-within:border-v2-accent-warm hover:border-v2-border-hover hover:bg-v2-surface-raised relative motion-safe:transition-colors',
    className,
  ]}
>
  <slot />
</Tag>
