---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const hasCustomMaxWidth = className && /\bmax-w-/.test(className);
---

<div
  class:list={[
    'mx-auto w-full px-4 sm:px-6 lg:px-8',
    !hasCustomMaxWidth && 'max-w-5xl',
    className,
  ]}
>
  <slot />
</div>
