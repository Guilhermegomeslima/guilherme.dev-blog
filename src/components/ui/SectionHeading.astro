---
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  as?: 'h1' | 'h2';
  id?: string;
  class?: string;
}

const {
  title,
  eyebrow,
  description,
  as: HeadingTag = 'h2',
  id,
  class: className,
} = Astro.props;
---

<div class:list={['mb-8 max-w-2xl', className]}>
  {eyebrow && <p class="v2-eyebrow text-v2-accent-warm mb-2">{eyebrow}</p>}
  <HeadingTag
    id={id}
    class="font-v2-display text-v2-heading text-2xl font-medium tracking-tight sm:text-3xl"
  >
    {title}
  </HeadingTag>
  {description && (
    <p class="font-v2-sans text-v2-text-muted mt-3 text-base leading-relaxed font-light">
      {description}
    </p>
  )}
</div>
