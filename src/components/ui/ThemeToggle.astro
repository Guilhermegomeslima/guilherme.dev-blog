---
/**
 * Botão discreto de alternância de tema para o HeaderV2 (THEME-02).
 * - Exibe ícone de lua no tema escuro e ícone de sol no tema claro (alternados por CSS).
 * - Alvo de toque mínimo 44×44 px (`min-h-11 min-w-11`) e foco visível (`v2-focus`).
 * - Aprimoramento progressivo: inicia `hidden` e só aparece com JS quando `enabled` for `true`.
 */
import { LIGHT_THEME_ENABLED } from '../../utils/theme';

interface Props {
  enabled?: boolean;
  class?: string;
}

const { enabled = LIGHT_THEME_ENABLED, class: className } = Astro.props;
---

{enabled && (
  <>
    <button
      type="button"
      hidden
      data-theme-toggle
      aria-label="Ativar tema claro"
      class:list={[
        'v2-focus border-v2-border text-v2-text-muted hover:border-v2-accent-warm/60 hover:text-v2-text inline-flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center border transition-colors motion-reduce:transition-none',
        className,
      ]}
    >
      {/* Lua — exibida quando o tema escuro está ativo */}
      <svg
        data-theme-icon="moon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>

      {/* Sol — exibido quando o tema claro está ativo */}
      <svg
        data-theme-icon="sun"
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
    </button>
    <span
      role="status"
      aria-live="polite"
      data-theme-status
      class="sr-only"
    ></span>
  </>
)}

<script>
  import {
    THEME_STORAGE_KEY,
    getNextTheme,
    getThemeAnnouncement,
    getThemeMetaColor,
    getThemeToggleLabel,
    resolveStoredTheme,
    writeStoredTheme,
    type ThemeMode,
  } from '../../utils/theme';

  const toggles = document.querySelectorAll<HTMLButtonElement>(
    '[data-theme-toggle]',
  );

  if (toggles.length > 0) {
    const root = document.documentElement;
    const metaThemeColor = document.querySelector<HTMLMetaElement>(
      'meta[name="theme-color"]',
    );
    const liveStatus = document.querySelector<HTMLElement>(
      '[data-theme-status]',
    );

    const getCurrentTheme = (): ThemeMode =>
      root.dataset.theme === 'light' ? 'light' : 'dark';

    const syncUI = (theme: ThemeMode, announce = false) => {
      root.dataset.theme = theme;
      if (metaThemeColor) {
        metaThemeColor.setAttribute('content', getThemeMetaColor(theme));
      }
      const nextLabel = getThemeToggleLabel(theme);
      for (const btn of toggles) {
        btn.setAttribute('aria-label', nextLabel);
        btn.setAttribute('title', nextLabel);
      }
      if (announce && liveStatus) {
        liveStatus.textContent = getThemeAnnouncement(theme);
      }
    };

    const initialTheme = getCurrentTheme();
    syncUI(initialTheme, false);

    for (const btn of toggles) {
      btn.hidden = false;
      btn.addEventListener('click', () => {
        const next = getNextTheme(getCurrentTheme());
        syncUI(next, true);
        try {
          writeStoredTheme(window.localStorage, next);
        } catch {
          // Modo privado ou armazenamento bloqueado: alterna apenas na sessão atual
        }
      });
    }

    window.addEventListener('storage', (event) => {
      if (event.key !== null && event.key !== THEME_STORAGE_KEY) return;
      syncUI(resolveStoredTheme(event.newValue, true), false);
    });
  }
</script>
