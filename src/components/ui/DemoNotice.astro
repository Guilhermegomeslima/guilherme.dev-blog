---
interface Props {
  variant?: 'section' | 'item' | 'narrative';
  class?: string;
}

const { variant = 'section', class: className } = Astro.props;

const messages = {
  section:
    'Conteúdo de demonstração: os itens e avaliações desta seção são fictícios e utilizados para testar a interface.',
  item: 'Registro de teste. As informações e notas desta página são fictícias.',
  narrative:
    'Esta seção está em desenvolvimento. Os textos abaixo são provisórios e servem apenas para demonstrar a estrutura da página.',
};

const message = messages[variant];
---

<div
  role="status"
  class:list={[
    'border-v2-accent-warm/40 bg-v2-surface-raised/85 text-v2-text-muted font-v2-mono relative overflow-hidden border p-4 text-xs',
    className,
  ]}
>
  <div class="flex items-start gap-3">
    <span
      class="bg-v2-accent-warm mt-1 inline-block h-1.5 w-1.5 shrink-0"
      aria-hidden="true"
    ></span>
    <div>
      <span class="text-v2-accent-warm tracking-[0.16em] uppercase">
        [ AMBIENTE DE DEMONSTRAÇÃO // MOCK DATA ]
      </span>
      <p class="font-v2-sans text-v2-text mt-1 text-xs leading-relaxed font-light">
        {message}
      </p>
    </div>
  </div>
</div>
