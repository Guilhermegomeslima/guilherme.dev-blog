---
/**
 * Catálogo cinematográfico da seção Recomendações (/recomendacoes/) — EXP-05A.
 *
 * Contempla hero editorial, filtros acessíveis por categoria e status de experiência,
 * contador de resultados em tempo real, cards cinematográficos grandes,
 * estado vazio informativo e lightbox para ampliações de fotografias reais.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialLightbox from '../editorial/EditorialLightbox.astro';
import RecommendationCard from './RecommendationCard.astro';
import { withBase } from '../../utils/base';
import {
  countRecommendationsByCategory,
  countRecommendationsByStatus,
  RECOMMENDATION_CATEGORIES,
  RECOMMENDATION_CATEGORY_ORDER,
  RECOMMENDATION_STATUS_ORDER,
  RECOMMENDATION_STATUSES,
} from '../../utils/recommendations';

interface Props {
  recommendations: CollectionEntry<'recommendations'>[];
  isPreview?: boolean;
}

const { recommendations, isPreview = false } = Astro.props;
const categoryCounts = countRecommendationsByCategory(recommendations);
const statusCounts = countRecommendationsByStatus(recommendations);
---

<BaseLayout
  variant="v2"
  title="Recomendações — guilherme.dev"
  description="Curadoria pessoal de produtos, periféricos, livros e editoras no guilherme.dev."
  noindex={isPreview}
>
  <div class="relative overflow-hidden pb-20 md:pb-28">
    {/* Atmosfera editorial sutil de abertura */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-[460px] overflow-hidden"
    >
      <img
        src={withBase('/images/home/livros.webp')}
        alt=""
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        class="v2-section-hero-photo h-full w-full object-cover object-center opacity-[0.12] blur-[2px] filter"
      />
      <div class="v2-atmosphere-warm absolute inset-0"></div>
      <div class="v2-atmosphere-fade absolute inset-0"></div>
    </div>

    <div class="relative mx-auto w-full max-w-[var(--container-v2)] px-5 sm:px-8">
      {/* Hero Editorial */}
      <header class="border-b border-[var(--color-v2-border)] pt-12 pb-10 md:pt-16 md:pb-14">
        <div class="mb-4 flex items-center gap-3">
          <span
            aria-hidden="true"
            class="inline-block h-px w-8 bg-[var(--color-v2-accent-warm)]"
          ></span>
          <p class="v2-eyebrow text-[var(--color-v2-accent-warm)]">
            ACERVO / CURADORIA PESSOAL
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <h1 class="font-[family-name:var(--font-v2-display)] text-4xl leading-[1.04] font-normal tracking-[-0.02em] text-[var(--color-v2-heading)] sm:text-5xl lg:text-6xl">
              Recomendações &amp; <span class="italic">achados.</span>
            </h1>
          </div>

          <div class="lg:col-span-5">
            <p class="font-[family-name:var(--font-v2-sans)] text-sm leading-relaxed font-light text-[var(--color-v2-text-body)] sm:text-base">
              Curadoria pessoal de periféricos, equipamentos, edições e editoras
              com comentários honestos e transparência sobre o nível de
              experiência — sem notas numéricas ou vitrine comercial.
            </p>
          </div>
        </div>

        {/* Barra de filtros por categoria e estado de experiência */}
        <div
          class="mt-8 space-y-4 border-t border-[var(--color-v2-border)] pt-5"
          data-recommendations-filter-bar
        >
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div
              role="group"
              aria-label="Filtrar recomendações por categoria"
              class="flex flex-wrap items-center gap-2"
            >
              <button
                type="button"
                data-rec-category-filter="all"
                aria-pressed="true"
                class="v2-focus min-h-10 cursor-pointer border border-[var(--color-v2-accent)] bg-[var(--color-v2-accent)] px-3.5 py-2 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.14em] text-[var(--color-v2-on-accent)] uppercase transition-colors"
              >
                Todas ({categoryCounts.all})
              </button>

              {RECOMMENDATION_CATEGORY_ORDER.map((categoryId) => {
                const meta = RECOMMENDATION_CATEGORIES[categoryId];
                return (
                  <button
                    type="button"
                    data-rec-category-filter={categoryId}
                    aria-pressed="false"
                    class="v2-focus min-h-10 cursor-pointer border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)] px-3.5 py-2 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.14em] text-[var(--color-v2-text-muted)] uppercase transition-colors hover:border-[var(--color-v2-border-hover)] hover:text-[var(--color-v2-heading)]"
                  >
                    {meta.label} ({categoryCounts[categoryId]})
                  </button>
                );
              })}
            </div>

            <p
              id="recommendations-count-status"
              aria-live="polite"
              class="font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.12em] text-[var(--color-v2-text-muted)] uppercase"
            >
              {recommendations.length === 1
                ? '1 recomendação exibida'
                : `${recommendations.length} recomendações exibidas`}
            </p>
          </div>

          <div
            role="group"
            aria-label="Filtrar recomendações por estado de experiência"
            class="flex flex-wrap items-center gap-2"
          >
            <span class="mr-1 font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.16em] text-[var(--color-v2-text-muted)] uppercase">
              Status:
            </span>

            <button
              type="button"
              data-rec-status-filter="all"
              aria-pressed="true"
              class="v2-focus min-h-9 cursor-pointer border border-[var(--color-v2-accent-warm)] bg-[var(--color-v2-surface-raised)] px-3 py-1.5 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.12em] text-[var(--color-v2-heading)] uppercase transition-colors"
            >
              Todos ({statusCounts.all})
            </button>

            {RECOMMENDATION_STATUS_ORDER.map((statusId) => {
              const meta = RECOMMENDATION_STATUSES[statusId];
              return (
                <button
                  type="button"
                  data-rec-status-filter={statusId}
                  aria-pressed="false"
                  class="v2-focus min-h-9 cursor-pointer border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)] px-3 py-1.5 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.12em] text-[var(--color-v2-text-muted)] uppercase transition-colors hover:border-[var(--color-v2-border-hover)] hover:text-[var(--color-v2-heading)]"
                >
                  {meta.label} ({statusCounts[statusId]})
                </button>
              );
            })}
          </div>
        </div>
      </header>

      {/* Catálogo de Recomendações */}
      {recommendations.length > 0 ? (
        <section
          aria-label="Catálogo de recomendações"
          class="mt-12 space-y-8"
          data-recommendations-grid
        >
          {recommendations.map((item, idx) => (
            <RecommendationCard recommendation={item} index={idx} />
          ))}

          {/* Estado vazio quando a combinação de filtros não retorna itens */}
          <div
            data-recommendations-empty-filter
            hidden
            class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/70 px-6 py-12 text-center"
          >
            <p class="font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
              // Nenhum item para os filtros selecionados
            </p>
            <p class="mx-auto mt-3 max-w-md font-[family-name:var(--font-v2-sans)] text-sm font-light text-[var(--color-v2-text-body)]">
              Não há recomendações que combinem a categoria e o estado de
              experiência escolhidos.
            </p>
            <button
              type="button"
              data-recommendations-reset-filter
              class="v2-focus mt-6 inline-flex min-h-10 cursor-pointer items-center border border-[var(--color-v2-border-hover)] bg-[var(--color-v2-bg)] px-4 py-2 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.14em] text-[var(--color-v2-heading)] uppercase transition-colors hover:border-[var(--color-v2-accent-warm)] hover:text-[var(--color-v2-accent-warm)]"
            >
              Limpar filtros
            </button>
          </div>
        </section>
      ) : (
        <section
          aria-label="Estado vazio de recomendações"
          class="mt-12 border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/70 px-6 py-16 text-center"
        >
          <p class="font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
            // Curadoria em preparação
          </p>
          <h2 class="mt-3 font-[family-name:var(--font-v2-display)] text-3xl font-normal text-[var(--color-v2-heading)]">
            Nenhuma recomendação publicada ainda.
          </h2>
          <p class="mx-auto mt-3 max-w-lg font-[family-name:var(--font-v2-sans)] text-sm leading-relaxed font-light text-[var(--color-v2-text-body)]">
            Esta seção reunirá recomendações pessoais de periféricos, livros e
            editoras com fotografias reais e comentários revisados assim que as
            primeiras entradas forem integradas.
          </p>
        </section>
      )}
    </div>
  </div>

  <EditorialLightbox />
</BaseLayout>

<script>
  function setupRecommendationsFilters() {
    const filterBar = document.querySelector<HTMLElement>(
      '[data-recommendations-filter-bar]',
    );
    const grid = document.querySelector<HTMLElement>(
      '[data-recommendations-grid]',
    );
    if (!filterBar || !grid || filterBar.dataset.bound === 'true') return;
    filterBar.dataset.bound = 'true';

    const categoryButtons = Array.from(
      filterBar.querySelectorAll<HTMLButtonElement>(
        '[data-rec-category-filter]',
      ),
    );
    const statusButtons = Array.from(
      filterBar.querySelectorAll<HTMLButtonElement>('[data-rec-status-filter]'),
    );
    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>('[data-recommendation-card]'),
    );
    const emptyState = grid.querySelector<HTMLElement>(
      '[data-recommendations-empty-filter]',
    );
    const resetBtn = grid.querySelector<HTMLButtonElement>(
      '[data-recommendations-reset-filter]',
    );
    const statusElem = document.getElementById('recommendations-count-status');

    let selectedCategory = 'all';
    let selectedStatus = 'all';

    const catActive = [
      'border-[var(--color-v2-accent)]',
      'bg-[var(--color-v2-accent)]',
      'text-[var(--color-v2-on-accent)]',
    ];
    const catInactive = [
      'border-[var(--color-v2-border)]',
      'bg-[var(--color-v2-surface)]',
      'text-[var(--color-v2-text-muted)]',
    ];

    const statusActive = [
      'border-[var(--color-v2-accent-warm)]',
      'bg-[var(--color-v2-surface-raised)]',
      'text-[var(--color-v2-heading)]',
    ];
    const statusInactive = [
      'border-[var(--color-v2-border)]',
      'bg-[var(--color-v2-surface)]',
      'text-[var(--color-v2-text-muted)]',
    ];

    function applyFilters() {
      let visibleCount = 0;

      for (const card of cards) {
        const matchCategory =
          selectedCategory === 'all' ||
          card.dataset.category === selectedCategory;
        const matchStatus =
          selectedStatus === 'all' || card.dataset.status === selectedStatus;
        const visible = matchCategory && matchStatus;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      for (const btn of categoryButtons) {
        const isActive = btn.dataset.recCategoryFilter === selectedCategory;
        btn.setAttribute('aria-pressed', String(isActive));
        btn.classList.remove(...(isActive ? catInactive : catActive));
        btn.classList.add(...(isActive ? catActive : catInactive));
      }

      for (const btn of statusButtons) {
        const isActive = btn.dataset.recStatusFilter === selectedStatus;
        btn.setAttribute('aria-pressed', String(isActive));
        btn.classList.remove(...(isActive ? statusInactive : statusActive));
        btn.classList.add(...(isActive ? statusActive : statusInactive));
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }

      if (statusElem) {
        statusElem.textContent =
          visibleCount === 1
            ? '1 recomendação exibida'
            : `${visibleCount} recomendações exibidas`;
      }
    }

    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedCategory = btn.dataset.recCategoryFilter || 'all';
        applyFilters();
      });
    });

    statusButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedStatus = btn.dataset.recStatusFilter || 'all';
        applyFilters();
      });
    });

    resetBtn?.addEventListener('click', () => {
      selectedCategory = 'all';
      selectedStatus = 'all';
      applyFilters();
      categoryButtons[0]?.focus();
    });
  }

  setupRecommendationsFilters();
  document.addEventListener('astro:page-load', setupRecommendationsFilters);
</script>
