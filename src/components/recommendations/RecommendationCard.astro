---
/**
 * Card cinematográfico editorial da seção Recomendações (EXP-05A).
 *
 * Apresenta imagem real destacada (quando disponível, com abertura no lightbox),
 * comentários literais do autor, metadados discretos e links externos —
 * sem notas numéricas, preços ou aparência de vitrine comercial.
 */
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/base';
import {
  RECOMMENDATION_CATEGORIES,
  RECOMMENDATION_KIND_LABELS,
  RECOMMENDATION_STATUSES,
  shouldShowCurrentlyUsingBadge,
} from '../../utils/recommendations';

interface Props {
  recommendation: CollectionEntry<'recommendations'>;
  index?: number;
}

const { recommendation, index = 0 } = Astro.props;
const { data } = recommendation;

const categoryMeta = RECOMMENDATION_CATEGORIES[data.category];
const statusMeta = RECOMMENDATION_STATUSES[data.status];
const kindLabel = data.kind ? RECOMMENDATION_KIND_LABELS[data.kind] : null;
const showCurrentlyUsing = shouldShowCurrentlyUsingBadge(
  data.status,
  data.currentlyUsing,
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('pt-BR', {
    month: 'long',
    year: 'numeric',
  }).format(date);

const addedFormatted = data.addedAt ? formatDate(data.addedAt) : null;
const updatedFormatted = data.updatedAt ? formatDate(data.updatedAt) : null;
const isEager = index < 2;
---

<article
  data-recommendation-card
  data-category={data.category}
  data-status={data.status}
  class="v2-shadow-card group grid grid-cols-1 overflow-hidden border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/85 transition-colors hover:border-[var(--color-v2-border-hover)] lg:grid-cols-12"
>
  {/* Palco fotográfico destacado (ou reserva tipográfica sóbria sem imagem fictícia) */}
  <div class="relative flex flex-col justify-center border-b border-[var(--color-v2-border)] bg-[var(--color-v2-media-surface)] p-4 sm:p-5 lg:col-span-5 lg:border-r lg:border-b-0">
    {data.image ? (
      <div class="overflow-hidden border border-[var(--color-v2-media-border)] bg-[var(--color-v2-media-bg)]">
        <img
          src={withBase(data.image.url)}
          alt={data.image.alt}
          loading={isEager ? 'eager' : 'lazy'}
          decoding="async"
          data-editorial-lightbox-trigger="true"
          data-lightbox-src={withBase(data.image.url)}
          data-lightbox-alt={data.image.alt}
          data-lightbox-caption={data.image.alt}
          tabindex="0"
          role="button"
          aria-label={`Ampliar imagem de ${data.name}`}
          class="mx-auto block h-auto max-h-[340px] w-full cursor-zoom-in object-contain object-center transition-transform duration-500 group-hover:scale-[1.02]"
        />
      </div>
    ) : (
      <div class="flex aspect-[16/10] w-full flex-col items-center justify-center border border-dashed border-[var(--color-v2-media-border)] bg-[var(--color-v2-media-bg)] px-6 text-center">
        <span class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.2em] text-[var(--color-v2-accent-warm)] uppercase">
          {categoryMeta.label}
        </span>
        <span class="mt-2 font-[family-name:var(--font-v2-display)] text-2xl text-[var(--color-v2-media-text)]">
          {data.name}
        </span>
        <span class="mt-2 font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.14em] text-[var(--color-v2-media-muted)] uppercase">
          Fotografia real em preparação
        </span>
      </div>
    )}
  </div>

  {/* Conteúdo editorial e metadados discretos */}
  <div class="flex flex-col justify-between p-6 sm:p-8 lg:col-span-7">
    <div>
      {/* Linha superior: categoria, tipo e estado de experiência */}
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--color-v2-border)] pb-4">
        <div class="flex flex-wrap items-center gap-2 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.14em] uppercase">
          <span class="text-[var(--color-v2-accent-warm)]">
            {categoryMeta.label}
          </span>
          {kindLabel && (
            <>
              <span
                aria-hidden="true"
                class="text-[var(--color-v2-border-hover)]"
              >
                ·
              </span>
              <span class="text-[var(--color-v2-text-muted)]">{kindLabel}</span>
            </>
          )}
          {data.subcategory && (
            <>
              <span
                aria-hidden="true"
                class="text-[var(--color-v2-border-hover)]"
              >
                ·
              </span>
              <span class="text-[var(--color-v2-text-muted)]">
                {data.subcategory}
              </span>
            </>
          )}
        </div>

        <div class="flex flex-wrap items-center gap-2 font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.14em] uppercase">
          <span
            title={statusMeta.description}
            class:list={[
              'border px-2.5 py-0.5',
              statusMeta.isDirectExperience
                ? 'border-[var(--color-v2-accent-warm)]/60 bg-[var(--color-v2-accent)]/10 text-[var(--color-v2-heading)]'
                : 'border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]/80 text-[var(--color-v2-text-muted)]',
            ]}
          >
            {statusMeta.label}
          </span>

          {showCurrentlyUsing && (
            <span class="border border-[var(--color-v2-border-hover)] bg-[var(--color-v2-bg)] px-2.5 py-0.5 text-[var(--color-v2-accent-warm)]">
              Uso atualmente
            </span>
          )}
        </div>
      </div>

      {/* Título do item */}
      <h2 class="mt-5 font-[family-name:var(--font-v2-display)] text-3xl leading-[1.1] font-normal tracking-[-0.01em] text-[var(--color-v2-heading)] sm:text-[2.125rem]">
        {data.name}
      </h2>

      {/* Destaques objetivos opcionais */}
      {data.highlights.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {data.highlights.map((highlight) => (
            <li class="border border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]/70 px-2.5 py-1 font-[family-name:var(--font-v2-mono)] text-[11px] text-[var(--color-v2-text)]">
              {highlight}
            </li>
          ))}
        </ul>
      )}

      {/* Comentário pessoal literal do autor */}
      <div class="mt-5 space-y-3.5 font-[family-name:var(--font-v2-sans)] text-[0.9875rem] leading-[1.78] font-light text-[var(--color-v2-text-body)]">
        {data.commentParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      {/* Pontos positivos / considerações opcionais (somente quando preenchidos) */}
      {(data.pros.length > 0 || data.cons.length > 0) && (
        <div class="mt-6 grid grid-cols-1 gap-4 border-t border-[var(--color-v2-border)] pt-5 sm:grid-cols-2">
          {data.pros.length > 0 && (
            <div>
              <p class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.16em] text-[var(--color-v2-accent-warm)] uppercase">
                Pontos positivos
              </p>
              <ul class="mt-2 space-y-1.5 font-[family-name:var(--font-v2-sans)] text-sm font-light text-[var(--color-v2-text-body)]">
                {data.pros.map((pro) => (
                  <li class="flex items-start gap-2">
                    <span
                      aria-hidden="true"
                      class="mt-0.5 text-[var(--color-v2-accent-warm)]"
                    >
                      +
                    </span>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {data.cons.length > 0 && (
            <div>
              <p class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.16em] text-[var(--color-v2-text-muted)] uppercase">
                Pontos de atenção
              </p>
              <ul class="mt-2 space-y-1.5 font-[family-name:var(--font-v2-sans)] text-sm font-light text-[var(--color-v2-text-body)]">
                {data.cons.map((con) => (
                  <li class="flex items-start gap-2">
                    <span
                      aria-hidden="true"
                      class="mt-0.5 text-[var(--color-v2-text-muted)]"
                    >
                      &minus;
                    </span>
                    <span>{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </div>

    {/* Rodapé: links externos oficiais e datas discretas */}
    {(data.externalLinks.length > 0 || addedFormatted || updatedFormatted) && (
      <footer class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--color-v2-border)] pt-4">
        <div class="flex flex-wrap items-center gap-3">
          {data.externalLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="v2-focus inline-flex min-h-9 items-center gap-2 border border-[var(--color-v2-border-hover)] bg-[var(--color-v2-bg)] px-3.5 py-1.5 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.12em] text-[var(--color-v2-heading)] uppercase transition-colors hover:border-[var(--color-v2-accent-warm)] hover:text-[var(--color-v2-accent-warm)]"
            >
              <span>{link.label}</span>
              <span aria-hidden="true">&nearr;</span>
            </a>
          ))}
        </div>

        {(addedFormatted || updatedFormatted) && (
          <p class="font-[family-name:var(--font-v2-mono)] text-[11px] text-[var(--color-v2-text-muted)]">
            {updatedFormatted
              ? `Atualizado em ${updatedFormatted}`
              : `Adicionado em ${addedFormatted}`}
          </p>
        )}
      </footer>
    )}
  </div>
</article>
