---
/**
 * Timeline editorial de Sistemas Operacionais — Design System 2.0 (VIS-05).
 * Substitui o brilho neon ciano por iluminação discreta em vermelho envelhecido
 * e bronze, preservando integralmente os dados de `src/data/linuxTimeline.ts`.
 */
import { linuxTimeline } from '../../data/linuxTimeline';
---

<div class="relative py-8">
  <!-- Eixo vertical contínuo com iluminação sutil (esquerda no mobile, centro no desktop) -->
  <div
    aria-hidden="true"
    class="from-v2-border/50 via-v2-border to-v2-accent/80 pointer-events-none absolute top-0 bottom-0 left-4 w-px -translate-x-1/2 bg-linear-to-b md:left-1/2"
  ></div>

  <ol class="space-y-12 md:space-y-16">
    {linuxTimeline.map((item, index) => {
      const isEven = index % 2 === 0;

      return (
        <li class="relative flex flex-col md:flex-row md:items-center">
          {/* Marcador editorial no eixo */}
          <div
            aria-hidden="true"
            class="absolute top-6 left-4 z-10 -translate-x-1/2 md:top-1/2 md:left-1/2 md:-translate-y-1/2"
          >
            <span
              class:list={[
                'bg-v2-bg flex size-4 items-center justify-center border transition-colors',
                item.current
                  ? 'border-v2-accent shadow-[0_0_18px_rgba(121,56,47,0.55)]'
                  : 'border-v2-border',
              ]}
            >
              <span
                class:list={[
                  'size-1.5',
                  item.current ? 'bg-v2-accent' : 'bg-v2-accent-warm/70',
                ]}
              />
            </span>
          </div>

          {/* Painel de registro alternado no desktop */}
          <div
            class:list={[
              'ml-11 md:ml-0 md:w-1/2',
              isEven ? 'md:pr-14' : 'md:ml-auto md:pl-14',
            ]}
          >
            <article
              class:list={[
                'bg-v2-surface/65 relative border p-6 sm:p-7',
                item.current
                  ? 'border-v2-accent/80 bg-v2-surface v2-shadow-glow'
                  : 'border-v2-border/80',
              ]}
            >
              {/* Cantoneiras discretas no registro atual */}
              {item.current && (
                <>
                  <span
                    aria-hidden="true"
                    class="border-v2-accent pointer-events-none absolute -top-px -left-px h-3 w-3 border-t border-l"
                  />
                  <span
                    aria-hidden="true"
                    class="border-v2-accent-warm pointer-events-none absolute -right-px -bottom-px h-3 w-3 border-r border-b"
                  />
                </>
              )}

              <div class="border-v2-border/60 mb-4 flex flex-wrap items-center justify-between gap-2 border-b pb-3">
                <div class="flex items-center gap-2.5">
                  <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
                    {item.id}
                  </span>
                  <span aria-hidden="true" class="text-v2-border">
                    /
                  </span>
                  <span class="font-v2-mono text-v2-text-muted text-[0.5625rem] tracking-[0.16em] uppercase">
                    {item.category}
                  </span>
                </div>

                {item.current && (
                  <span class="border-v2-accent/70 bg-v2-accent/20 font-v2-mono text-v2-text inline-flex items-center gap-1.5 border px-2 py-0.5 text-[0.5625rem] tracking-[0.18em] uppercase">
                    <span
                      aria-hidden="true"
                      class="bg-v2-accent inline-block size-1.5"
                    />
                    Atual
                  </span>
                )}
              </div>

              <h3 class="font-v2-display text-v2-text text-2xl leading-tight font-medium sm:text-[1.75rem]">
                {item.name}
              </h3>

              <p class="font-v2-mono text-v2-accent-warm mt-1.5 text-[0.625rem] tracking-[0.16em] uppercase">
                {item.period}
              </p>

              <p class="font-v2-sans text-v2-text-body mt-4 text-sm leading-[1.8] font-light">
                {item.description}
              </p>

              <div class="border-v2-border/40 mt-5 flex flex-wrap gap-x-4 gap-y-1.5 border-t pt-3.5">
                {item.tags.map((tag) => (
                  <span class="font-v2-mono text-v2-text-muted/80 text-[0.5625rem] tracking-[0.14em] uppercase">
                    #{tag}
                  </span>
                ))}
              </div>
            </article>
          </div>
        </li>
      );
    })}
  </ol>
</div>
