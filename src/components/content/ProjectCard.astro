---
/**
 * Showcase horizontal de Projeto — Design System 2.0 (VIS-06a).
 * Segue `docs/DESIGN_SYSTEM_V2.md` §5 e §8:
 * - Cards horizontais grandes, print à esquerda e texto/ações à direita;
 * - Screenshots sem corte indevido (`object-contain`, sem `object-cover`);
 * - Preserva integralmente títulos, descrições, corpo Markdown, tecnologias e links.
 */
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/base';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const { data } = project;
const num = String(index + 1).padStart(2, '0');

// Parágrafos complementares do corpo Markdown de cada registro
const bodyParagraphs = (project.body ?? '')
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<article
  class:list={[
    'bg-v2-surface/55 group relative grid grid-cols-1 border transition-colors duration-300 lg:grid-cols-12 motion-reduce:transition-none',
    data.featured
      ? 'border-v2-border hover:border-v2-accent-warm/70'
      : 'border-v2-border/80 hover:border-v2-border',
  ]}
>
  {/* Cantoneiras discretas nos projetos em destaque */}
  {data.featured && (
    <>
      <span
        aria-hidden="true"
        class="border-v2-accent pointer-events-none absolute -top-px -left-px z-10 h-3.5 w-3.5 border-t border-l"
      />
      <span
        aria-hidden="true"
        class="border-v2-accent-warm/80 pointer-events-none absolute -right-px -bottom-px z-10 h-3.5 w-3.5 border-r border-b"
      />
    </>
  )}

  {/* Coluna esquerda (7/12 no desktop): Screenshot íntegra sem cortes */}
  {data.image && (
    <div class="border-v2-border/70 bg-v2-bg/85 flex flex-col justify-between border-b p-4 sm:p-6 lg:col-span-7 lg:border-r lg:border-b-0 lg:p-7">
      {/* Barra superior de catalogação da captura */}
      <div class="border-v2-border/50 mb-3.5 flex items-center justify-between border-b pb-2.5">
        <div class="flex items-center gap-2">
          <span
            aria-hidden="true"
            class="bg-v2-accent/80 inline-block size-1.5"
          />
          <span class="font-v2-mono text-v2-text-muted/80 text-[0.5625rem] tracking-[0.18em] uppercase">
            Captura // {project.id}
          </span>
        </div>
        <span class="font-v2-mono text-v2-accent-warm/80 text-[0.5625rem] tracking-[0.16em] uppercase">
          {data.category}
        </span>
      </div>

      {/* Moldura da imagem preservando 100% da proporção original */}
      <div class="border-v2-border/60 bg-v2-bg relative my-auto overflow-hidden border">
        <img
          src={withBase(data.image.url)}
          alt={data.image.alt}
          width="1280"
          height="662"
          loading={index < 2 ? 'eager' : 'lazy'}
          decoding="async"
          class="block h-auto w-full object-contain brightness-[0.94] transition-[filter] duration-500 group-hover:brightness-100 motion-reduce:transition-none"
        />
      </div>

      {/* Rodapé técnico da moldura */}
      <div class="border-v2-border/40 mt-3.5 flex items-center justify-between border-t pt-2.5">
        <span class="font-v2-mono text-v2-text-muted/60 text-[0.5rem] tracking-[0.18em] uppercase">
          Proporção original preservada
        </span>
        <span class="font-v2-mono text-v2-text-muted/60 text-[0.5rem] tracking-[0.18em] uppercase">
          REG. PRJ-{num}
        </span>
      </div>
    </div>
  )}

  {/* Coluna direita (5/12 no desktop): Dossiê editorial, tecnologias e ações */}
  <div
    class:list={[
      'flex flex-col justify-between gap-7 p-6 sm:p-8 lg:p-9',
      data.image ? 'lg:col-span-5' : 'lg:col-span-12',
    ]}
  >
    <div>
      {/* Cabeçalho de metadados do projeto */}
      <div class="border-v2-border/60 mb-5 flex flex-wrap items-center justify-between gap-2 border-b pb-3.5">
        <div class="flex items-center gap-3">
          <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
            {num}
          </span>
          <span aria-hidden="true" class="bg-v2-border h-px w-5"></span>
          <span class="font-v2-mono text-v2-text-muted text-[0.5625rem] tracking-[0.18em] uppercase">
            {data.category}
          </span>
        </div>

        <div class="flex items-center gap-2">
          {data.featured && (
            <span class="border-v2-accent/70 bg-v2-accent/20 font-v2-mono text-v2-text inline-flex items-center gap-1.5 border px-2.5 py-0.5 text-[0.5625rem] tracking-[0.18em] uppercase">
              <span
                aria-hidden="true"
                class="bg-v2-accent inline-block size-1.5"
              />
              Destaque
            </span>
          )}
          {data.isDemo && (
            <span class="border-v2-accent-warm/60 font-v2-mono text-v2-accent-warm border px-2 py-0.5 text-[0.5625rem] tracking-[0.16em] uppercase">
              Demo
            </span>
          )}
        </div>
      </div>

      {/* Título editorial */}
      <h2 class="font-v2-display text-v2-text text-[clamp(1.75rem,2.4vw,2.35rem)] leading-[1.08] font-medium tracking-[-0.01em]">
        {data.title}
      </h2>

      {/* Descrição principal (frontmatter) */}
      <p class="font-v2-sans text-v2-text/90 mt-4 text-sm leading-[1.8] font-normal">
        {data.description}
      </p>

      {/* Notas complementares do corpo Markdown */}
      {bodyParagraphs.length > 0 && (
        <div class="border-v2-border/50 font-v2-sans text-v2-text-muted mt-4 space-y-3 border-l pl-4 text-xs leading-[1.8] font-light sm:text-[0.8125rem]">
          {bodyParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}

      {/* Tecnologias / tags */}
      {data.tags.length > 0 && (
        <div class="mt-6">
          <span class="font-v2-mono text-v2-text-muted/70 block text-[0.5rem] tracking-[0.2em] uppercase">
            Tecnologias &amp; Domínio
          </span>
          <ul class="mt-2.5 flex flex-wrap gap-2">
            {data.tags.map((tag) => (
              <li class="border-v2-border/70 bg-v2-bg/60 font-v2-mono text-v2-text-muted border px-2.5 py-1 text-[0.5625rem] tracking-[0.14em] uppercase">
                #{tag}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    {/* Ações e links externos verificados */}
    <div class="border-v2-border/60 flex flex-wrap items-center gap-3 border-t pt-5">
      {data.liveUrl && (
        <a
          href={data.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="v2-focus group/btn border-v2-accent bg-v2-accent/25 hover:bg-v2-accent font-v2-sans text-v2-text inline-flex min-h-11 flex-1 items-center justify-between gap-4 border px-4 py-2.5 text-[0.625rem] tracking-[0.18em] uppercase transition-colors duration-300 sm:flex-initial motion-reduce:transition-none"
        >
          <span>Acessar demonstração</span>
          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover/btn:translate-x-1 motion-reduce:transition-none"
          >
            →
          </span>
        </a>
      )}

      {data.repoUrl && (
        <a
          href={data.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="v2-focus group/repo border-v2-border hover:border-v2-text/60 bg-v2-bg/50 font-v2-sans text-v2-text-muted hover:text-v2-text inline-flex min-h-11 flex-1 items-center justify-between gap-4 border px-4 py-2.5 text-[0.625rem] tracking-[0.18em] uppercase transition-colors duration-300 sm:flex-initial motion-reduce:transition-none"
        >
          <span>Repositório GitHub</span>
          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover/repo:translate-x-0.5 group-hover/repo:-translate-y-0.5 motion-reduce:transition-none"
          >
            ↗
          </span>
        </a>
      )}

      {!data.repoUrl && !data.liveUrl && (
        <span class="font-v2-mono text-v2-text-muted/60 text-[0.625rem] tracking-[0.14em] uppercase">
          [ Registro sem links externos ]
        </span>
      )}
    </div>
  </div>
</article>
