---
import fs from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import { withBase } from '../../utils/base';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;

// Resolve formato real do arquivo (webp, png, jpg) na pasta public/images/projects
let resolvedImageUrl = data.image?.url;
if (resolvedImageUrl && resolvedImageUrl.startsWith('/images/projects/')) {
  const baseName = resolvedImageUrl
    .replace(/^\/images\/projects\//, '')
    .replace(/\.(webp|png|jpg|jpeg)$/, '');
  const publicDir = path.resolve('./public/images/projects');
  if (fs.existsSync(path.join(publicDir, `${baseName}.webp`))) {
    resolvedImageUrl = `/images/projects/${baseName}.webp`;
  } else if (fs.existsSync(path.join(publicDir, `${baseName}.png`))) {
    resolvedImageUrl = `/images/projects/${baseName}.png`;
  } else if (fs.existsSync(path.join(publicDir, `${baseName}.jpg`))) {
    resolvedImageUrl = `/images/projects/${baseName}.jpg`;
  }
}
---

<Card
  as="article"
  class="flex flex-col md:flex-row border-border/80 bg-surface/90 p-0 overflow-hidden transition-all duration-300 hover:border-accent/50 hover:shadow-xl hover:shadow-accent/5 group"
>
  {data.image && resolvedImageUrl && (
    <div class="w-full md:w-[55%] shrink-0 flex items-center bg-bg/70 border-b md:border-b-0 md:border-r border-border/50">
      <img
        src={withBase(resolvedImageUrl)}
        alt={data.image.alt}
        width="1280"
        height="662"
        loading="lazy"
        decoding="async"
        class="block w-full h-auto object-contain brightness-95 transition duration-300 group-hover:brightness-100"
      />
    </div>
  )}

  <div class="flex flex-col justify-between gap-5 p-5 sm:p-6 lg:p-7 flex-1 min-w-0">
    <div>
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <span class="font-mono text-xs font-semibold text-accent uppercase tracking-wider">
          // {data.category}
        </span>
        <div class="flex items-center gap-1.5 font-mono text-[10px]">
          {data.featured && (
            <span class="rounded bg-accent/15 px-2.5 py-0.5 font-semibold text-accent uppercase border border-accent/30 tracking-wider">
              Destaque
            </span>
          )}
          {data.isDemo && (
            <span class="rounded bg-warm/20 px-2 py-0.5 text-warm uppercase border border-warm/40">
              Mock Data
            </span>
          )}
        </div>
      </div>

      <h3 class="font-display text-xl sm:text-2xl font-bold tracking-tight text-text group-hover:text-accent transition-colors leading-snug">
        {data.title}
      </h3>

      <p class="font-body mt-3 text-[15px] leading-relaxed text-text-muted">
        {data.description}
      </p>

      {data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <span class="rounded border border-border/60 bg-surface-raised px-2.5 py-1 font-mono text-xs text-text-muted">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <div class="pt-4 border-t border-border/40 flex flex-wrap items-center gap-3">
      {data.repoUrl && (
        <Button href={data.repoUrl} external variant="secondary" class="flex-1 sm:flex-initial text-xs sm:text-sm py-2 px-4 justify-center">
          GitHub &nearr;
        </Button>
      )}
      {data.liveUrl && (
        <Button href={data.liveUrl} external class="flex-1 sm:flex-initial text-xs sm:text-sm py-2 px-4 justify-center">
          Acessar Demo &rarr;
        </Button>
      )}
      {!data.repoUrl && !data.liveUrl && (
        <span class="font-mono text-xs text-text-muted/60">
          [ Módulo sem links externos ]
        </span>
      )}
    </div>
  </div>
</Card>
