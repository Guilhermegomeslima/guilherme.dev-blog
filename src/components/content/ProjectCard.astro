---
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
---

<Card
  as="article"
  class="flex flex-col justify-between border-border/80 bg-surface/90 p-0 overflow-hidden transition-all duration-300 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5 group"
>
  <div>
    {data.image && (
      <div class="relative aspect-video w-full overflow-hidden bg-surface-raised border-b border-border/60">
        <img
          src={data.image.url}
          alt={data.image.alt}
          width="600"
          height="338"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover filter contrast-110 brightness-90 transition duration-500 group-hover:scale-105 group-hover:brightness-100"
        />
      </div>
    )}

    <div class="p-6">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <span class="font-mono text-xs font-semibold text-accent uppercase tracking-wider">
          // {data.category}
        </span>
        <div class="flex items-center gap-1.5 font-mono text-[10px]">
          {data.featured && (
            <span class="rounded bg-accent/15 px-2 py-0.5 font-semibold text-accent uppercase border border-accent/30">
              Destaque
            </span>
          )}
          {data.isDemo && (
            <span class="rounded bg-warm/20 px-2 py-0.5 text-warm uppercase border border-warm/40">
              Mock Data
            </span>
          )}
        </div>
      </div>

      <h3 class="font-display text-xl font-bold tracking-tight text-text group-hover:text-accent transition-colors">
        {data.title}
      </h3>

      <p class="font-body mt-3 text-sm leading-relaxed text-text-muted">
        {data.description}
      </p>

      {data.tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-1.5">
          {data.tags.map((tag) => (
            <span class="rounded border border-border/60 bg-surface-raised px-2.5 py-0.5 font-mono text-[11px] text-text-muted">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="p-6 pt-0 border-t border-border/40 mt-4 flex flex-wrap items-center gap-3">
    {data.repoUrl && (
      <Button href={data.repoUrl} external variant="secondary" class="flex-1">
        GitHub &nearr;
      </Button>
    )}
    {data.liveUrl && (
      <Button href={data.liveUrl} external class="flex-1">
        Acessar Demo &rarr;
      </Button>
    )}
    {!data.repoUrl && !data.liveUrl && (
      <span class="font-mono text-xs text-text-muted/60">
        [ Módulo demonstrativo sem links externos ]
      </span>
    )}
  </div>
</Card>
