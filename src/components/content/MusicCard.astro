---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/base';

interface Props {
  item: CollectionEntry<'music'>;
  index?: number;
  relatedAlbums?: string[];
  relatedTracks?: string[];
}

const { item, index = 0, relatedAlbums = [], relatedTracks = [] } = Astro.props;
const { data } = item;

const num = String(index + 1).padStart(2, '0');
---

{data.type === 'artist' && (
  <article
    data-music-item
    data-type="artist"
    data-title={data.title.toLowerCase()}
    data-artist={(data.artist || data.title).toLowerCase()}
    class="group relative flex min-w-0 flex-col justify-between border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/75 transition-all duration-300 hover:-translate-y-0.5 hover:border-[var(--color-v2-border-hover)] hover:v2-shadow-card"
  >
    <div>
      {/* Fotografia do Artista / Banda (1:1 com enquadramento editorial) */}
      <div class="relative aspect-square w-full overflow-hidden border-b border-[var(--color-v2-border)] bg-[var(--color-v2-media-surface)]">
        {data.coverImage ? (
          <img
            src={withBase(data.coverImage.url)}
            alt={data.coverImage.alt}
            width="600"
            height="600"
            loading={index < 6 ? 'eager' : 'lazy'}
            decoding="async"
            class="h-full w-full object-cover brightness-[0.92] contrast-[1.05] transition-all duration-700 ease-out group-hover:scale-[1.03] group-hover:brightness-100"
          />
        ) : (
          <div class="flex h-full w-full flex-col justify-between bg-[var(--color-v2-media-bg)] p-3 select-none sm:p-6">
            <span class="font-[family-name:var(--font-v2-mono)] text-[8px] tracking-[0.2em] text-[var(--color-v2-media-warm)] uppercase sm:text-[10px]">
              // ARTISTA
            </span>
            <p class="font-[family-name:var(--font-v2-display)] text-base text-[var(--color-v2-media-text)] sm:text-2xl">
              {data.title}
            </p>
            <span class="font-[family-name:var(--font-v2-mono)] text-[8px] text-[var(--color-v2-media-muted)] sm:text-[10px]">
              Arquivo Sonoro
            </span>
          </div>
        )}

        {/* Vinheta atmosférica inferior */}
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-[var(--color-v2-media-bg)] via-[var(--color-v2-media-bg)]/45 to-transparent sm:h-28"
        />

        {/* Identificador discreto no topo */}
        <div class="absolute top-2 left-2 flex items-center gap-1.5 border border-white/10 bg-[var(--color-v2-media-bg)]/85 px-1.5 py-0.5 font-[family-name:var(--font-v2-mono)] text-[8px] tracking-[0.16em] text-[var(--color-v2-media-warm)] uppercase backdrop-blur-xs sm:top-3 sm:left-3 sm:gap-2 sm:px-2.5 sm:py-1 sm:text-[10px] sm:tracking-[0.18em]">
          <span>ART // {num}</span>
        </div>

        {data.isDemo && (
          <div class="absolute top-2 right-2 border border-[var(--color-v2-media-warm)]/50 bg-[var(--color-v2-media-bg)]/90 px-1.5 py-0.5 font-[family-name:var(--font-v2-mono)] text-[8px] text-[var(--color-v2-media-warm)] uppercase sm:top-3 sm:right-3 sm:text-[10px]">
            Mock Data
          </div>
        )}

        {/* Nome em destaque sobre a base da fotografia */}
        <div class="absolute inset-x-2.5 bottom-2 sm:inset-x-4 sm:bottom-3">
          {data.genre && (
            <span class="mb-0.5 block truncate font-[family-name:var(--font-v2-mono)] text-[8px] tracking-[0.14em] text-[var(--color-v2-media-warm)] uppercase sm:mb-1 sm:text-[10px] sm:tracking-[0.16em]">
              {data.genre}
            </span>
          )}
          <h3 class="line-clamp-2 font-[family-name:var(--font-v2-display)] text-base leading-[1.15] font-normal tracking-[-0.01em] text-[var(--color-v2-media-text)] break-words transition-colors duration-200 group-hover:text-[var(--color-v2-media-warm)] sm:text-[1.65rem] sm:leading-[1.1]">
            {data.title}
          </h3>
        </div>
      </div>

      {/* Metadados e Associações no Acervo */}
      <div class="p-2.5 sm:p-5">
        {data.comment && (
          <p class="mb-3 hidden font-[family-name:var(--font-v2-sans)] text-xs leading-relaxed font-light text-[var(--color-v2-text)] sm:block">
            {data.comment}
          </p>
        )}

        {relatedAlbums.length > 0 || relatedTracks.length > 0 ? (
          <div class="space-y-1 font-[family-name:var(--font-v2-mono)] text-[9px] sm:text-[10px]">
            {relatedAlbums.length > 0 && (
              <div class="flex flex-wrap items-baseline gap-1 sm:gap-1.5">
                <span class="tracking-[0.14em] text-[var(--color-v2-accent-warm)] uppercase">
                  Álbum:
                </span>
                <span class="line-clamp-1 text-[var(--color-v2-text)] break-words">
                  {relatedAlbums.join(' · ')}
                </span>
              </div>
            )}
            {relatedTracks.length > 0 && (
              <div class="hidden flex-wrap items-baseline gap-1.5 sm:flex">
                <span class="tracking-[0.14em] text-[var(--color-v2-muted)] uppercase">
                  {relatedTracks.length === 1 ? 'Faixa:' : 'Faixas:'}
                </span>
                <span class="text-[var(--color-v2-muted)]">
                  {relatedTracks.join(' · ')}
                </span>
              </div>
            )}
          </div>
        ) : (
          <p class="truncate font-[family-name:var(--font-v2-mono)] text-[8px] tracking-[0.14em] text-[var(--color-v2-muted)] uppercase sm:text-[10px]">
            Acervo pessoal
          </p>
        )}
      </div>
    </div>

    {/* Link Externo */}
    {data.listenUrl && (
      <div class="px-2.5 pb-2.5 sm:px-5 sm:pb-5">
        <div class="border-t border-[var(--color-v2-border)] pt-2 sm:pt-3">
          <a
            href={data.listenUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="v2-focus inline-flex w-full items-center justify-between font-[family-name:var(--font-v2-mono)] text-[9px] tracking-[0.14em] text-[var(--color-v2-muted)] uppercase transition-colors hover:text-[var(--color-v2-heading)] sm:text-[10px] sm:tracking-[0.16em]"
          >
            <span>
              <span class="hidden sm:inline">Canal no </span>YouTube
            </span>
            <span
              aria-hidden="true"
              class="shrink-0 text-[var(--color-v2-accent-warm)] transition-transform duration-200 group-hover:translate-x-0.5"
            >
              &nearr;
            </span>
          </a>
        </div>
      </div>
    )}
  </article>
)}

{data.type === 'album' && (
  <article
    data-music-item
    data-type="album"
    data-title={data.title.toLowerCase()}
    data-artist={(data.artist || '').toLowerCase()}
    class="group relative flex h-full min-w-0 flex-col justify-between border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/80 transition-all duration-300 hover:border-[var(--color-v2-border-hover)] hover:v2-shadow-card"
  >
    {/* Cantoneiras discretas em bronze */}
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-px -left-px h-2.5 w-2.5 border-t border-l border-[var(--color-v2-accent-warm)]/55"
    />
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-px -right-px h-2.5 w-2.5 border-r border-b border-[var(--color-v2-accent-warm)]/55"
    />

    <div class="flex h-full flex-col justify-between sm:grid sm:grid-cols-[168px_1fr]">
      {/* Capa 1:1 emoldurada como encarte físico */}
      <div class="relative aspect-square w-full overflow-hidden border-b border-[var(--color-v2-border)] bg-[var(--color-v2-media-surface)] sm:border-r sm:border-b-0">
        {data.coverImage ? (
          <img
            src={withBase(data.coverImage.url)}
            alt={data.coverImage.alt}
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover brightness-95 contrast-105 transition-transform duration-700 ease-out group-hover:scale-[1.03] group-hover:brightness-100"
          />
        ) : (
          <div class="flex h-full w-full flex-col justify-between bg-[var(--color-v2-media-bg)] p-3 select-none sm:p-5">
            <span class="font-[family-name:var(--font-v2-mono)] text-[8px] tracking-[0.18em] text-[var(--color-v2-media-warm)] uppercase sm:text-[9px]">
              // ÁLBUM
            </span>
            <p class="font-[family-name:var(--font-v2-display)] text-base text-[var(--color-v2-media-text)] sm:text-lg">
              {data.title}
            </p>
          </div>
        )}

        {/* Moldura interna sutil de encarte */}
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-1.5 border border-white/10 sm:inset-2"
        />
      </div>

      {/* Ficha do Álbum */}
      <div class="flex min-w-0 flex-1 flex-col justify-between p-2.5 sm:p-6">
        <div>
          <div class="mb-1.5 flex flex-wrap items-center justify-between gap-1 font-[family-name:var(--font-v2-mono)] text-[8px] tracking-[0.16em] uppercase sm:mb-2 sm:gap-2 sm:text-[10px] sm:tracking-[0.18em]">
            <span class="text-[var(--color-v2-accent-warm)]">
              ÁLBUM // {num}
            </span>
            {data.year && (
              <span class="border border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]/80 px-1.5 py-0.5 text-[var(--color-v2-text)] sm:px-2">
                {data.year}
              </span>
            )}
          </div>

          <h3 class="line-clamp-2 font-[family-name:var(--font-v2-display)] text-base leading-[1.18] font-normal tracking-[-0.01em] text-[var(--color-v2-heading)] break-words transition-colors duration-200 group-hover:text-[var(--color-v2-accent-warm)] sm:text-3xl sm:leading-[1.12]">
            {data.title}
          </h3>

          {data.artist && (
            <p class="mt-1 truncate font-[family-name:var(--font-v2-sans)] text-[11px] font-light text-[var(--color-v2-muted)] sm:mt-1.5 sm:text-xs">
              <span class="hidden sm:inline">Artista: </span>
              <strong class="font-medium text-[var(--color-v2-text)]">
                {data.artist}
              </strong>
            </p>
          )}

          {data.comment && (
            <p class="mt-3 hidden font-[family-name:var(--font-v2-sans)] text-xs leading-relaxed font-light text-[var(--color-v2-muted)] sm:block">
              {data.comment}
            </p>
          )}

          {relatedTracks.length > 0 && (
            <div class="mt-4 hidden border-t border-[var(--color-v2-border)] pt-2.5 font-[family-name:var(--font-v2-mono)] text-[10px] sm:block">
              <span class="tracking-[0.14em] text-[var(--color-v2-muted)] uppercase">
                Faixas destacadas do artista:{' '}
              </span>
              <span class="text-[var(--color-v2-text)]">
                {relatedTracks.join(' · ')}
              </span>
            </div>
          )}
        </div>

        {data.listenUrl && (
          <div class="mt-2.5 border-t border-[var(--color-v2-border)] pt-2 sm:mt-5 sm:pt-3">
            <a
              href={data.listenUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="v2-focus inline-flex items-center gap-1.5 font-[family-name:var(--font-v2-mono)] text-[9px] tracking-[0.14em] text-[var(--color-v2-accent-warm)] uppercase transition-colors hover:text-[var(--color-v2-heading)] sm:gap-2 sm:text-[10px] sm:tracking-[0.16em]"
            >
              <span class="hidden sm:inline">
                Acessar discografia no YouTube
              </span>
              <span class="sm:hidden">Discografia YouTube</span>
              <span aria-hidden="true">&nearr;</span>
            </a>
          </div>
        )}
      </div>
    </div>
  </article>
)}

{data.type === 'track' && (
  <article
    data-music-item
    data-type="track"
    data-title={data.title.toLowerCase()}
    data-artist={(data.artist || '').toLowerCase()}
    class="group relative flex min-w-0 flex-col justify-between border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/75 p-2.5 transition-all duration-300 hover:border-[var(--color-v2-border-hover)] hover:v2-shadow-card sm:flex-row sm:items-center sm:gap-4 sm:border-x-0 sm:border-t-0 sm:border-b sm:bg-[var(--color-v2-surface)]/45 sm:p-0 sm:px-6 sm:py-5 sm:first:border-t hover:sm:bg-[var(--color-v2-surface)]/90"
  >
    <div class="flex flex-col sm:min-w-0 sm:flex-row sm:items-center sm:gap-4 md:gap-5">
      {/* Numeração da Faixa (desktop) */}
      <span class="hidden w-7 shrink-0 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.16em] text-[var(--color-v2-accent-warm)] sm:inline-block">
        {num}
      </span>

      {/* Capa 1:1 (cheia no mobile, miniatura 56x56 no desktop) */}
      <div class="relative aspect-square w-full overflow-hidden border border-[var(--color-v2-border)] bg-[var(--color-v2-media-surface)] sm:h-14 sm:w-14 sm:shrink-0 sm:aspect-auto sm:border-[var(--color-v2-border-hover)]">
        {data.coverImage ? (
          <img
            src={withBase(data.coverImage.url)}
            alt={data.coverImage.alt}
            width="112"
            height="112"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover brightness-95 contrast-105 transition-transform duration-500 group-hover:scale-105"
          />
        ) : (
          <div
            aria-hidden="true"
            class="flex h-full w-full items-center justify-center bg-[var(--color-v2-media-bg)] font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.14em] text-[var(--color-v2-media-warm)]"
          >
            FAIXA
          </div>
        )}

        {/* Badge do número da faixa no mobile */}
        <div class="absolute top-1.5 left-1.5 flex items-center border border-white/10 bg-[var(--color-v2-media-bg)]/85 px-1.5 py-0.5 font-[family-name:var(--font-v2-mono)] text-[8px] tracking-[0.16em] text-[var(--color-v2-media-warm)] uppercase backdrop-blur-xs sm:hidden">
          <span>#{num}</span>
        </div>
      </div>

      {/* Título e Artista da Faixa */}
      <div class="mt-2 min-w-0 sm:mt-0">
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 sm:gap-x-3 sm:gap-y-1">
          <h3 class="line-clamp-2 font-[family-name:var(--font-v2-display)] text-base leading-[1.18] font-normal text-[var(--color-v2-heading)] break-words transition-colors duration-200 group-hover:text-[var(--color-v2-accent-warm)] sm:text-2xl sm:leading-none">
            {data.title}
          </h3>
          {data.year && (
            <span class="font-[family-name:var(--font-v2-mono)] text-[9px] text-[var(--color-v2-muted)] sm:text-[11px]">
              ({data.year})
            </span>
          )}
        </div>

        <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 font-[family-name:var(--font-v2-sans)] text-[11px] font-light text-[var(--color-v2-muted)] sm:mt-1.5 sm:gap-x-3 sm:gap-y-1 sm:text-xs">
          {data.artist && (
            <span class="truncate">
              Por{' '}
              <strong class="font-normal text-[var(--color-v2-text)]">
                {data.artist}
              </strong>
            </span>
          )}
          {relatedAlbums.length > 0 && (
            <>
              <span
                aria-hidden="true"
                class="hidden text-[var(--color-v2-border-hover)] sm:inline"
              >
                ·
              </span>
              <span class="hidden font-[family-name:var(--font-v2-mono)] text-[10px] text-[var(--color-v2-muted)] sm:inline">
                Álbum no acervo: {relatedAlbums.join(', ')}
              </span>
            </>
          )}
        </div>

        {data.comment && (
          <p class="mt-2 hidden font-[family-name:var(--font-v2-sans)] text-xs font-light text-[var(--color-v2-muted)] sm:block">
            {data.comment}
          </p>
        )}
      </div>
    </div>

    {/* Ação de Escuta Externa */}
    {data.listenUrl && (
      <div class="mt-2.5 flex items-center justify-end border-t border-[var(--color-v2-border)] pt-2 sm:mt-0 sm:shrink-0 sm:border-0 sm:pt-0">
        <a
          href={data.listenUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="v2-focus inline-flex w-full items-center justify-between gap-1.5 border border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]/85 px-2.5 py-1.5 font-[family-name:var(--font-v2-mono)] text-[9px] tracking-[0.14em] text-[var(--color-v2-text)] uppercase transition-colors hover:border-[var(--color-v2-accent-warm)]/60 hover:text-[var(--color-v2-accent-warm)] sm:w-auto sm:justify-start sm:gap-2 sm:px-3.5 sm:py-2 sm:text-[10px] sm:tracking-[0.16em]"
        >
          <span class="sm:hidden">Ouvir</span>
          <span class="hidden sm:inline">Ouvir no YouTube</span>
          <span aria-hidden="true" class="text-[var(--color-v2-accent-warm)]">
            &nearr;
          </span>
        </a>
      </div>
    )}
  </article>
)}
