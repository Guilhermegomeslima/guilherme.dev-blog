---
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';

interface Props {
  item: CollectionEntry<'music'>;
}

const { item } = Astro.props;
const { data } = item;

const typeLabels: Record<string, { label: string; badgeClass: string }> = {
  artist: {
    label: 'ARTISTA',
    badgeClass: 'bg-accent/20 text-accent border-accent/40',
  },
  album: {
    label: 'ÁLBUM',
    badgeClass: 'bg-warm/20 text-warm border-warm/40',
  },
  track: {
    label: 'FAIXA',
    badgeClass: 'bg-surface-raised text-text-muted border-border/80',
  },
};

const currentType = typeLabels[data.type] || {
  label: data.type.toUpperCase(),
  badgeClass: 'bg-surface-raised text-text-muted border-border/80',
};
---

<Card
  as="article"
  class="flex flex-col justify-between border-border/80 bg-surface/90 p-0 overflow-hidden transition-all duration-300 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5 group"
>
  <div>
    {/* Capa com Proporção Quadrada 1:1 */}
    <div class="relative aspect-square w-full overflow-hidden bg-surface-raised border-b border-border/60">
      <img
        src={data.coverImage.url}
        alt={data.coverImage.alt}
        width="600"
        height="600"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover filter contrast-105 brightness-95 transition duration-500 group-hover:scale-105 group-hover:brightness-100"
      />

      {/* Badge do Tipo (Artista / Álbum / Faixa) */}
      <div
        class:list={[
          'absolute top-3 left-3 rounded border px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider backdrop-blur-xs shadow-md',
          currentType.badgeClass,
        ]}
      >
        {currentType.label}
      </div>

      {data.isDemo && (
        <div class="absolute bottom-3 right-3 rounded bg-warm/90 px-2 py-0.5 font-mono text-[10px] font-semibold text-bg uppercase shadow-md">
          Mock Data
        </div>
      )}
    </div>

    {/* Informações Textuais */}
    <div class="p-5">
      <div class="mb-2 flex flex-wrap items-center justify-between gap-1 font-mono text-xs text-text-muted">
        <span class="text-accent/90">{data.genre}</span>
        {data.year && <span>{data.year}</span>}
      </div>

      <h3 class="font-display text-lg font-bold tracking-tight text-text group-hover:text-accent transition-colors">
        {data.title}
      </h3>

      {data.artist && data.type !== 'artist' && (
        <p class="font-mono text-xs text-text-muted mt-1">Por {data.artist}</p>
      )}

      {data.comment && (
        <p class="font-body mt-3 text-sm leading-relaxed text-text-muted line-clamp-3">
          {data.comment}
        </p>
      )}
    </div>
  </div>

  {/* Link de Escuta Opcional */}
  {data.listenUrl && (
    <div class="p-5 pt-0">
      <a
        href={data.listenUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-accent hover:underline"
      >
        <span>Ouvir no Bandcamp / Streaming</span>
        <span aria-hidden="true">&nearr;</span>
      </a>
    </div>
  )}
</Card>
