---
import type { CollectionEntry } from 'astro:content';
import { calculateGameScore, formatScore } from '../../utils/ratings';
import { withBase } from '../../utils/base';

interface Props {
  game: CollectionEntry<'games'>;
  index?: number;
}

const { game, index = 0 } = Astro.props;
const { data, id } = game;

const finalScore = calculateGameScore(data.scores);
const formattedFinal = formatScore(finalScore);
const gameHref = withBase(`/jogos/${id}/`);

const statusConfig: Record<
  string,
  { label: string; badgeClass: string; dotClass?: string }
> = {
  Platinado: {
    label: 'Platinado',
    badgeClass:
      'border-[var(--color-v2-accent-warm)]/55 bg-[#070709]/92 text-[var(--color-v2-accent-warm)]',
    dotClass: 'bg-[var(--color-v2-accent-warm)]',
  },
  Concluido: {
    label: 'Concluído',
    badgeClass:
      'border-[var(--color-v2-border-hover)] bg-[#070709]/90 text-[var(--color-v2-text)]',
  },
  Jogando: {
    label: 'Jogando',
    badgeClass:
      'border-[var(--color-v2-accent)]/70 bg-[#070709]/92 text-[#e47986]',
    dotClass: 'bg-[var(--color-v2-accent)] animate-pulse',
  },
  Parado: {
    label: 'Parado',
    badgeClass:
      'border-[var(--color-v2-border)] bg-[#070709]/88 text-[var(--color-v2-muted)]',
  },
  Descontinuado: {
    label: 'Descontinuado',
    badgeClass:
      'border-[var(--color-v2-border)] bg-[#070709]/88 text-[var(--color-v2-muted)]/75',
  },
};

const currentStatus = statusConfig[data.status] || {
  label: data.status,
  badgeClass:
    'border-[var(--color-v2-border)] bg-[#070709]/88 text-[var(--color-v2-muted)]',
};

const miniAxes = [
  { key: 'MEC', val: data.scores.mechanics },
  { key: 'ENR', val: data.scores.plot },
  { key: 'EST', val: data.scores.aesthetics },
  { key: 'RET', val: data.scores.retention },
  { key: 'FEE', val: data.scores.feeling },
];
---

<article
  data-game-card
  data-title={data.title.toLowerCase()}
  data-genre={data.genre.toLowerCase()}
  data-developer={(data.developer || '').toLowerCase()}
  data-status={data.status}
  data-platform={data.platform}
  data-year={data.releaseYear}
  data-score={finalScore}
  data-index={index}
  class="group relative flex min-w-0 flex-col justify-between border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/75 transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-v2-border-hover)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.65)]"
>
  <a
    href={gameHref}
    class="v2-focus flex h-full min-w-0 flex-col justify-between"
    aria-label={`${data.title} (${data.releaseYear}) — Nota ${formattedFinal} de 100`}
  >
    {/* Moldura da Capa 3:4 */}
    <div class="relative aspect-[3/4] w-full overflow-hidden border-b border-[var(--color-v2-border)] bg-[#050508]">
      {!data.coverImage.isPlaceholder && data.coverImage.url ? (
        <img
          src={withBase(data.coverImage.url)}
          alt={data.coverImage.alt}
          width="600"
          height="800"
          loading={index < 8 ? 'eager' : 'lazy'}
          decoding="async"
          class="h-full w-full object-cover brightness-[0.94] contrast-[1.04] transition-all duration-500 ease-out group-hover:scale-[1.03] group-hover:brightness-100"
        />
      ) : (
        <div class="flex h-full w-full flex-col items-center justify-center bg-[#070709] p-4 text-center select-none sm:p-6">
          <span class="mb-1 font-[family-name:var(--font-v2-mono)] text-[9px] tracking-[0.16em] text-[var(--color-v2-accent-warm)] uppercase sm:mb-2 sm:text-[10px] sm:tracking-[0.2em]">
            // MÍDIA CATALOGADA
          </span>
          <h4 class="font-[family-name:var(--font-v2-display)] text-base font-normal text-[var(--color-v2-heading)] transition-colors group-hover:text-[var(--color-v2-accent-warm)] sm:text-xl">
            {data.title}
          </h4>
          <p class="mt-1 font-[family-name:var(--font-v2-mono)] text-[10px] text-[var(--color-v2-muted)] sm:mt-2 sm:text-[11px]">
            {data.developer || data.genre}
          </p>
          <span class="mt-2 border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)] px-2 py-0.5 font-[family-name:var(--font-v2-mono)] text-[9px] text-[var(--color-v2-muted)] sm:mt-4 sm:px-2.5 sm:text-[10px]">
            Capa Provisória
          </span>
        </div>
      )}

      {/* Vinheta sutil inferior para leitura dos metadados sobre a capa */}
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#070709]/95 via-[#070709]/40 to-transparent sm:h-24"
      ></div>

      {/* Topo esquerdo: Status no acervo */}
      <div class="absolute top-2 left-2 flex flex-col items-start gap-1 sm:top-3 sm:left-3 sm:gap-1.5">
        <div
          class:list={[
            'inline-flex items-center gap-1 border px-1.5 py-0.5 font-[family-name:var(--font-v2-mono)] text-[8px] tracking-[0.08em] uppercase backdrop-blur-xs sm:gap-1.5 sm:px-2 sm:text-[10px] sm:tracking-[0.14em]',
            currentStatus.badgeClass,
          ]}
        >
          {currentStatus.dotClass && (
            <span
              class:list={[
                'h-1 w-1 shrink-0 rounded-full sm:h-1.5 sm:w-1.5',
                currentStatus.dotClass,
              ]}
            />
          )}
          <span>{currentStatus.label}</span>
        </div>
      </div>

      {/* Topo direito: Medalhão da Nota Final */}
      <div class="absolute top-2 right-2 flex items-baseline gap-1 border border-[var(--color-v2-border-hover)] bg-[#070709]/92 px-1.5 py-0.5 backdrop-blur-xs transition-colors duration-300 group-hover:border-[var(--color-v2-accent-warm)]/60 sm:top-3 sm:right-3 sm:px-2.5 sm:py-1">
        <span class="font-[family-name:var(--font-v2-mono)] text-[8px] tracking-[0.1em] text-[var(--color-v2-muted)] uppercase sm:text-[9px] sm:tracking-[0.14em]">
          MÉDIA
        </span>
        <span class="font-[family-name:var(--font-v2-display)] text-base leading-none font-normal text-[var(--color-v2-heading)] group-hover:text-[var(--color-v2-accent-warm)] sm:text-lg">
          {formattedFinal}
        </span>
      </div>

      {/* Base da capa: Plataforma e Ano (visíveis a partir de sm:) */}
      <div class="hidden sm:flex absolute inset-x-3 bottom-2.5 items-center justify-between font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.12em]">
        <span class="border border-white/10 bg-[#070709]/85 px-2 py-0.5 text-[var(--color-v2-text)] backdrop-blur-xs">
          {data.platform}
        </span>
        <span class="text-[var(--color-v2-text)]/90">{data.releaseYear}</span>
      </div>

      {data.isDemo && (
        <div class="absolute right-2 bottom-2 border border-[var(--color-v2-accent-warm)]/50 bg-[#070709]/90 px-1.5 py-0.5 font-[family-name:var(--font-v2-mono)] text-[8px] text-[var(--color-v2-accent-warm)] uppercase sm:right-3 sm:bottom-10 sm:px-2 sm:text-[10px]">
          Mock Data
        </div>
      )}
    </div>

    {/* Corpo Editorial do Card */}
    <div class="flex flex-1 flex-col justify-between p-2.5 sm:p-5">
      <div>
        <div class="mb-1 flex items-center justify-between gap-1 font-[family-name:var(--font-v2-mono)] text-[9px] tracking-[0.1em] text-[var(--color-v2-accent-warm)]/85 uppercase sm:mb-1.5 sm:text-[10px] sm:tracking-[0.16em]">
          <span class="truncate">{data.genre}</span>
        </div>

        <h3 class="font-[family-name:var(--font-v2-display)] text-base leading-[1.18] font-normal tracking-[-0.01em] text-[var(--color-v2-heading)] transition-colors duration-200 group-hover:text-[var(--color-v2-accent-warm)] line-clamp-2 break-words sm:text-[1.35rem]">
          {data.title}
        </h3>

        {data.developer && (
          <p class="mt-1 hidden truncate font-[family-name:var(--font-v2-sans)] text-xs font-light text-[var(--color-v2-muted)] sm:block">
            {data.developer}
          </p>
        )}

        {data.description && (
          <p class="mt-2 hidden line-clamp-2 font-[family-name:var(--font-v2-sans)] text-xs leading-relaxed font-light text-[var(--color-v2-muted)] sm:block">
            {data.description}
          </p>
        )}
      </div>

      {/* Micro-leitura dos 5 Critérios + Call-to-action */}
      <div class="mt-2.5 border-t border-[var(--color-v2-border)] pt-2 sm:mt-4 sm:pt-3">
        {/* Critérios nos 5 eixos (exibidos a partir de sm:) */}
        <div
          class="hidden sm:grid grid-cols-5 gap-1 text-center font-[family-name:var(--font-v2-mono)]"
          aria-label="Notas nos 5 critérios: Mecânica, Enredo, Estética, Retenção e Feeling"
        >
          {miniAxes.map((axis) => (
            <div class="border border-white/[0.04] bg-[var(--color-v2-bg)]/70 py-1">
              <span class="block text-[8px] tracking-[0.12em] text-[var(--color-v2-muted)]">
                {axis.key}
              </span>
              <span class="mt-0.5 block text-[11px] text-[var(--color-v2-text)]">
                {axis.val !== null && axis.val !== undefined ? axis.val : '—'}
              </span>
            </div>
          ))}
        </div>

        <div class="flex items-center justify-between font-[family-name:var(--font-v2-mono)] text-[9px] tracking-[0.1em] text-[var(--color-v2-muted)] uppercase transition-colors group-hover:text-[var(--color-v2-heading)] sm:mt-3 sm:text-[10px] sm:tracking-[0.16em]">
          <span class="truncate">Ficha & avaliação</span>
          <span
            aria-hidden="true"
            class="shrink-0 text-[var(--color-v2-accent-warm)] transition-transform duration-200 group-hover:translate-x-1"
          >
            &rarr;
          </span>
        </div>
      </div>
    </div>
  </a>
</article>
