---
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';
import { calculateGameScore, formatScore } from '../../utils/ratings';
import { withBase } from '../../utils/base';

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { data, id } = game;

const finalScore = calculateGameScore(data.scores);
const formattedFinal = formatScore(finalScore);
const gameHref = withBase(`/jogos/${id}/`);

const statusConfig: Record<
  string,
  { label: string; badgeClass: string; dotClass?: string }
> = {
  Platinado: {
    label: 'Platinado',
    badgeClass: 'border-warm/50 bg-warm/15 text-warm',
  },
  Concluido: {
    label: 'Concluído',
    badgeClass: 'border-accent/40 bg-accent/15 text-accent',
  },
  Jogando: {
    label: 'Jogando',
    badgeClass: 'border-accent/60 bg-surface/90 text-accent font-semibold',
    dotClass: 'bg-accent animate-pulse',
  },
  Parado: {
    label: 'Parado',
    badgeClass: 'border-border/70 bg-surface-raised text-text-muted',
  },
  Descontinuado: {
    label: 'Descontinuado',
    badgeClass: 'border-border/60 bg-surface-raised text-text-muted/70',
  },
};

const currentStatus = statusConfig[data.status] || {
  label: data.status,
  badgeClass: 'border-border/60 bg-surface-raised text-text-muted',
};
---

<Card
  as="article"
  interactive
  class="flex flex-col justify-between border-border/80 bg-surface/90 p-0 overflow-hidden transition-all duration-300 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5 group"
>
  <a href={gameHref} class="flex flex-col h-full">
    {/* Capa em proporção vertical (pôster 3:4) */}
    <div class="relative aspect-[3/4] w-full overflow-hidden bg-surface-raised border-b border-border/60">
      <img
        src={data.coverImage.url}
        alt={data.coverImage.alt}
        width="600"
        height="800"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover filter contrast-110 brightness-90 transition duration-500 group-hover:scale-105 group-hover:brightness-100"
      />

      {/* Badges Flutuantes: Status e Plataforma */}
      <div class="absolute top-3 left-3 flex flex-col gap-1.5 items-start">
        <div
          class:list={[
            'inline-flex items-center gap-1.5 rounded border px-2 py-0.5 font-mono text-[10px] font-medium uppercase tracking-wider backdrop-blur-xs shadow-md',
            currentStatus.badgeClass,
          ]}
        >
          {currentStatus.dotClass && (
            <span
              class:list={['h-1.5 w-1.5 rounded-full', currentStatus.dotClass]}
            />
          )}
          <span>{currentStatus.label}</span>
        </div>

        {data.platform && (
          <span class="rounded border border-border/70 bg-surface/90 px-1.5 py-0.5 font-mono text-[10px] text-text-muted backdrop-blur-xs shadow-xs">
            {data.platform}
          </span>
        )}
      </div>

      {/* Badge Flutuante da Nota Final */}
      <div class="absolute top-3 right-3 rounded-md border border-accent/40 bg-surface/90 px-2.5 py-1 backdrop-blur-xs shadow-md">
        <span class="font-mono text-[10px] text-text-muted mr-1">SCORE:</span>
        <span class="font-display text-sm font-extrabold text-accent drop-shadow-[0_0_6px_var(--color-accent)]">
          {formattedFinal}
        </span>
      </div>

      {data.coverImage.isPlaceholder && (
        <div class="absolute bottom-3 left-3 rounded border border-border/50 bg-surface/85 px-2 py-0.5 font-mono text-[9px] text-text-muted/80 backdrop-blur-xs">
          Capa Provisória
        </div>
      )}

      {data.isDemo && (
        <div class="absolute bottom-3 right-3 rounded bg-warm/90 px-2 py-0.5 font-mono text-[10px] font-semibold text-bg uppercase">
          Mock Data
        </div>
      )}
    </div>

    {/* Conteúdo textual */}
    <div class="p-5 flex-1 flex flex-col justify-between">
      <div>
        <div class="mb-2 flex items-center justify-between font-mono text-xs text-text-muted">
          <span class="text-accent/90">{data.genre}</span>
          <span>{data.releaseYear}</span>
        </div>

        <h3 class="font-display text-lg font-bold tracking-tight text-text group-hover:text-accent transition-colors">
          {data.title}
        </h3>

        {data.developer && (
          <p class="font-mono text-xs text-text-muted mt-1">{data.developer}</p>
        )}

        {data.description && (
          <p class="font-body mt-2 text-xs leading-relaxed text-text-muted line-clamp-2">
            {data.description}
          </p>
        )}
      </div>

      <div class="mt-4 pt-3 border-t border-border/40 flex items-center justify-between font-mono text-xs text-accent">
        <span>Ver análise completa</span>
        <span
          aria-hidden="true"
          class="transition-transform duration-200 group-hover:translate-x-1"
        >
          &rarr;
        </span>
      </div>
    </div>
  </a>
</Card>
