---
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';

interface Props {
  image: CollectionEntry<'gallery'>;
}

const { image } = Astro.props;
const { data } = image;

const dimText = data.dimensions
  ? `${data.dimensions.width}×${data.dimensions.height}`
  : '';
---

<Card
  as="article"
  class="flex flex-col justify-between border-border/80 bg-surface/90 p-0 overflow-hidden transition-all duration-300 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5 group"
>
  <div>
    {/* Imagem com Proporção Panorâmica 16:9 */}
    <div class="relative aspect-[16/9] w-full overflow-hidden bg-surface-raised border-b border-border/60">
      <img
        src={data.imageUrl}
        alt={data.title}
        width="800"
        height="450"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover filter contrast-105 brightness-95 transition duration-500 group-hover:scale-105 group-hover:brightness-100"
      />

      {/* Badges Flutuantes */}
      <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 items-center">
        <span class="rounded border border-accent/40 bg-surface/90 px-2 py-0.5 font-mono text-[10px] font-semibold text-accent uppercase tracking-wider backdrop-blur-xs shadow-md">
          {data.album}
        </span>

        {dimText && (
          <span class="rounded border border-border/70 bg-surface/90 px-1.5 py-0.5 font-mono text-[10px] text-text-muted backdrop-blur-xs">
            {dimText}
          </span>
        )}
      </div>

      {data.isDemo && (
        <div class="absolute bottom-3 right-3 rounded bg-warm/90 px-2 py-0.5 font-mono text-[10px] font-semibold text-bg uppercase shadow-md">
          Mock Data
        </div>
      )}
    </div>

    {/* Informações da Imagem */}
    <div class="p-5">
      <h3 class="font-display text-lg font-bold tracking-tight text-text group-hover:text-accent transition-colors">
        {data.title}
      </h3>

      <p class="font-body mt-2 text-sm leading-relaxed text-text-muted">
        {data.description}
      </p>

      <div class="mt-4 pt-3 border-t border-border/40 font-mono text-[11px] text-text-muted/80 space-y-1">
        <div>
          <strong class="text-text-muted">Créditos:</strong> {data.credit}
        </div>
        <div>
          <strong class="text-text-muted">Licença:</strong> {data.license}
        </div>
      </div>
    </div>
  </div>

  {/* Ação de Ampliar Acessível */}
  <div class="p-5 pt-0">
    <button
      type="button"
      data-gallery-trigger
      data-image-url={data.imageUrl}
      data-title={data.title}
      data-desc={data.description}
      data-album={data.album}
      data-dim={dimText}
      data-credit={data.credit}
      data-license={data.license}
      class="w-full inline-flex items-center justify-center gap-2 rounded border border-border/80 bg-surface-raised/80 py-2 px-3 font-mono text-xs font-semibold text-accent hover:border-accent hover:bg-surface-raised focus-visible:outline-accent transition-colors"
    >
      <span>Visualizar ampliado</span>
      <span aria-hidden="true">&plus;</span>
    </button>
  </div>
</Card>
