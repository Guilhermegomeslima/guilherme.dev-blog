---
import {
  calculateGameScore,
  calculateMovieScore,
  formatScore,
  type GameScores,
  type MovieScores,
} from '../../utils/ratings';

interface Props {
  scores: GameScores | MovieScores;
  type?: 'game' | 'movie';
  class?: string;
}

const { scores, type = 'game', class: className } = Astro.props;

const isMovie = type === 'movie' || 'direction' in scores;

const finalScore = isMovie
  ? calculateMovieScore(scores as MovieScores)
  : calculateGameScore(scores as GameScores);
const formattedFinal = formatScore(finalScore);

const criteriaList = isMovie
  ? [
      {
        code: '01',
        label: 'Direção',
        description: 'Condução formal, mise-en-scène e coesão autoral',
        score: (scores as MovieScores).direction,
      },
      {
        code: '02',
        label: 'Roteiro',
        description: 'Estrutura dramática, diálogos e desenvolvimento temático',
        score: (scores as MovieScores).screenplay,
      },
      {
        code: '03',
        label: 'Audiovisual',
        description: 'Fotografia, direção de arte, desenho de som e trilha',
        score: (scores as MovieScores).audiovisual,
      },
      {
        code: '04',
        label: 'Atuação',
        description: 'Presença cênica, entrega dramática e verossimilhança',
        score: (scores as MovieScores).acting,
      },
      {
        code: '05',
        label: 'Ritmo',
        description: 'Montagem, cadência narrativa e sustentação do interesse',
        score: (scores as MovieScores).pacing,
      },
      {
        code: '06',
        label: 'Feeling',
        description: 'Ressonância subjetiva, impacto pessoal e permanência',
        score: (scores as MovieScores).feeling,
      },
    ]
  : [
      {
        code: '01',
        label: 'Mecânica',
        description:
          'Sistemas de jogo, controles, resposta e desenho de desafios',
        score: (scores as GameScores).mechanics,
      },
      {
        code: '02',
        label: 'Enredo',
        description: 'Construção de mundo, narrativa, personagens e escrita',
        score: (scores as GameScores).plot,
      },
      {
        code: '03',
        label: 'Estética',
        description: 'Direção de arte, atmosfera visual, trilha sonora e áudio',
        score: (scores as GameScores).aesthetics,
      },
      {
        code: '04',
        label: 'Retenção',
        description: 'Ritmo de progressão, engajamento e fator de revisitação',
        score: (scores as GameScores).retention,
      },
      {
        code: '05',
        label: 'Feeling',
        description:
          'Impacto subjetivo, identidade e memória afetiva da experiência',
        score: (scores as GameScores).feeling,
      },
    ];

const validCount = criteriaList.filter(
  (c) => c.score !== null && c.score !== undefined,
).length;
const hasNullCriterion = criteriaList.some(
  (c) => c.score === null || c.score === undefined,
);
const subtitle = isMovie
  ? 'Métricas Cinematográficas'
  : 'Métricas de Desempenho';
const equalWeightLabel =
  validCount > 0 ? `${Math.round((100 / validCount) * 10) / 10}% por eixo` : '';
---

<section
  aria-label={subtitle}
  class:list={[
    'relative border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/85 p-6 sm:p-8',
    className,
  ]}
>
  {/* Cantoneiras discretas em bronze */}
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-px -left-px h-3 w-3 border-t border-l border-[var(--color-v2-accent-warm)]/60"
  ></span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-px -right-px h-3 w-3 border-t border-r border-[var(--color-v2-accent-warm)]/60"
  ></span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-px -left-px h-3 w-3 border-b border-l border-[var(--color-v2-accent-warm)]/60"
  ></span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-px -right-px h-3 w-3 border-b border-r border-[var(--color-v2-accent-warm)]/60"
  ></span>

  {/* Cabeçalho do Painel */}
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4 border-b border-[var(--color-v2-border)] pb-5">
    <div>
      <div class="mb-2 flex items-center gap-2.5">
        <span
          aria-hidden="true"
          class="inline-block h-1.5 w-1.5 bg-[var(--color-v2-accent)]"
        ></span>
        <span class="font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.2em] text-[var(--color-v2-accent-warm)] uppercase">
          AVALIAÇÃO TÉCNICA // {criteriaList.length} DIMENSÕES
        </span>
      </div>
      <h2 class="font-[family-name:var(--font-v2-display)] text-2xl font-normal tracking-[-0.01em] text-[var(--color-v2-heading)] sm:text-3xl">
        {subtitle}
      </h2>
    </div>

    {/* Placa da Nota Final em Destaque */}
    <div class="flex items-baseline gap-3 border border-[var(--color-v2-accent-warm)]/35 bg-[var(--color-v2-bg)]/90 px-4 py-2.5">
      <span class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
        Média Final
      </span>
      <div class="flex items-baseline gap-1">
        <span class="font-[family-name:var(--font-v2-display)] text-3xl leading-none font-normal text-[var(--color-v2-heading)]">
          {formattedFinal}
        </span>
        <span class="font-[family-name:var(--font-v2-mono)] text-xs text-[var(--color-v2-accent-warm)]">
          / 100
        </span>
      </div>
    </div>
  </div>

  {/* Lista dos Critérios de Avaliação */}
  <div class="space-y-6">
    {criteriaList.map((crit) => (
      <div class="group/crit">
        <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
          <div class="flex items-baseline gap-3">
            <span class="font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.14em] text-[var(--color-v2-accent-warm)]">
              {crit.code}
            </span>
            <span class="font-[family-name:var(--font-v2-sans)] text-sm font-medium tracking-[0.02em] text-[var(--color-v2-heading)]">
              {crit.label}
            </span>
            <span class="hidden font-[family-name:var(--font-v2-sans)] text-xs font-light text-[var(--color-v2-muted)] sm:inline">
              — {crit.description}
            </span>
          </div>

          <div class="flex items-baseline gap-2 font-[family-name:var(--font-v2-mono)] text-xs">
            {crit.score !== null && crit.score !== undefined ? (
              <>
                <span class="text-sm font-normal text-[var(--color-v2-heading)]">
                  {crit.score}
                </span>
                <span class="text-[11px] text-[var(--color-v2-muted)]">
                  / 100
                </span>
              </>
            ) : (
              <span class="text-[11px] text-[var(--color-v2-muted)] italic">
                N/A (Não aplicável)
              </span>
            )}
          </div>
        </div>

        {/* Barra de Medição */}
        <div
          class="relative h-2 w-full overflow-hidden border border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]"
          role="progressbar"
          aria-valuenow={crit.score ?? 0}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label={
            crit.score !== null && crit.score !== undefined
              ? `Nota de ${crit.label}: ${crit.score} de 100`
              : `Nota de ${crit.label}: Não aplicável`
          }
        >
          {/* Marcações de escala (25%, 50%, 75%) */}
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-y-0 left-1/4 z-10 w-px bg-[var(--color-v2-border)]/75"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-y-0 left-2/4 z-10 w-px bg-[var(--color-v2-border-hover)]/85"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-y-0 left-3/4 z-10 w-px bg-[var(--color-v2-border)]/75"
          />

          {crit.score !== null && crit.score !== undefined ? (
            <div
              class="v2-rating-bar h-full transition-all duration-500"
              style={`width: ${crit.score}%;`}
            />
          ) : (
            <div class="h-full w-full bg-[var(--color-v2-border)]/25" />
          )}
        </div>
      </div>
    ))}
  </div>

  {/* Rodapé Metodológico */}
  <div class="mt-8 flex flex-wrap items-center justify-between gap-2 border-t border-[var(--color-v2-border)] pt-4 font-[family-name:var(--font-v2-mono)] text-[11px] text-[var(--color-v2-muted)]">
    <span>Pesos equivalentes ({equalWeightLabel})</span>
    <span>
      {hasNullCriterion
        ? `* Média aritmética simples sem pesos calculada a partir dos ${validCount} eixos aplicáveis (Enredo N/A).`
        : `* Média aritmética simples sem pesos calculada a partir dos ${validCount} eixos.`}
    </span>
  </div>
</section>
