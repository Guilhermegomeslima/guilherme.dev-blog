---
import Card from '../ui/Card.astro';
import {
  calculateGameScore,
  calculateMovieScore,
  formatScore,
  type GameScores,
  type MovieScores,
} from '../../utils/ratings';

interface Props {
  scores: GameScores | MovieScores;
  type?: 'game' | 'movie';
  class?: string;
}

const { scores, type = 'game', class: className } = Astro.props;

const isMovie = type === 'movie' || 'direction' in scores;

const finalScore = isMovie
  ? calculateMovieScore(scores as MovieScores)
  : calculateGameScore(scores as GameScores);
const formattedFinal = formatScore(finalScore);

const criteriaList = isMovie
  ? [
      { label: 'Direção', score: (scores as MovieScores).direction },
      { label: 'Roteiro', score: (scores as MovieScores).screenplay },
      { label: 'Audiovisual', score: (scores as MovieScores).audiovisual },
      { label: 'Atuação', score: (scores as MovieScores).acting },
      { label: 'Ritmo', score: (scores as MovieScores).pacing },
      { label: 'Feeling', score: (scores as MovieScores).feeling },
    ]
  : [
      { label: 'Mecânica', score: (scores as GameScores).mechanics },
      { label: 'Enredo', score: (scores as GameScores).plot },
      { label: 'Estética', score: (scores as GameScores).aesthetics },
      { label: 'Retenção', score: (scores as GameScores).retention },
      { label: 'Feeling', score: (scores as GameScores).feeling },
    ];

const validCount = criteriaList.filter(
  (c) => c.score !== null && c.score !== undefined,
).length;
const hasNullCriterion = criteriaList.some(
  (c) => c.score === null || c.score === undefined,
);
const subtitle = isMovie
  ? 'Métricas Cinematográficas'
  : 'Métricas de Desempenho';
---

<Card
  class:list={[
    'border-border/80 bg-surface/90 p-6 backdrop-blur-xs shadow-lg',
    className,
  ]}
>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-border/50 pb-4">
    <div>
      <span class="font-mono text-xs font-semibold text-accent uppercase tracking-wider">
        // AVALIAÇÃO TÉCNICA
      </span>
      <h3 class="font-display text-lg font-bold text-text mt-0.5">
        {subtitle}
      </h3>
    </div>

    {/* Placa da Nota Final em Destaque */}
    <div class="flex items-center gap-3 rounded-lg border border-accent/40 bg-surface-raised/80 px-4 py-2">
      <span class="font-mono text-xs text-text-muted uppercase">
        Nota Final:
      </span>
      <span class="font-display text-2xl font-extrabold text-accent drop-shadow-[0_0_8px_var(--color-accent)]">
        {formattedFinal}
      </span>
      <span class="font-mono text-xs text-text-muted/60">/ 100</span>
    </div>
  </div>

  {/* Gráfico de Barras dos Critérios */}
  <div class="space-y-4">
    {criteriaList.map((crit) => (
      <div>
        <div class="mb-1.5 flex items-center justify-between font-mono text-xs">
          <span class="text-text font-medium">{crit.label}</span>
          {crit.score !== null && crit.score !== undefined ? (
            <span class="text-accent">{crit.score} / 100</span>
          ) : (
            <span class="text-text-muted italic">N/A (Não aplicável)</span>
          )}
        </div>

        <div
          class="h-2 w-full overflow-hidden rounded-full bg-surface-raised border border-border/40"
          role="progressbar"
          aria-valuenow={crit.score ?? 0}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label={
            crit.score !== null && crit.score !== undefined
              ? `Nota de ${crit.label}: ${crit.score} de 100`
              : `Nota de ${crit.label}: Não aplicável`
          }
        >
          {crit.score !== null && crit.score !== undefined ? (
            <div
              class="h-full rounded-full bg-gradient-to-r from-accent/70 to-accent transition-all duration-500 shadow-[0_0_6px_var(--color-accent)]"
              style={`width: ${crit.score}%;`}
            />
          ) : (
            <div class="h-full w-full bg-border/20" />
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-6 border-t border-border/40 pt-3 text-right">
    <span class="font-mono text-[11px] text-text-muted/70">
      {hasNullCriterion
        ? `* Média aritmética simples sem pesos calculada a partir dos ${validCount} eixos aplicáveis (Enredo N/A).`
        : `* Média aritmética simples sem pesos calculada a partir dos ${validCount} eixos.`}
    </span>
  </div>
</Card>
