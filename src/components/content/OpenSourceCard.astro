---
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';

interface Props {
  tool: CollectionEntry<'opensource'>;
}

const { tool } = Astro.props;
const { data } = tool;

const statusConfig: Record<
  string,
  { label: string; badgeClass: string; dotClass: string }
> = {
  uso_atualmente: {
    label: 'Uso atualmente',
    badgeClass: 'border-accent/40 bg-accent/10 text-accent',
    dotClass: 'bg-accent animate-pulse',
  },
  recomendo: {
    label: 'Recomendo',
    badgeClass: 'border-warm/40 bg-warm/10 text-warm',
    dotClass: 'bg-warm',
  },
  ja_utilizei: {
    label: 'Já utilizei',
    badgeClass: 'border-border/70 bg-surface-raised text-text-muted',
    dotClass: 'bg-text-muted/60',
  },
};

const currentStatus = statusConfig[data.status] || {
  label: data.status,
  badgeClass: 'border-border/70 bg-surface-raised text-text-muted',
  dotClass: 'bg-text-muted',
};
---

<Card
  as="article"
  class="flex flex-col justify-between border-border/80 bg-surface/90 p-6 transition-all duration-300 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5 group"
>
  <div>
    {/* Cabeçalho com Categoria e Status */}
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2 border-b border-border/40 pb-3">
      <span class="font-mono text-[11px] font-semibold text-accent/90 uppercase tracking-wider">
        // {data.category}
      </span>

      <div
        class:list={[
          'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-mono text-[11px] font-medium',
          currentStatus.badgeClass,
        ]}
      >
        <span
          class:list={['h-1.5 w-1.5 rounded-full', currentStatus.dotClass]}
        ></span>
        <span>{currentStatus.label}</span>
      </div>
    </div>

    {/* Título e Licença */}
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-xl font-bold tracking-tight text-text group-hover:text-accent transition-colors">
        {data.name}
      </h3>

      {data.license && (
        <span class="rounded border border-border/80 bg-surface-raised px-1.5 py-0.5 font-mono text-[10px] text-text-muted">
          {data.license}
        </span>
      )}
    </div>

    {/* Descrição */}
    <p class="font-body mt-3 text-sm leading-relaxed text-text-muted">
      {data.description}
    </p>

    {/* Comentário editorial */}
    {data.comment && (
      <div class="mt-4 rounded border-l-2 border-accent/60 bg-surface-raised/40 p-3 font-body text-xs italic text-text-muted">
        "{data.comment}"
      </div>
    )}
  </div>

  {/* Rodapé com links e aviso de mock */}
  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-border/40 font-mono text-xs">
    <div class="flex items-center gap-4">
      {data.websiteUrl && (
        <a
          href={data.websiteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:underline flex items-center gap-1 font-medium"
        >
          <span>Site oficial</span>
          <span aria-hidden="true">&nearr;</span>
        </a>
      )}

      {data.repoUrl && (
        <a
          href={data.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-text flex items-center gap-1"
        >
          <span>Repositório</span>
          <span aria-hidden="true">&nearr;</span>
        </a>
      )}
    </div>

    {data.isDemo && (
      <span class="rounded bg-warm/90 px-2 py-0.5 text-[10px] font-semibold text-bg uppercase">
        Mock Data
      </span>
    )}
  </div>
</Card>
