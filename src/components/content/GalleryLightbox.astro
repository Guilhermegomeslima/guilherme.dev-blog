---
---

<dialog
  id="gallery-lightbox"
  aria-labelledby="lightbox-title"
  aria-describedby="lightbox-description"
  class="m-auto w-[92vw] max-w-5xl rounded-xl border border-border/80 bg-surface/95 p-0 text-text backdrop:bg-bg/85 backdrop:backdrop-blur-md shadow-2xl overflow-hidden open:flex open:flex-col"
>
  <div class="relative flex flex-col max-h-[90vh]">
    {/* Barra de Topo do Modal */}
    <div class="flex items-center justify-between border-b border-border/60 bg-surface-raised px-4 py-3">
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs text-accent uppercase tracking-wider">
          // VISUALIZADOR DE MÍDIA
        </span>
        <span class="text-border" aria-hidden="true">
          ·
        </span>
        <span id="lightbox-album" class="font-mono text-xs text-text-muted">
          Álbum
        </span>
      </div>

      <button
        type="button"
        id="lightbox-close-btn"
        aria-label="Fechar visualização ampliada"
        class="inline-flex min-h-8 min-w-8 items-center justify-center rounded border border-border/70 bg-surface px-2 py-1 font-mono text-xs text-text-muted hover:border-accent hover:text-accent focus-visible:outline-accent"
      >
        <span>Fechar [ESC]</span>
      </button>
    </div>

    {/* Imagem Ampliada */}
    <div class="relative flex-1 overflow-auto bg-black/60 p-2 sm:p-6 flex items-center justify-center min-h-[300px]">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-h-[65vh] w-auto max-w-full rounded border border-border/50 object-contain shadow-2xl"
      />
    </div>

    {/* Ficha Técnica e Metadados da Imagem */}
    <div class="border-t border-border/60 bg-surface p-4 sm:p-6 flex flex-col sm:flex-row sm:items-start justify-between gap-4 font-mono text-xs">
      <div class="space-y-1.5 flex-1">
        <h3
          id="lightbox-title"
          class="font-display text-lg font-bold text-text tracking-tight"
        ></h3>
        <p
          id="lightbox-description"
          class="font-body text-xs sm:text-sm text-text-muted leading-relaxed"
        ></p>
      </div>

      <div class="space-y-1 border-t sm:border-t-0 sm:border-l border-border/50 pt-3 sm:pt-0 sm:pl-6 text-[11px] text-text-muted/80 min-w-[200px]">
        <div id="lightbox-dimensions-row">
          <strong class="text-text-muted">Resolução:</strong>{' '}
          <span id="lightbox-dimensions" class="text-text"></span>
        </div>
        <div>
          <strong class="text-text-muted">Créditos:</strong>{' '}
          <span id="lightbox-credit" class="text-text"></span>
        </div>
        <div>
          <strong class="text-text-muted">Licença:</strong>{' '}
          <span id="lightbox-license" class="text-text"></span>
        </div>
        <div class="pt-1">
          <span class="inline-block rounded bg-warm/20 text-warm border border-warm/40 px-1.5 py-0.5 text-[10px] uppercase font-semibold">
            Amostra Demonstrativa
          </span>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  function setupLightbox() {
    const dialog = document.getElementById(
      'gallery-lightbox',
    ) as HTMLDialogElement | null;
    const closeBtn = document.getElementById('lightbox-close-btn');
    const imgElem = document.getElementById(
      'lightbox-img',
    ) as HTMLImageElement | null;
    const titleElem = document.getElementById('lightbox-title');
    const descElem = document.getElementById('lightbox-description');
    const albumElem = document.getElementById('lightbox-album');
    const dimElem = document.getElementById('lightbox-dimensions');
    const creditElem = document.getElementById('lightbox-credit');
    const licenseElem = document.getElementById('lightbox-license');

    if (!dialog) return;

    // Abrir lightbox nos botões
    const triggers = document.querySelectorAll('[data-gallery-trigger]');
    triggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-image-url') || '';
        const title = btn.getAttribute('data-title') || '';
        const desc = btn.getAttribute('data-desc') || '';
        const album = btn.getAttribute('data-album') || '';
        const dim = btn.getAttribute('data-dim') || '';
        const credit = btn.getAttribute('data-credit') || '';
        const license = btn.getAttribute('data-license') || '';

        if (imgElem) {
          imgElem.src = url;
          imgElem.alt = title;
        }
        if (titleElem) titleElem.textContent = title;
        if (descElem) descElem.textContent = desc;
        if (albumElem) albumElem.textContent = album;
        if (dimElem) dimElem.textContent = dim || 'N/A';
        if (creditElem) creditElem.textContent = credit;
        if (licenseElem) licenseElem.textContent = license;

        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => {
      dialog.close();
    });

    // Fechar ao clicar no backdrop fora do dialog
    dialog.addEventListener('click', (event) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog =
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width;
      if (!isInDialog) {
        dialog.close();
      }
    });
  }

  // Executa no load e após trocas de página
  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
