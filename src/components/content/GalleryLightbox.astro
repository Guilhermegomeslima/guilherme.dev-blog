---
---

<dialog
  id="gallery-lightbox"
  aria-labelledby="lightbox-title"
  aria-describedby="lightbox-description"
  class="m-auto w-[95vw] max-w-6xl overflow-hidden border border-[var(--color-v2-border-hover)] bg-[#070709]/98 p-0 text-[var(--color-v2-text)] shadow-[0_32px_90px_rgba(0,0,0,0.9)] backdrop:bg-black/90 backdrop:backdrop-blur-md open:flex open:flex-col"
>
  <div class="relative flex max-h-[94vh] flex-col">
    {/* Cantoneiras em bronze */}
    <span
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-0 z-30 h-4 w-4 border-t border-l border-[var(--color-v2-accent-warm)]"
    ></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute top-0 right-0 z-30 h-4 w-4 border-t border-r border-[var(--color-v2-accent-warm)]"
    ></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute bottom-0 left-0 z-30 h-4 w-4 border-b border-l border-[var(--color-v2-accent-warm)]"
    ></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute right-0 bottom-0 z-30 h-4 w-4 border-r border-b border-[var(--color-v2-accent-warm)]"
    ></span>

    {/* Barra de Topo do Modal */}
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--color-v2-border)] bg-[var(--color-v2-surface)] px-4 py-3 sm:px-6">
      <div class="flex flex-wrap items-center gap-2 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.16em] uppercase">
        <span class="text-[var(--color-v2-accent-warm)]">
          // VISUALIZADOR DE MÍDIA
        </span>
        <span class="text-[var(--color-v2-border-hover)]" aria-hidden="true">
          ·
        </span>
        <span id="lightbox-album" class="text-[var(--color-v2-text)]">
          Álbum
        </span>
        <span class="text-[var(--color-v2-border-hover)]" aria-hidden="true">
          ·
        </span>
        <span id="lightbox-counter" class="text-[var(--color-v2-accent-warm)]">
          1 / 1
        </span>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          id="lightbox-original-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="v2-focus inline-flex items-center gap-1.5 border border-[var(--color-v2-accent-warm)]/45 bg-[var(--color-v2-bg)] px-3 py-1.5 font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.16em] text-[var(--color-v2-accent-warm)] uppercase transition-colors hover:border-[var(--color-v2-accent-warm)] hover:text-[var(--color-v2-heading)]"
        >
          <span>Abrir original</span>
          <span aria-hidden="true">&nearr;</span>
        </a>

        <button
          type="button"
          id="lightbox-close-btn"
          aria-label="Fechar visualização ampliada"
          class="v2-focus inline-flex min-h-8 min-w-8 cursor-pointer items-center justify-center border border-[var(--color-v2-border-hover)] bg-[var(--color-v2-bg)] px-3 py-1.5 font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.16em] text-[var(--color-v2-muted)] uppercase transition-colors hover:border-[var(--color-v2-accent-warm)]/60 hover:text-[var(--color-v2-heading)]"
        >
          <span>Fechar [ESC]</span>
        </button>
      </div>
    </div>

    {/* Palco de Exibição da Fotografia Ampliada (sem cortes nem distorções) */}
    <div class="relative flex min-h-[280px] flex-1 items-center justify-center overflow-hidden bg-[#040406] p-3 sm:min-h-[420px] sm:p-8">
      {/* Botão Anterior */}
      <button
        type="button"
        id="lightbox-prev-btn"
        aria-label="Imagem anterior"
        class="v2-focus absolute left-2 z-20 flex h-10 w-10 cursor-pointer items-center justify-center border border-[var(--color-v2-border-hover)] bg-[#070709]/90 font-[family-name:var(--font-v2-mono)] text-base text-[var(--color-v2-heading)] backdrop-blur-xs transition-colors hover:border-[var(--color-v2-accent-warm)] hover:text-[var(--color-v2-accent-warm)] sm:left-5 sm:h-11 sm:w-11"
      >
        <span aria-hidden="true">&larr;</span>
      </button>

      {/* Imagem Ampliada */}
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-h-[65vh] w-auto max-w-full border border-[var(--color-v2-border)] object-contain shadow-[0_24px_60px_rgba(0,0,0,0.85)]"
      />

      {/* Botão Próximo */}
      <button
        type="button"
        id="lightbox-next-btn"
        aria-label="Próxima imagem"
        class="v2-focus absolute right-2 z-20 flex h-10 w-10 cursor-pointer items-center justify-center border border-[var(--color-v2-border-hover)] bg-[#070709]/90 font-[family-name:var(--font-v2-mono)] text-base text-[var(--color-v2-heading)] backdrop-blur-xs transition-colors hover:border-[var(--color-v2-accent-warm)] hover:text-[var(--color-v2-accent-warm)] sm:right-5 sm:h-11 sm:w-11"
      >
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    {/* Ficha Técnica e Metadados da Imagem */}
    <div class="flex flex-col justify-between gap-4 border-t border-[var(--color-v2-border)] bg-[var(--color-v2-surface)] p-4 sm:flex-row sm:items-start sm:px-6 sm:py-5">
      <div class="flex-1 space-y-1.5">
        <h2
          id="lightbox-title"
          class="font-[family-name:var(--font-v2-display)] text-2xl font-normal tracking-[-0.01em] text-[var(--color-v2-heading)]"
        >
          Visualização ampliada
        </h2>
        <p
          id="lightbox-description"
          class="font-[family-name:var(--font-v2-sans)] text-xs leading-relaxed font-light text-[var(--color-v2-muted)] sm:text-sm"
        ></p>
      </div>

      <div class="min-w-[220px] space-y-1.5 border-t border-[var(--color-v2-border)] pt-3 font-[family-name:var(--font-v2-mono)] text-[11px] text-[var(--color-v2-muted)] sm:border-t-0 sm:border-l sm:pt-0 sm:pl-6">
        <div id="lightbox-dimensions-row">
          <strong class="font-normal tracking-[0.14em] text-[var(--color-v2-accent-warm)] uppercase">
            Resolução:
          </strong>{' '}
          <span
            id="lightbox-dimensions"
            class="text-[var(--color-v2-heading)]"
          ></span>
        </div>
        <div id="lightbox-credit-row">
          <strong class="font-normal tracking-[0.14em] text-[var(--color-v2-muted)] uppercase">
            Créditos:
          </strong>{' '}
          <span id="lightbox-credit" class="text-[var(--color-v2-text)]"></span>
        </div>
        <div id="lightbox-license-row">
          <strong class="font-normal tracking-[0.14em] text-[var(--color-v2-muted)] uppercase">
            Licença:
          </strong>{' '}
          <span
            id="lightbox-license"
            class="text-[var(--color-v2-text)]"
          ></span>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  function setupLightbox() {
    const dialog = document.getElementById(
      'gallery-lightbox',
    ) as HTMLDialogElement | null;
    const closeBtn = document.getElementById('lightbox-close-btn');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');
    const imgElem = document.getElementById(
      'lightbox-img',
    ) as HTMLImageElement | null;
    const titleElem = document.getElementById('lightbox-title');
    const descElem = document.getElementById('lightbox-description');
    const albumElem = document.getElementById('lightbox-album');
    const counterElem = document.getElementById('lightbox-counter');
    const dimElem = document.getElementById('lightbox-dimensions');
    const creditElem = document.getElementById('lightbox-credit');
    const licenseElem = document.getElementById('lightbox-license');
    const creditRow = document.getElementById('lightbox-credit-row');
    const licenseRow = document.getElementById('lightbox-license-row');
    const originalLink = document.getElementById(
      'lightbox-original-link',
    ) as HTMLAnchorElement | null;

    if (!dialog) return;

    let triggers: HTMLElement[] = [];
    let currentIndex = 0;

    function getActiveTriggers(): HTMLElement[] {
      const all = Array.from(
        document.querySelectorAll<HTMLElement>('[data-gallery-trigger]'),
      );
      const visible = all.filter((btn) => {
        const card = btn.closest<HTMLElement>('[data-gallery-card]');
        return !card || !card.hidden;
      });
      return visible.length > 0 ? visible : all;
    }

    function renderItem(index: number) {
      triggers = getActiveTriggers();
      if (index < 0 || index >= triggers.length) return;
      currentIndex = index;
      const btn = triggers[currentIndex];

      const url = btn.getAttribute('data-image-url') || '';
      const originalUrl = btn.getAttribute('data-original-url') || url;
      const title = btn.getAttribute('data-title') || '';
      const desc = btn.getAttribute('data-desc') || '';
      const album = btn.getAttribute('data-album') || '';
      const dim = btn.getAttribute('data-dim') || '';
      const credit = btn.getAttribute('data-credit') || '';
      const license = btn.getAttribute('data-license') || '';

      if (imgElem) {
        imgElem.src = url;
        imgElem.alt = title;
      }
      if (titleElem) titleElem.textContent = title;
      if (descElem) {
        descElem.textContent = desc;
        descElem.style.display = desc ? 'block' : 'none';
      }
      if (albumElem) albumElem.textContent = album;
      if (counterElem) {
        counterElem.textContent = `${currentIndex + 1} / ${triggers.length}`;
      }
      if (dimElem) dimElem.textContent = dim || 'N/A';

      if (creditRow && creditElem) {
        if (credit) {
          creditElem.textContent = credit;
          creditRow.style.display = 'block';
        } else {
          creditRow.style.display = 'none';
        }
      }

      if (licenseRow && licenseElem) {
        if (license) {
          licenseElem.textContent = license;
          licenseRow.style.display = 'block';
        } else {
          licenseRow.style.display = 'none';
        }
      }

      if (originalLink) {
        originalLink.href = originalUrl;
      }
    }

    function showPrev() {
      triggers = getActiveTriggers();
      if (triggers.length === 0) return;
      const newIndex = (currentIndex - 1 + triggers.length) % triggers.length;
      renderItem(newIndex);
    }

    function showNext() {
      triggers = getActiveTriggers();
      if (triggers.length === 0) return;
      const newIndex = (currentIndex + 1) % triggers.length;
      renderItem(newIndex);
    }

    const allTriggers = Array.from(
      document.querySelectorAll<HTMLElement>('[data-gallery-trigger]'),
    );

    allTriggers.forEach((btn) => {
      const openFromTrigger = () => {
        triggers = getActiveTriggers();
        const idx = triggers.indexOf(btn);
        renderItem(idx !== -1 ? idx : 0);
        dialog.showModal();
      };

      btn.onclick = openFromTrigger;

      // Permite clicar também sobre a moldura da imagem no card para abrir o lightbox
      const card = btn.closest<HTMLElement>('[data-gallery-card]');
      const imgInCard = card?.querySelector<HTMLElement>(
        'img:not([aria-hidden="true"])',
      );
      if (imgInCard) {
        imgInCard.style.cursor = 'zoom-in';
        imgInCard.onclick = openFromTrigger;
      }
    });

    closeBtn?.addEventListener('click', () => {
      dialog.close();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showPrev();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showNext();
    });

    // Navegação via teclado
    dialog.onkeydown = (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showPrev();
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        showNext();
      }
    };

    // Fechar ao clicar no backdrop fora do dialog
    dialog.onclick = (event) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog =
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width;
      if (!isInDialog) {
        dialog.close();
      }
    };
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
