---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/base';

interface Props {
  book: CollectionEntry<'books'>;
  index?: number;
}

const { book, index = 0 } = Astro.props;
const { data, id } = book;

const statusConfig: Record<
  string,
  { label: string; badgeClass: string; dotClass?: string }
> = {
  lendo: {
    label: 'Lendo agora',
    badgeClass:
      'border-[var(--color-v2-accent)]/65 bg-[var(--color-v2-accent)]/12 text-[#e47986]',
    dotClass: 'bg-[var(--color-v2-accent)] animate-pulse',
  },
  lido: {
    label: 'Leitura concluída',
    badgeClass:
      'border-[var(--color-v2-accent-warm)]/45 bg-[var(--color-v2-bg)]/80 text-[var(--color-v2-heading)]',
  },
  quero_ler: {
    label: 'Fila de leitura',
    badgeClass:
      'border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]/70 text-[var(--color-v2-muted)]',
  },
};

const currentStatus = statusConfig[data.status] || {
  label: data.status,
  badgeClass:
    'border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]/70 text-[var(--color-v2-muted)]',
};

const bookHref = withBase(`/livros/${id}/`);
---

<article
  data-book-card
  data-title={data.title.toLowerCase()}
  data-author={data.author.toLowerCase()}
  data-genre={data.genre.toLowerCase()}
  data-status={data.status}
  data-favorite={data.favorite ? 'true' : 'false'}
  class="group relative min-w-0 border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/75 transition-all duration-300 hover:-translate-y-0.5 hover:border-[var(--color-v2-border-hover)] hover:shadow-[0_18px_45px_rgba(0,0,0,0.65)]"
>
  <a
    href={bookHref}
    class="v2-focus grid h-full min-w-0 grid-cols-[96px_minmax(0,1fr)] gap-3.5 p-3.5 sm:grid-cols-[128px_minmax(0,1fr)] sm:gap-5 sm:p-5"
    aria-label={`${data.title}, por ${data.author} — ${currentStatus.label}`}
  >
    {/* Capa do Volume (2:3) com vinco de lombada sutil */}
    <div class="relative aspect-[2/3] w-full self-start overflow-hidden border border-[var(--color-v2-border)] bg-[#050508] shadow-[0_10px_24px_rgba(0,0,0,0.55)]">
      {data.coverImage ? (
        <img
          src={withBase(data.coverImage.url)}
          alt={data.coverImage.alt}
          width="600"
          height="900"
          loading={index < 6 ? 'eager' : 'lazy'}
          decoding="async"
          class="h-full w-full object-cover brightness-95 contrast-105 transition-transform duration-500 ease-out group-hover:scale-[1.03] group-hover:brightness-100"
        />
      ) : (
        <div class="flex h-full w-full flex-col justify-between bg-[#070709] p-3 text-left select-none">
          <span class="font-[family-name:var(--font-v2-mono)] text-[8px] tracking-[0.16em] text-[var(--color-v2-accent-warm)] uppercase">
            // TOMO
          </span>
          <p class="font-[family-name:var(--font-v2-display)] text-sm leading-snug text-[var(--color-v2-heading)]">
            {data.title}
          </p>
          <span class="font-[family-name:var(--font-v2-mono)] text-[8px] text-[var(--color-v2-muted)]">
            {data.author}
          </span>
        </div>
      )}

      {/* Sombra interna simulando vinco de encadernação */}
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-y-0 left-0 w-3 bg-gradient-to-r from-black/55 via-white/[0.04] to-transparent"
      ></div>
    </div>

    {/* Ficha Bibliográfica */}
    <div class="flex min-w-0 flex-col justify-between">
      <div class="min-w-0">
        {/* Linha de Status e Favorito */}
        <div class="mb-2 flex flex-wrap items-center gap-1.5 sm:mb-2.5 sm:gap-2">
          <div
            class:list={[
              'inline-flex items-center gap-1.5 border px-1.5 py-0.5 font-[family-name:var(--font-v2-mono)] text-[9px] tracking-[0.1em] uppercase sm:px-2 sm:tracking-[0.14em]',
              currentStatus.badgeClass,
            ]}
          >
            {currentStatus.dotClass && (
              <span
                class:list={[
                  'h-1.5 w-1.5 shrink-0 rounded-full',
                  currentStatus.dotClass,
                ]}
              />
            )}
            <span>{currentStatus.label}</span>
          </div>

          {data.favorite && (
            <span class="inline-flex items-center gap-1 border border-[var(--color-v2-accent-warm)]/55 bg-[var(--color-v2-accent-warm)]/12 px-1.5 py-0.5 font-[family-name:var(--font-v2-mono)] text-[9px] tracking-[0.1em] text-[var(--color-v2-accent-warm)] uppercase sm:px-2 sm:tracking-[0.14em]">
              <span aria-hidden="true">★</span>
              <span>Favorito</span>
            </span>
          )}
        </div>

        {/* Gênero e Ano */}
        <div class="mb-1 flex flex-wrap items-baseline justify-between gap-x-2 gap-y-0.5 font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.1em] text-[var(--color-v2-accent-warm)]/85 uppercase sm:tracking-[0.14em]">
          <span class="min-w-0 break-words">{data.genre}</span>
          {data.year && (
            <span class="shrink-0 text-[var(--color-v2-muted)]">
              {data.year}
            </span>
          )}
        </div>

        {/* Título e Autor */}
        <h3 class="font-[family-name:var(--font-v2-display)] text-xl leading-[1.15] font-normal tracking-[-0.01em] text-[var(--color-v2-heading)] transition-colors duration-200 group-hover:text-[var(--color-v2-accent-warm)] break-words sm:text-2xl">
          {data.title}
        </h3>

        <p class="mt-1 font-[family-name:var(--font-v2-sans)] text-xs font-light text-[var(--color-v2-muted)] break-words">
          Por <span class="text-[var(--color-v2-text)]">{data.author}</span>
        </p>

        {data.description && (
          <p class="mt-2 line-clamp-2 font-[family-name:var(--font-v2-sans)] text-xs leading-relaxed font-light text-[var(--color-v2-muted)] break-words sm:mt-2.5">
            {data.description}
          </p>
        )}

        {data.comment && !data.description && (
          <p class="mt-2 line-clamp-2 font-[family-name:var(--font-v2-display)] text-sm leading-relaxed text-[var(--color-v2-text)] italic break-words sm:mt-2.5">
            "{data.comment}"
          </p>
        )}
      </div>

      {/* Rodapé da Ficha */}
      <div class="mt-3.5 flex items-center justify-between gap-2 border-t border-[var(--color-v2-border)] pt-2 font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.12em] text-[var(--color-v2-muted)] uppercase transition-colors group-hover:text-[var(--color-v2-heading)] sm:mt-4 sm:pt-2.5 sm:tracking-[0.16em]">
        <span class="truncate">Ficha de leitura</span>

        <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
          {data.isDemo && (
            <span class="border border-[var(--color-v2-accent-warm)]/50 px-1.5 py-0.5 text-[9px] text-[var(--color-v2-accent-warm)]">
              Mock
            </span>
          )}
          <span
            aria-hidden="true"
            class="text-[var(--color-v2-accent-warm)] transition-transform duration-200 group-hover:translate-x-1"
          >
            &rarr;
          </span>
        </div>
      </div>
    </div>
  </a>
</article>
