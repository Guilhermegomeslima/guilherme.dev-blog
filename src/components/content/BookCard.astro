---
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';
import { withBase } from '../../utils/base';

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { data, id } = book;

const statusConfig: Record<
  string,
  { label: string; badgeClass: string; dotClass?: string }
> = {
  lendo: {
    label: 'Lendo',
    badgeClass: 'border-accent/40 bg-surface/90 text-accent',
    dotClass: 'bg-accent animate-pulse',
  },
  lido: {
    label: 'Lido',
    badgeClass: 'border-border/80 bg-surface/90 text-text font-semibold',
  },
  quero_ler: {
    label: 'Quero ler',
    badgeClass: 'border-border/60 bg-surface/90 text-text-muted',
  },
};

const currentStatus = statusConfig[data.status] || {
  label: data.status,
  badgeClass: 'border-border/60 bg-surface/90 text-text-muted',
};

const bookHref = withBase(`/livros/${id}/`);
---

<Card
  as="article"
  interactive
  class="flex flex-col justify-between border-border/80 bg-surface/90 p-0 overflow-hidden transition-all duration-300 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5 group"
>
  <a href={bookHref} class="flex flex-col h-full">
    {/* Capa com proporção de livro (2:3) */}
    <div class="relative aspect-[2/3] w-full overflow-hidden bg-surface-raised border-b border-border/60">
      {data.coverImage ? (
        <img
          src={data.coverImage.url}
          alt={data.coverImage.alt}
          width="600"
          height="900"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover filter contrast-105 brightness-95 transition duration-500 group-hover:scale-105 group-hover:brightness-100"
        />
      ) : (
        <div class="flex h-full w-full flex-col justify-between p-6 bg-gradient-to-br from-surface to-surface-raised border-r border-border/40">
          <span class="font-mono text-[10px] text-accent uppercase tracking-widest">
            // TOMO BIBLIOGRÁFICO
          </span>
          <div>
            <p class="font-display text-lg font-bold text-text leading-tight">
              {data.title}
            </p>
            <p class="font-mono text-xs text-text-muted mt-2">{data.author}</p>
          </div>
          <span class="font-mono text-[10px] text-text-muted/60">
            {data.genre}
          </span>
        </div>
      )}

      {/* Badges Flutuantes: Status e Favorito */}
      <div class="absolute top-3 left-3 flex flex-col gap-1.5 items-start">
        <div
          class:list={[
            'inline-flex items-center gap-1.5 rounded border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider backdrop-blur-xs shadow-md',
            currentStatus.badgeClass,
          ]}
        >
          {currentStatus.dotClass && (
            <span
              class:list={['h-1.5 w-1.5 rounded-full', currentStatus.dotClass]}
            />
          )}
          <span>{currentStatus.label}</span>
        </div>

        {data.favorite && (
          <div class="rounded border border-warm/40 bg-warm/90 px-2 py-0.5 font-mono text-[10px] font-bold text-bg uppercase tracking-wider shadow-md">
            ★ Favorito
          </div>
        )}
      </div>

      {data.isDemo && (
        <div class="absolute bottom-3 right-3 rounded bg-warm/90 px-2 py-0.5 font-mono text-[10px] font-semibold text-bg uppercase shadow-md">
          Mock Data
        </div>
      )}
    </div>

    {/* Informações textuais do Livro */}
    <div class="p-5 flex-1 flex flex-col justify-between">
      <div>
        <div class="mb-2 flex items-center justify-between font-mono text-xs text-text-muted">
          <span class="text-accent/90">{data.genre}</span>
          {data.year && <span>{data.year}</span>}
        </div>

        <h3 class="font-display text-lg font-bold tracking-tight text-text group-hover:text-accent transition-colors">
          {data.title}
        </h3>

        <p class="font-mono text-xs text-text-muted mt-1">Por {data.author}</p>

        <p class="font-body mt-3 text-sm leading-relaxed text-text-muted line-clamp-2">
          {data.description}
        </p>
      </div>

      <div class="mt-4 pt-3 border-t border-border/40 flex items-center justify-between font-mono text-xs">
        <span class="text-accent group-hover:underline flex items-center gap-1 font-semibold">
          Ficha e notas de leitura <span aria-hidden="true">&rarr;</span>
        </span>
      </div>
    </div>
  </a>
</Card>
