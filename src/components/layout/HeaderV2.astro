---
/**
 * Header global do Design System 2.0 (docs/DESIGN_SYSTEM_V2.md §3).
 * Consolidado em VIS-06h como cabeçalho único do site.
 */
import { navigation } from '../../data/navigation';
import { withBase } from '../../utils/base';
import { LIGHT_THEME_ENABLED } from '../../utils/theme';
import ThemeToggle from '../ui/ThemeToggle.astro';

// Ordem aprovada no protótipo; os links vêm da fonte única `navigation`.
const v2Order = [
  '/',
  '/sobre/',
  '/projetos/',
  '/linux/',
  '/jogos/',
  '/filmes/',
  '/musica/',
  '/livros/',
  '/artigos/',
  '/opensource/',
  '/galeria/',
];

const currentPath = Astro.url.pathname;
const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const available = navigation.filter((item) => item.available);
const items = [
  ...v2Order.flatMap((href) => available.filter((i) => i.href === href)),
  ...available.filter((i) => !v2Order.includes(i.href)),
];
---

<header
  class="border-v2-border/70 relative z-30 border-b bg-v2-bg"
  data-site-header
>
  <div class="mx-auto flex w-full max-w-[120rem] flex-wrap items-center justify-between gap-x-4 px-4 sm:px-6 lg:flex-nowrap lg:px-8 xl:gap-x-6 xl:px-[4.5rem]">
    <a
      href={withBase('/')}
      class="v2-focus group inline-flex min-h-11 shrink-0 items-center gap-2.5 py-3 lg:min-h-[4.7rem]"
    >
      <span aria-hidden="true" class="text-v2-accent text-[0.6875rem]">
        ✦
      </span>
      <span class="font-v2-display text-v2-text text-[1.5625rem] leading-none font-semibold tracking-tight">
        guilherme<span class="text-v2-accent-warm">.dev</span>
      </span>
    </a>

    <!-- Controles à direita: alternador de tema (extremo direito no desktop e
         fora do menu expansível no mobile) + botão de menu mobile abaixo de lg.
         Sem JavaScript, a navegação permanece visível. -->
    <div
      class:list={[
        'flex shrink-0 items-center gap-2 lg:order-3',
        !LIGHT_THEME_ENABLED && 'lg:hidden',
      ]}
    >
      <ThemeToggle />

      <button
        type="button"
        hidden
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Abrir menu"
        class="v2-focus border-v2-border text-v2-text hover:border-v2-text/60 inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center border lg:hidden"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>

    <nav
      id="site-nav"
      aria-label="Principal"
      class="basis-full pb-3 max-lg:data-[collapsed=true]:hidden lg:order-2 lg:ml-auto lg:basis-auto lg:pb-0"
    >
      <ul class="flex flex-col lg:flex-row lg:items-center lg:gap-x-3 xl:gap-x-5 2xl:gap-x-6">
        {items.map((item) => {
          const targetHref = withBase(item.href);
          const isCurrent = normalize(currentPath) === normalize(targetHref);
          return (
            <li>
              <a
                href={targetHref}
                aria-current={isCurrent ? 'page' : undefined}
                class:list={[
                  'v2-focus relative inline-flex min-h-11 items-center whitespace-nowrap font-v2-sans text-[0.8125rem] tracking-[0.025em] transition-colors motion-reduce:transition-none lg:min-h-[4.7rem]',
                  isCurrent
                    ? 'text-v2-text after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-full after:bg-v2-accent max-lg:underline max-lg:decoration-v2-accent max-lg:underline-offset-8'
                    : 'text-v2-text-muted hover:text-v2-text',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = header?.querySelector<HTMLElement>('#site-nav');

  if (header && toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.dataset.collapsed = String(!open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    };

    // Com JavaScript disponível, o menu começa recolhido abaixo de lg.
    toggle.hidden = false;
    setOpen(false);

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        toggle.getAttribute('aria-expanded') === 'true'
      ) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
