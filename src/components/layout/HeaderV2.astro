---
/**
 * Header 2.0 global do Design System 2.0 (docs/HEADER_2_0.md — EXP-06A).
 *
 * - Desktop (`xl+` / 1280px): 6 links diretos (Home, Sobre, Projetos, Linux, Artigos,
 *   Resenhas quando disponível) + 3 dropdowns cinematográficos (Cultura, Tecnologia,
 *   Acervo) + alternador de tema à direita.
 * - Mobile e larguras intermediárias (`< xl`): barra compacta com logo, ThemeToggle
 *   sempre acessível e menu recolhível organizado nas 4 seções oficiais.
 * - Sem JavaScript, a navegação principal permanece visível e acessível.
 */
import {
  getVisibleNavDropdownGroups,
  getVisiblePrimaryNavLinks,
  isNavRouteActive,
} from '../../data/navigation';
import { withBase } from '../../utils/base';
import ThemeToggle from '../ui/ThemeToggle.astro';
import HeaderDropdown from './HeaderDropdown.astro';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const primaryLinks = getVisiblePrimaryNavLinks();
const dropdownGroups = getVisibleNavDropdownGroups();
---

<header
  class="border-v2-border/70 relative z-30 border-b bg-v2-bg"
  data-site-header
>
  <div class="relative mx-auto flex w-full max-w-[120rem] flex-wrap items-center justify-between gap-x-4 px-4 sm:px-6 xl:flex-nowrap xl:gap-x-6 xl:px-[4.5rem]">
    {/* Marca */}
    <a
      href={withBase('/')}
      class="v2-focus group inline-flex min-h-11 shrink-0 items-center gap-2.5 py-3 xl:min-h-[4.7rem]"
    >
      <span aria-hidden="true" class="text-v2-accent text-[0.6875rem]">
        ✦
      </span>
      <span class="font-v2-display text-v2-text text-[1.5625rem] leading-none font-semibold tracking-tight">
        guilherme<span class="text-v2-accent-warm">.dev</span>
      </span>
    </a>

    {/* Controles à direita: alternador de tema (extremo direito no desktop e
        sempre acessível no mobile) + botão hambúrguer abaixo de xl. */}
    <div class="flex shrink-0 items-center gap-2 xl:order-3">
      <ThemeToggle />

      <button
        type="button"
        hidden
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-nav-mobile"
        aria-label="Abrir menu"
        class="v2-focus border-v2-border text-v2-text hover:border-v2-text/60 inline-flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center border xl:hidden"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>

    {/* Navegação Desktop (xl+): 6 links diretos + 3 dropdowns cinematográficos */}
    <nav
      aria-label="Principal"
      class="hidden xl:order-2 xl:ml-auto xl:block"
      data-desktop-nav
    >
      <ul class="flex items-center gap-x-5 2xl:gap-x-6">
        {primaryLinks.map((item) => {
          const targetHref = withBase(item.href);
          const isCurrent = isNavRouteActive(currentPath, item.href, base);
          return (
            <li>
              <a
                href={targetHref}
                aria-current={isCurrent ? 'page' : undefined}
                class:list={[
                  'v2-focus relative inline-flex min-h-[4.7rem] items-center whitespace-nowrap font-v2-sans text-[0.8125rem] tracking-[0.025em] transition-colors motion-reduce:transition-none',
                  isCurrent
                    ? 'text-v2-text after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-full after:bg-v2-accent'
                    : 'text-v2-text-muted hover:text-v2-text',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}

        {dropdownGroups.length > 0 && (
          <li aria-hidden="true" class="h-4 w-px bg-v2-border/80 select-none" />
        )}

        {dropdownGroups.map((group) => (
          <HeaderDropdown group={group} currentPath={currentPath} />
        ))}
      </ul>
    </nav>

    {/* Navegação Mobile e larguras intermediárias (< xl): lista organizada em 4 seções */}
    <nav
      id="site-nav-mobile"
      aria-label="Menu de navegação"
      class="max-h-[calc(100vh-4.5rem)] basis-full overflow-y-auto border-t border-v2-border/60 py-4 data-[collapsed=true]:hidden xl:hidden"
      data-mobile-nav
    >
      <div class="space-y-5">
        <section aria-labelledby="mobile-nav-principal">
          <p
            id="mobile-nav-principal"
            class="mb-2 font-v2-mono text-[10px] tracking-[0.18em] text-v2-accent-warm uppercase"
          >
            Navegação principal
          </p>
          <ul class="grid grid-cols-1 gap-0.5 sm:grid-cols-2">
            {primaryLinks.map((item) => {
              const targetHref = withBase(item.href);
              const isCurrent = isNavRouteActive(currentPath, item.href, base);
              return (
                <li>
                  <a
                    href={targetHref}
                    aria-current={isCurrent ? 'page' : undefined}
                    class:list={[
                      'v2-focus flex min-h-11 items-center font-v2-sans text-sm transition-colors motion-reduce:transition-none',
                      isCurrent
                        ? 'font-medium text-v2-text underline decoration-v2-accent underline-offset-8'
                        : 'text-v2-text-muted hover:text-v2-text',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>

        {dropdownGroups.map((group) => (
          <section
            aria-labelledby={`mobile-nav-${group.id}`}
            class="border-t border-v2-border/60 pt-4"
          >
            <p
              id={`mobile-nav-${group.id}`}
              class="mb-2 font-v2-mono text-[10px] tracking-[0.18em] text-v2-accent-warm uppercase"
            >
              {group.label}
            </p>
            <ul class="grid grid-cols-1 gap-1 sm:grid-cols-2">
              {group.items.map((item) => {
                const targetHref = withBase(item.href);
                const isCurrent = isNavRouteActive(
                  currentPath,
                  item.href,
                  base,
                );
                return (
                  <li>
                    <a
                      href={targetHref}
                      aria-current={isCurrent ? 'page' : undefined}
                      class:list={[
                        'v2-focus flex min-h-11 flex-col justify-center py-1.5 transition-colors motion-reduce:transition-none',
                        isCurrent
                          ? 'text-v2-text'
                          : 'text-v2-text-muted hover:text-v2-text',
                      ]}
                    >
                      <span
                        class:list={[
                          'font-v2-sans text-sm',
                          isCurrent &&
                            'font-medium underline decoration-v2-accent underline-offset-4',
                        ]}
                      >
                        {item.label}
                      </span>
                      <span class="font-v2-sans text-xs font-light text-v2-text-muted">
                        {item.description}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  function setupHeaderV2() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.headerBound === 'true') return;
    header.dataset.headerBound = 'true';

    // 1. Menu mobile recolhível (< xl)
    const mobileToggle =
      header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const mobileNav = header.querySelector<HTMLElement>('[data-mobile-nav]');

    const setMobileOpen = (open: boolean) => {
      if (!mobileToggle || !mobileNav) return;
      mobileNav.dataset.collapsed = String(!open);
      mobileToggle.setAttribute('aria-expanded', String(open));
      mobileToggle.setAttribute(
        'aria-label',
        open ? 'Fechar menu' : 'Abrir menu',
      );
    };

    if (mobileToggle && mobileNav) {
      mobileToggle.hidden = false;
      setMobileOpen(false);

      mobileToggle.addEventListener('click', () => {
        setMobileOpen(mobileToggle.getAttribute('aria-expanded') !== 'true');
      });

      mobileNav.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) setMobileOpen(false);
      });
    }

    // 2. Dropdowns cinematográficos no desktop (clique + teclado + viewport clamping)
    const dropdownRoots = Array.from(
      header.querySelectorAll<HTMLElement>('[data-header-dropdown]'),
    );

    const clampPanelToViewport = (panel: HTMLElement) => {
      panel.style.transform = '';
      const rect = panel.getBoundingClientRect();
      const margin = 16;
      let shiftX = 0;

      if (rect.right > window.innerWidth - margin) {
        shiftX = window.innerWidth - margin - rect.right;
      } else if (rect.left < margin) {
        shiftX = margin - rect.left;
      }

      if (shiftX !== 0) {
        panel.style.transform = `translateX(${Math.round(shiftX)}px)`;
      }
    };

    const closeDropdown = (root: HTMLElement, returnFocus = false) => {
      const trigger = root.querySelector<HTMLButtonElement>(
        '[data-dropdown-trigger]',
      );
      const panel = root.querySelector<HTMLElement>('[data-dropdown-panel]');
      const chevron = root.querySelector<SVGElement>('[data-dropdown-chevron]');
      if (!trigger || !panel) return;

      trigger.setAttribute('aria-expanded', 'false');
      panel.classList.remove('opacity-100');
      panel.classList.add('opacity-0');
      panel.hidden = true;
      panel.style.transform = '';
      chevron?.classList.remove('rotate-180');
      if (returnFocus) trigger.focus();
    };

    const closeAllDropdowns = (except?: HTMLElement) => {
      for (const root of dropdownRoots) {
        if (root !== except) closeDropdown(root, false);
      }
    };

    const openDropdown = (root: HTMLElement) => {
      const trigger = root.querySelector<HTMLButtonElement>(
        '[data-dropdown-trigger]',
      );
      const panel = root.querySelector<HTMLElement>('[data-dropdown-panel]');
      const chevron = root.querySelector<SVGElement>('[data-dropdown-chevron]');
      if (!trigger || !panel) return;

      closeAllDropdowns(root);
      trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      clampPanelToViewport(panel);
      requestAnimationFrame(() => {
        panel.classList.remove('opacity-0');
        panel.classList.add('opacity-100');
      });
      chevron?.classList.add('rotate-180');
    };

    for (const root of dropdownRoots) {
      const trigger = root.querySelector<HTMLButtonElement>(
        '[data-dropdown-trigger]',
      );
      const panel = root.querySelector<HTMLElement>('[data-dropdown-panel]');
      if (!trigger || !panel) continue;

      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeDropdown(root, false);
        } else {
          openDropdown(root);
        }
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          if (trigger.getAttribute('aria-expanded') !== 'true') {
            openDropdown(root);
          }
          const firstLink = panel.querySelector<HTMLAnchorElement>(
            '[data-dropdown-link]',
          );
          firstLink?.focus();
        }
      });

      panel.addEventListener('keydown', (event) => {
        const links = Array.from(
          panel.querySelectorAll<HTMLAnchorElement>('[data-dropdown-link]'),
        );
        if (links.length === 0) return;

        const currentIndex = links.indexOf(
          document.activeElement as HTMLAnchorElement,
        );

        if (event.key === 'ArrowDown') {
          event.preventDefault();
          links[(currentIndex + 1) % links.length]?.focus();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          links[(currentIndex - 1 + links.length) % links.length]?.focus();
        } else if (event.key === 'Home') {
          event.preventDefault();
          links[0]?.focus();
        } else if (event.key === 'End') {
          event.preventDefault();
          links[links.length - 1]?.focus();
        }
      });

      panel.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) {
          closeDropdown(root, false);
        }
      });
    }

    // Fechamento global por clique externo e Escape
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) {
        closeAllDropdowns();
        setMobileOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      const openRoot = dropdownRoots.find(
        (root) =>
          root
            .querySelector<HTMLButtonElement>('[data-dropdown-trigger]')
            ?.getAttribute('aria-expanded') === 'true',
      );
      if (openRoot) {
        closeDropdown(openRoot, true);
        return;
      }

      if (mobileToggle?.getAttribute('aria-expanded') === 'true') {
        setMobileOpen(false);
        mobileToggle.focus();
      }
    });

    window.addEventListener('resize', () => {
      for (const root of dropdownRoots) {
        const panel = root.querySelector<HTMLElement>('[data-dropdown-panel]');
        if (panel && !panel.hidden) {
          clampPanelToViewport(panel);
        }
      }
    });
  }

  setupHeaderV2();
  document.addEventListener('astro:page-load', setupHeaderV2);
</script>
