---
import { navigation } from '../../data/navigation';
import Container from '../ui/Container.astro';

const currentPath = Astro.url.pathname;
const items = navigation.filter((item) => item.available);
---

<header class="border-border border-b">
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
      <a
        href="/"
        class="font-display text-text focus-visible:outline-accent text-lg font-bold focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        guilherme.dev
      </a>
      <nav aria-label="Principal">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-1">
          {items.map((item) => {
            const isCurrent = currentPath === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class:list={[
                    'font-mono text-sm tracking-wider uppercase focus-visible:outline-accent focus-visible:outline-2 focus-visible:outline-offset-4',
                    isCurrent
                      ? 'text-accent underline underline-offset-8'
                      : 'text-text-muted hover:text-text',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>
  </Container>
</header>
