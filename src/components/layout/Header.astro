---
import { navigation } from '../../data/navigation';
import Container from '../ui/Container.astro';

const currentPath = Astro.url.pathname;
const items = navigation.filter((item) => item.available);
---

<header class="border-border border-b" data-site-header>
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
      <a
        href="/"
        class="font-display text-text focus-visible:outline-accent text-lg font-bold focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        guilherme.dev
      </a>
      <!-- O botão só aparece no mobile e só depois que o script remove "hidden".
           Sem JavaScript, a navegação permanece visível. -->
      <button
        type="button"
        hidden
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Abrir menu"
        class="border-border text-text hover:border-accent focus-visible:outline-accent inline-flex min-h-11 min-w-11 items-center justify-center rounded-md border focus-visible:outline-2 focus-visible:outline-offset-2 md:hidden"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
      <nav
        id="site-nav"
        aria-label="Principal"
        class="basis-full max-md:data-[collapsed=true]:hidden md:basis-auto"
      >
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-1">
          {items.map((item) => {
            const isCurrent = currentPath === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class:list={[
                    'font-mono text-sm tracking-wider uppercase focus-visible:outline-accent focus-visible:outline-2 focus-visible:outline-offset-4 inline-flex min-h-11 items-center',
                    isCurrent
                      ? 'text-accent underline underline-offset-8'
                      : 'text-text-muted hover:text-text',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>
  </Container>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = header?.querySelector<HTMLElement>('#site-nav');

  if (header && toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.dataset.collapsed = String(!open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    };

    // Com JavaScript disponível, o menu começa recolhido no mobile.
    toggle.hidden = false;
    setOpen(false);

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        toggle.getAttribute('aria-expanded') === 'true'
      ) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
