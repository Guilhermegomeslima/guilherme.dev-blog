---
import Container from '../ui/Container.astro';
import { socialLinks, copyrightText } from '../../data/social';
---

<footer class="border-border border-t py-8">
  <Container>
    <div class="flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
      <p class="font-body text-text-muted text-sm">{copyrightText}</p>
      <nav aria-label="Redes sociais">
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-text-muted hover:text-accent focus-visible:outline-accent text-xs tracking-wider uppercase focus-visible:outline-2 focus-visible:outline-offset-4"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </Container>
</footer>
