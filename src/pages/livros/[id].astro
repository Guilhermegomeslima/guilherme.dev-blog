---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentNavigation from '../../components/content/ContentNavigation.astro';
import DemoNotice from '../../components/ui/DemoNotice.astro';
import ShareButton from '../../components/ui/ShareButton.astro';
import { withBase } from '../../utils/base';
import {
  buildNavigableEntries,
  compareBooks,
} from '../../utils/content-navigation';

export async function getStaticPaths() {
  const books = await getCollection('books');

  return buildNavigableEntries(books, compareBooks).map(
    ({ entry: book, prev: prevBook, next: nextBook }) => ({
      params: { id: book.id },
      props: {
        book,
        prevBook,
        nextBook,
      },
    }),
  );
}

interface Props {
  book: CollectionEntry<'books'>;
  prevBook?: CollectionEntry<'books'> | null;
  nextBook?: CollectionEntry<'books'> | null;
}

const { book, prevBook = null, nextBook = null } = Astro.props;
const { data, id } = book;

const statusLabels: Record<
  string,
  { label: string; badgeClass: string; note: string }
> = {
  lendo: {
    label: 'Leitura em Andamento',
    badgeClass: 'text-[#e47986]',
    note: 'Volume atualmente em leitura ativa no gabinete pessoal.',
  },
  lido: {
    label: 'Leitura Concluída',
    badgeClass: 'text-[var(--color-v2-accent-warm)]',
    note: 'Obra integralmente lida e incorporada ao acervo de referência.',
  },
  quero_ler: {
    label: 'Fila de Próximas Leituras',
    badgeClass: 'text-[var(--color-v2-muted)]',
    note: 'Volume catalogado na estante para leitura futura.',
  },
};

const currentStatus = statusLabels[data.status] || {
  label: data.status,
  badgeClass: 'text-[var(--color-v2-muted)]',
  note: 'Volume catalogado na biblioteca pessoal.',
};
---

<BaseLayout
  variant="v2"
  title={`${data.title} — Ficha de Leitura // guilherme.dev`}
  description={
    data.description ||
    `Ficha de leitura de ${data.title}, obra de ${data.author}.`
  }
  image={data.coverImage?.url}
  noindex={data.isDemo}
>
  <div class="relative overflow-hidden pb-20 md:pb-28">
    {/* Atmosfera sutil derivada da capa do livro */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-[500px] overflow-hidden"
    >
      <img
        src={withBase(data.coverImage?.url || '/images/home/livros.webp')}
        alt=""
        width="600"
        height="900"
        loading="eager"
        decoding="async"
        class="h-full w-full scale-110 object-cover object-center opacity-[0.10] blur-3xl filter"
      />
      <div
        class="absolute inset-0"
        style="background: radial-gradient(ellipse at 50% 0%, rgba(198, 166, 107, 0.14) 0%, rgba(7, 7, 9, 0.88) 65%, #070709 100%);"
      ></div>
    </div>

    <div class="relative mx-auto w-full max-w-[1000px] px-5 pt-10 sm:px-8 md:pt-14">
      {/* Barra superior de retorno e identificação do registro */}
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-[var(--color-v2-border)] pb-4">
        <a
          href={withBase('/livros/')}
          class="v2-focus inline-flex items-center gap-2 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.14em] text-[var(--color-v2-muted)] uppercase transition-colors hover:text-[var(--color-v2-heading)]"
        >
          <span aria-hidden="true" class="text-[var(--color-v2-accent-warm)]">
            &larr;
          </span>
          <span>Voltar para a biblioteca de livros</span>
        </a>

        <div class="flex flex-wrap items-center gap-3">
          <span class="font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
            REGISTRO BIBLIOGRÁFICO // #{id}
          </span>
          <ShareButton
            title={`${data.title} — Ficha de Leitura // guilherme.dev`}
            text={
              data.description ||
              `Ficha de leitura de ${data.title}, obra de ${data.author}.`
            }
            url={`/livros/${id}/`}
          />
        </div>
      </div>

      {/* Hero com Capa 2:3 e Ficha Bibliográfica */}
      <div class="grid grid-cols-1 gap-8 border-b border-[var(--color-v2-border)] pb-12 md:grid-cols-12 md:items-start lg:gap-12">
        {/* Coluna da Capa (2:3) */}
        <div class="md:col-span-5 lg:col-span-4">
          <div class="relative mx-auto max-w-[300px] border border-[var(--color-v2-border-hover)] bg-[#050508] p-2 shadow-[0_24px_60px_rgba(0,0,0,0.75)] md:mx-0 md:max-w-none">
            {/* Cantoneiras em bronze */}
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -top-px -left-px h-3.5 w-3.5 border-t border-l border-[var(--color-v2-accent-warm)]"
            ></span>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -top-px -right-px h-3.5 w-3.5 border-t border-r border-[var(--color-v2-accent-warm)]"
            ></span>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -bottom-px -left-px h-3.5 w-3.5 border-b border-l border-[var(--color-v2-accent-warm)]"
            ></span>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -bottom-px -right-px h-3.5 w-3.5 border-b border-r border-[var(--color-v2-accent-warm)]"
            ></span>

            <div class="relative aspect-[2/3] overflow-hidden border border-[var(--color-v2-border)] bg-[#070709]">
              {data.coverImage ? (
                <img
                  src={withBase(data.coverImage.url)}
                  alt={data.coverImage.alt}
                  width="600"
                  height="900"
                  loading="eager"
                  decoding="async"
                  class="h-full w-full object-cover brightness-95 contrast-105"
                />
              ) : (
                <div class="flex h-full w-full flex-col justify-between bg-[#070709] p-8 select-none">
                  <span class="font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
                    // TOMO BIBLIOGRÁFICO
                  </span>
                  <div>
                    <h2 class="font-[family-name:var(--font-v2-display)] text-2xl font-normal text-[var(--color-v2-heading)]">
                      {data.title}
                    </h2>
                    <p class="mt-3 font-[family-name:var(--font-v2-mono)] text-sm text-[var(--color-v2-muted)]">
                      {data.author}
                    </p>
                  </div>
                  <span class="font-[family-name:var(--font-v2-mono)] text-xs text-[var(--color-v2-muted)]">
                    {data.genre}
                  </span>
                </div>
              )}

              {/* Sombra de encadernação */}
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 left-0 w-4 bg-gradient-to-r from-black/60 via-white/[0.04] to-transparent"
              ></div>
            </div>
          </div>
        </div>

        {/* Coluna de Ficha Bibliográfica */}
        <div class="flex flex-col justify-between md:col-span-7 lg:col-span-8">
          <div>
            <div class="mb-3 flex flex-wrap items-center gap-2.5 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.16em] uppercase">
              <span class="text-[var(--color-v2-accent-warm)]">
                // {data.genre}
              </span>
              {data.year && (
                <>
                  <span
                    class="text-[var(--color-v2-border-hover)]"
                    aria-hidden="true"
                  >
                    ·
                  </span>
                  <span class="text-[var(--color-v2-text)]">{data.year}</span>
                </>
              )}
            </div>

            <h1 class="font-[family-name:var(--font-v2-display)] text-4xl leading-[1.06] font-normal tracking-[-0.02em] text-[var(--color-v2-heading)] sm:text-5xl">
              {data.title}
            </h1>

            <p class="mt-3 font-[family-name:var(--font-v2-display)] text-2xl text-[var(--color-v2-accent-warm)] italic">
              Por {data.author}
            </p>

            {/* Metadados do Livro */}
            <dl class="mt-8 grid grid-cols-1 gap-3 border-y border-[var(--color-v2-border)] py-5 sm:grid-cols-3">
              <div class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/70 p-4">
                <dt class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
                  Status de Leitura
                </dt>
                <dd
                  class:list={[
                    'mt-1.5 font-[family-name:var(--font-v2-sans)] text-sm font-medium',
                    currentStatus.badgeClass,
                  ]}
                >
                  {currentStatus.label}
                </dd>
              </div>

              <div class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/70 p-4">
                <dt class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
                  Recorte Temático
                </dt>
                <dd class="mt-1.5 font-[family-name:var(--font-v2-sans)] text-sm font-light text-[var(--color-v2-heading)]">
                  {data.genre}
                </dd>
              </div>

              <div class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/70 p-4">
                <dt class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
                  Destaque no Acervo
                </dt>
                <dd
                  class:list={[
                    'mt-1.5 font-[family-name:var(--font-v2-sans)] text-sm font-medium',
                    data.favorite
                      ? 'text-[var(--color-v2-accent-warm)]'
                      : 'text-[var(--color-v2-text)]',
                  ]}
                >
                  {data.favorite ? '★ Obra Favorita' : 'Leitura Regular'}
                </dd>
              </div>
            </dl>

            {/* Situação no Gabinete */}
            <div class="mt-6 border-l-2 border-[var(--color-v2-accent-warm)]/60 bg-[var(--color-v2-surface)]/65 px-5 py-4">
              <span class="block font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
                Situação no Gabinete
              </span>
              <p class="mt-1 font-[family-name:var(--font-v2-sans)] text-sm leading-relaxed font-light text-[var(--color-v2-text)]">
                {currentStatus.note}
              </p>
            </div>
          </div>
        </div>
      </div>

      {/* Aviso de mock data se aplicável */}
      {data.isDemo && <DemoNotice variant="item" class="my-8" />}

      {/* Seções de Texto e Resenha */}
      <div class="mt-10 space-y-10">
        {data.description && (
          <section>
            <span class="mb-2 block font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
              // SINOPSE &amp; ESCOPO
            </span>
            <p class="font-[family-name:var(--font-v2-sans)] text-base leading-relaxed font-light text-[var(--color-v2-text)] sm:text-lg">
              {data.description}
            </p>
          </section>
        )}

        {data.comment && (
          <section class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/75 p-6 sm:p-8">
            <span class="mb-3 block font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
              // ANOTAÇÕES DE LEITURA &amp; IMPRESSÕES
            </span>
            <p class="font-[family-name:var(--font-v2-display)] text-xl leading-relaxed text-[var(--color-v2-heading)] italic">
              "{data.comment}"
            </p>
          </section>
        )}

        {/* Nota Metodológica */}
        <div class="border-t border-[var(--color-v2-border)] pt-4 text-right">
          <span class="font-[family-name:var(--font-v2-mono)] text-[11px] text-[var(--color-v2-muted)]">
            * A seção de livros prioriza resenhas e fichamentos textuais sem
            atribuição de notas numéricas antes da definição de metodologia.
          </span>
        </div>
      </div>

      {/* Navegação entre Volumes e Rodapé da Página */}
      <ContentNavigation
        ariaLabel="Navegação da biblioteca de livros"
        prev={
          prevBook
            ? {
                href: `/livros/${prevBook.id}/`,
                label: `${prevBook.data.title} — ${prevBook.data.author}`,
              }
            : null
        }
        next={
          nextBook
            ? {
                href: `/livros/${nextBook.id}/`,
                label: `${nextBook.data.title} — ${nextBook.data.author}`,
              }
            : null
        }
        prevLabel="Volume anterior"
        nextLabel="Próximo volume"
        backHref="/livros/"
        backLabel="Voltar para biblioteca"
      />
    </div>
  </div>
</BaseLayout>
