---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingPanel from '../../components/content/RatingPanel.astro';
import ContentNavigation from '../../components/content/ContentNavigation.astro';
import DemoNotice from '../../components/ui/DemoNotice.astro';
import ShareButton from '../../components/ui/ShareButton.astro';
import { withBase } from '../../utils/base';
import { calculateGameScore, formatScore } from '../../utils/ratings';
import {
  buildNavigableEntries,
  compareGames,
} from '../../utils/content-navigation';

export async function getStaticPaths() {
  const games = await getCollection('games');

  return buildNavigableEntries(games, compareGames).map(
    ({ entry: game, prev: prevGame, next: nextGame }) => ({
      params: { id: game.id },
      props: {
        game,
        prevGame,
        nextGame,
      },
    }),
  );
}

interface Props {
  game: CollectionEntry<'games'>;
  prevGame?: CollectionEntry<'games'> | null;
  nextGame?: CollectionEntry<'games'> | null;
}

const { game, prevGame = null, nextGame = null } = Astro.props;
const { data, id } = game;

const finalScore = calculateGameScore(data.scores);
const formattedFinal = formatScore(finalScore);

const statusLabels: Record<string, string> = {
  Platinado: 'Platinado',
  Concluido: 'Concluído',
  Jogando: 'Jogando',
  Parado: 'Parado',
  Descontinuado: 'Descontinuado',
};

const statusLabel = statusLabels[data.status] || data.status;
---

<BaseLayout
  variant="v2"
  title={`${data.title} — Avaliação de Jogos // guilherme.dev`}
  description={
    data.description ||
    `Avaliação e notas técnicas de ${data.title} (${data.releaseYear}), para ${data.platform}.`
  }
  image={data.coverImage.url}
  noindex={data.isDemo}
>
  <div class="relative overflow-hidden pb-20 md:pb-28">
    {/* Atmosfera sutil derivada da própria capa do jogo */}
    {!data.coverImage.isPlaceholder && data.coverImage.url && (
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 h-[520px] overflow-hidden"
      >
        <img
          src={withBase(data.coverImage.url)}
          alt=""
          width="600"
          height="800"
          loading="eager"
          decoding="async"
          class="h-full w-full scale-110 object-cover object-center opacity-[0.10] blur-3xl filter"
        />
        <div
          class="absolute inset-0"
          style="background: radial-gradient(ellipse at 50% 0%, rgba(139, 30, 45, 0.16) 0%, rgba(7, 7, 9, 0.88) 65%, #070709 100%);"
        />
      </div>
    )}

    <div class="relative mx-auto w-full max-w-[1040px] px-5 pt-10 sm:px-8 md:pt-14">
      {/* Barra superior de retorno e identificação do registro */}
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-[var(--color-v2-border)] pb-4">
        <a
          href={withBase('/jogos/')}
          class="v2-focus inline-flex items-center gap-2 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.14em] text-[var(--color-v2-muted)] uppercase transition-colors hover:text-[var(--color-v2-heading)]"
        >
          <span aria-hidden="true" class="text-[var(--color-v2-accent-warm)]">
            &larr;
          </span>
          <span>Voltar para catálogo de jogos</span>
        </a>

        <div class="flex flex-wrap items-center gap-3">
          <span class="font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
            REGISTRO LÚDICO // {id}
          </span>
          <ShareButton
            title={`${data.title} — Avaliação de Jogos // guilherme.dev`}
            text={
              data.description ||
              `Avaliação e notas técnicas de ${data.title} (${data.releaseYear}), para ${data.platform}.`
            }
            url={`/jogos/${id}/`}
          />
        </div>
      </div>

      {/* Hero do Dossiê: Capa 3:4 + Ficha Técnica + Nota Geral */}
      <div class="grid grid-cols-1 gap-8 border-b border-[var(--color-v2-border)] pb-12 md:grid-cols-12 md:items-start lg:gap-12">
        {/* Coluna da Capa (3:4) */}
        <div class="md:col-span-5 lg:col-span-4">
          <div class="relative mx-auto max-w-[340px] border border-[var(--color-v2-border-hover)] bg-[#050508] p-2 shadow-[0_24px_60px_rgba(0,0,0,0.75)] md:mx-0 md:max-w-none">
            {/* Cantoneiras em bronze */}
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -top-px -left-px h-3.5 w-3.5 border-t border-l border-[var(--color-v2-accent-warm)]"
            ></span>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -top-px -right-px h-3.5 w-3.5 border-t border-r border-[var(--color-v2-accent-warm)]"
            ></span>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -bottom-px -left-px h-3.5 w-3.5 border-b border-l border-[var(--color-v2-accent-warm)]"
            ></span>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -bottom-px -right-px h-3.5 w-3.5 border-b border-r border-[var(--color-v2-accent-warm)]"
            ></span>

            <div class="relative aspect-[3/4] overflow-hidden border border-[var(--color-v2-border)] bg-[#070709]">
              {!data.coverImage.isPlaceholder && data.coverImage.url ? (
                <img
                  src={withBase(data.coverImage.url)}
                  alt={data.coverImage.alt}
                  width="600"
                  height="800"
                  loading="eager"
                  decoding="async"
                  class="h-full w-full object-cover brightness-[0.97] contrast-[1.03]"
                />
              ) : (
                <div class="flex h-full w-full flex-col justify-between bg-[#070709] p-8 select-none">
                  <div class="flex items-center justify-between font-[family-name:var(--font-v2-mono)] text-xs text-[var(--color-v2-accent-warm)]">
                    <span>// CARTUCHO / MÍDIA</span>
                    <span>{data.platform}</span>
                  </div>
                  <div>
                    <h2 class="font-[family-name:var(--font-v2-display)] text-2xl font-normal text-[var(--color-v2-heading)]">
                      {data.title}
                    </h2>
                    <p class="mt-2 font-[family-name:var(--font-v2-mono)] text-sm text-[var(--color-v2-muted)]">
                      {data.developer || data.genre}
                    </p>
                  </div>
                  <div class="flex items-center justify-between border-t border-[var(--color-v2-border)] pt-3 font-[family-name:var(--font-v2-mono)] text-xs text-[var(--color-v2-muted)]">
                    <span>Lançamento: {data.releaseYear}</span>
                    <span class="border border-[var(--color-v2-accent-warm)]/40 px-2 py-0.5 text-[10px] text-[var(--color-v2-accent-warm)]">
                      Capa Provisória
                    </span>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>

        {/* Coluna de Informações e Síntese Analítica */}
        <div class="flex flex-col justify-between md:col-span-7 lg:col-span-8">
          <div>
            {/* Eyebrow de Categoria & Ano */}
            <div class="mb-3 flex flex-wrap items-center gap-2.5 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.16em] uppercase">
              <span class="text-[var(--color-v2-accent-warm)]">
                // {data.genre}
              </span>
              <span
                class="text-[var(--color-v2-border-hover)]"
                aria-hidden="true"
              >
                ·
              </span>
              <span class="text-[var(--color-v2-text)]">
                {data.releaseYear}
              </span>
              {data.developer && (
                <>
                  <span
                    class="text-[var(--color-v2-border-hover)]"
                    aria-hidden="true"
                  >
                    ·
                  </span>
                  <span class="text-[var(--color-v2-muted)]">
                    {data.developer}
                  </span>
                </>
              )}
            </div>

            {/* Título da Obra */}
            <h1 class="font-[family-name:var(--font-v2-display)] text-4xl leading-[1.06] font-normal tracking-[-0.02em] text-[var(--color-v2-heading)] sm:text-5xl">
              {data.title}
            </h1>

            {/* Grade de Ficha Técnica */}
            <dl class="mt-6 grid grid-cols-2 gap-3 border-y border-[var(--color-v2-border)] py-5 sm:grid-cols-4">
              <div>
                <dt class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
                  Plataforma
                </dt>
                <dd class="mt-1 font-[family-name:var(--font-v2-sans)] text-sm font-medium text-[var(--color-v2-heading)]">
                  {data.platform}
                </dd>
              </div>

              <div>
                <dt class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
                  Status
                </dt>
                <dd class="mt-1 font-[family-name:var(--font-v2-sans)] text-sm font-medium text-[var(--color-v2-accent-warm)]">
                  {statusLabel}
                </dd>
              </div>

              <div>
                <dt class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
                  Estúdio / Dev
                </dt>
                <dd class="mt-1 font-[family-name:var(--font-v2-sans)] text-sm font-light text-[var(--color-v2-text)]">
                  {data.developer || '—'}
                </dd>
              </div>

              <div>
                <dt class="font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
                  Lançamento
                </dt>
                <dd class="mt-1 font-[family-name:var(--font-v2-mono)] text-sm text-[var(--color-v2-text)]">
                  {data.releaseYear}
                </dd>
              </div>
            </dl>

            {data.description && (
              <p class="mt-6 font-[family-name:var(--font-v2-sans)] text-base leading-relaxed font-light text-[var(--color-v2-text)]">
                {data.description}
              </p>
            )}
          </div>

          {/* Selo de Média Geral de Avaliação */}
          <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border border-[var(--color-v2-accent-warm)]/35 bg-[var(--color-v2-surface)]/90 p-5 sm:p-6">
            <div>
              <span class="block font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.18em] text-[var(--color-v2-accent-warm)] uppercase">
                Média Geral de Avaliação
              </span>
              <span class="mt-1 block font-[family-name:var(--font-v2-sans)] text-xs font-light text-[var(--color-v2-muted)]">
                Escala uniforme de 0 a 100 ·{' '}
                {data.scores.plot === null
                  ? 'quatro critérios aplicáveis de peso equivalente'
                  : 'cinco critérios de peso equivalente'}
              </span>
            </div>

            <div class="flex items-baseline gap-1.5">
              <span class="font-[family-name:var(--font-v2-display)] text-4xl leading-none font-normal text-[var(--color-v2-heading)] sm:text-5xl">
                {formattedFinal}
              </span>
              <span class="font-[family-name:var(--font-v2-mono)] text-xs text-[var(--color-v2-accent-warm)]">
                / 100
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Aviso de mock data */}
      {data.isDemo && <DemoNotice variant="item" class="my-8" />}

      {/* Painel das Notas em 5 Eixos */}
      <div class="my-10">
        <RatingPanel scores={data.scores} />
      </div>

      {/* Parecer / Opinião Crítica (quando preenchido) */}
      {data.opinion && (
        <section class="mt-10 border-t border-[var(--color-v2-border)] pt-8">
          <div class="mb-4 flex items-center gap-2.5">
            <span
              aria-hidden="true"
              class="inline-block h-1.5 w-1.5 bg-[var(--color-v2-accent)]"
            />
            <h2 class="font-[family-name:var(--font-v2-display)] text-2xl font-normal text-[var(--color-v2-heading)]">
              Parecer Crítico
            </h2>
          </div>
          <div class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/80 p-6 font-[family-name:var(--font-v2-sans)] text-base leading-relaxed font-light text-[var(--color-v2-text)]">
            <p>{data.opinion}</p>
          </div>
        </section>
      )}

      {/* Navegação entre Obras e Rodapé da Página */}
      <ContentNavigation
        ariaLabel="Navegação do catálogo de jogos"
        prev={
          prevGame
            ? {
                href: `/jogos/${prevGame.id}/`,
                label: `${prevGame.data.title} (${prevGame.data.releaseYear})`,
              }
            : null
        }
        next={
          nextGame
            ? {
                href: `/jogos/${nextGame.id}/`,
                label: `${nextGame.data.title} (${nextGame.data.releaseYear})`,
              }
            : null
        }
        prevLabel="Registro anterior"
        nextLabel="Próximo registro"
        backHref="/jogos/"
        backLabel="Voltar para catálogo"
      />
    </div>
  </div>
</BaseLayout>
