---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import GameCard from '../../components/content/GameCard.astro';
import DemoNotice from '../../components/ui/DemoNotice.astro';

const allGames = await getCollection('games');

// Ordena jogos por ano de lançamento decrescente
const sortedGames = allGames.sort(
  (a, b) => b.data.releaseYear - a.data.releaseYear,
);

const hasDemoContent = allGames.some((g) => g.data.isDemo);
---

<BaseLayout
  title="Jogos & Avaliações — guilherme.dev"
  description="Catálogo de jogos analisados sob 5 dimensões técnicas e narrativas: Mecânica, Enredo, Estética, Retenção e Feeling."
>
  <div class="py-12 md:py-16">
    <Container>
      <SectionHeading
        eyebrow="// ACERVO LÚDICO"
        title="Jogos & Avaliações"
        description="Registros analíticos e notas ponderadas em 5 eixos para cada obra experimentada."
      />

      {hasDemoContent && <DemoNotice variant="section" class="mb-10" />}

      {/* Resumo do Acervo */}
      <div class="mb-10 flex flex-wrap items-center justify-between gap-3 border-b border-border/60 pb-4 font-mono text-xs text-text-muted">
        <span>
          Total catalogado:{' '}
          <strong class="text-text">{allGames.length} obras</strong>
        </span>
        <span class="text-text-muted/70">
          * Ordenadas cronologicamente por ano de lançamento
        </span>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
        {sortedGames.map((game) => (
          <GameCard game={game} />
        ))}
      </div>
    </Container>
  </div>
</BaseLayout>
