---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import DossierHero from '../components/about/DossierHero.astro';
import SkillsGrid from '../components/about/SkillsGrid.astro';
import ProjectsList from '../components/about/ProjectsList.astro';
import MissionSection from '../components/about/MissionSection.astro';
---

<BaseLayout
  title="Sobre // Dossiê — guilherme.dev"
  description="Dossiê pessoal de Guilherme Gomes: estudante de ADS, desenvolvedor em aprendizado, entusiasta de Linux, competências técnicas e projetos."
>
  <div class="py-12 md:py-16">
    <Container>
      <DossierHero />
      <SkillsGrid />
      <ProjectsList />
      <MissionSection />
    </Container>
  </div>
</BaseLayout>
