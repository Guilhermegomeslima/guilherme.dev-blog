---
import BaseLayout from '../layouts/BaseLayout.astro';
import DossierHero from '../components/about/DossierHero.astro';
import MissionSection from '../components/about/MissionSection.astro';
import SkillsGrid from '../components/about/SkillsGrid.astro';
import BeyondCodeSection from '../components/about/BeyondCodeSection.astro';
import ProjectsList from '../components/about/ProjectsList.astro';
---

<BaseLayout
  variant="v2"
  title="Sobre // Arquivo Pessoal — guilherme.dev"
  description="Arquivo pessoal e trajetória de Guilherme Gomes: estudante de ADS, desenvolvedor em aprendizado, entusiasta de Linux, competências técnicas e projetos."
>
  <div class="mx-auto w-full max-w-v2 px-6 pb-20 xl:px-0">
    <DossierHero />
    <MissionSection />
    <SkillsGrid />
    <BeyondCodeSection />
    <ProjectsList />
  </div>
</BaseLayout>
