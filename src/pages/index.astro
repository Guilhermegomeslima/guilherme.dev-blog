---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
---

<BaseLayout title="guilherme.dev">
  <Container>
    <section class="border-border bg-surface my-12 rounded-lg border p-6">
      <span class="font-mono text-xs tracking-wider text-accent-alt uppercase">
        UI-01 • BaseLayout e Container
      </span>
      <h1 class="font-display text-accent mt-2 text-3xl font-bold">
        guilherme.dev
      </h1>
      <p class="font-body text-text-muted mt-2 text-base">
        Layout base e container reutilizável configurados.
      </p>
    </section>
  </Container>
</BaseLayout>
