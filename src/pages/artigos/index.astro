---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ArticleCard from '../../components/content/ArticleCard.astro';
import DemoNotice from '../../components/ui/DemoNotice.astro';

const allArticles = await getCollection('articles');

// Ordena artigos por data de publicação decrescente
const sortedArticles = allArticles.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

// Define o artigo destacado (o primeiro com featured: true ou o mais recente)
const featuredArticle =
  sortedArticles.find((a) => a.data.featured) ?? sortedArticles[0];

// Artigos restantes da listagem cronológica
const recentArticles = sortedArticles.filter(
  (a) => a.id !== featuredArticle?.id,
);

const hasDemoContent = allArticles.some((a) => a.data.isDemo);
---

<BaseLayout
  title="Artigos & Ensaios — guilherme.dev"
  description="Textos autorais, análises técnicas, documentação de aprendizado e reflexões sobre engenharia de software e Linux."
>
  <div class="py-12 md:py-16">
    <Container>
      <SectionHeading
        eyebrow="// ARQUIVO EDITORIAL"
        title="Artigos & Ensaios"
        description="Publicações técnicas, anotações de arquitetura e explorações conceituais no formato de revista digital."
      />

      {hasDemoContent && <DemoNotice variant="section" class="mb-10" />}

      {featuredArticle && (
        <div class="mb-12">
          <ArticleCard article={featuredArticle} featured />
        </div>
      )}

      {recentArticles.length > 0 && (
        <div class="mt-12 border-t border-border/80 pt-10">
          <div class="mb-6 flex items-center justify-between">
            <h2 class="font-display text-xl font-bold tracking-tight text-text">
              Publicações recentes
            </h2>
            <span class="font-mono text-xs text-text-muted">
              {recentArticles.length}{' '}
              {recentArticles.length === 1 ? 'artigo' : 'artigos'}
            </span>
          </div>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {recentArticles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </div>
      )}
    </Container>
  </div>
</BaseLayout>
