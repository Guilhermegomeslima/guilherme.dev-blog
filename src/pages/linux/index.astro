---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LinuxTimeline from '../../components/linux/LinuxTimeline.astro';
import ReadingProgress from '../../components/ui/ReadingProgress.astro';
import ShareButton from '../../components/ui/ShareButton.astro';
import { withBase } from '../../utils/base';

const chapterIndex = [
  { id: 'cap-1', num: '01', label: 'Linux Desktop' },
  { id: 'cap-2', num: '02', label: 'Antes do Linux' },
  { id: 'cap-3', num: '03', label: 'LinuxFX' },
  { id: 'cap-4', num: '04', label: 'Xubuntu' },
  { id: 'cap-5', num: '05', label: 'Ubuntu & Jogos' },
  { id: 'cap-6', num: '06', label: 'Fedora Workstation' },
  { id: 'cap-7', num: '07', label: 'Aprendizados' },
  { id: 'cronologia', num: '08', label: 'Linha do Tempo' },
];
---

<BaseLayout
  variant="v2"
  title="Linux & Sistemas Operacionais — guilherme.dev"
  description="Minha trajetória com Linux: do Windows 11 ao Fedora. Como um notebook com pouca memória RAM me levou a descobrir um sistema operacional que acabou mudando minha relação com a tecnologia."
>
  <ReadingProgress />
  <div class="mx-auto w-full max-w-v2 px-6 pb-20 xl:px-0">
    <!-- Cabeçalho editorial da crônica -->
    <header
      aria-labelledby="linux-hero-title"
      class="border-v2-border/80 relative isolate overflow-hidden border-b pt-12 pb-16 lg:pt-20 lg:pb-24"
    >
      <!-- Fotografia atmosférica sutil à direita (mesma linguagem visual da Home V2) -->
      <img
        src={withBase('/images/home/linux.webp')}
        alt=""
        width="900"
        height="1350"
        decoding="async"
        class="v2-section-hero-photo pointer-events-none absolute top-0 right-0 -z-20 hidden h-full w-1/2 object-cover object-center opacity-30 brightness-[0.55] grayscale-[0.75] lg:block lg:[mask-image:linear-gradient(to_right,transparent,black_65%)]"
      />
      <div
        aria-hidden="true"
        class="from-v2-bg pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-linear-to-t to-transparent"
      ></div>

      <!-- Detalhe arquivístico lateral -->
      <div
        aria-hidden="true"
        class="font-v2-mono text-v2-text-muted/50 absolute top-12 right-0 hidden items-center gap-3 text-[0.5rem] tracking-[0.2em] uppercase lg:top-20 lg:flex"
      >
        <span>Crônica // SEC-02</span>
        <span class="bg-v2-accent/80 h-px w-8"></span>
      </div>

      <div class="max-w-4xl">
        <p class="v2-eyebrow text-v2-text-muted flex items-center gap-4 text-[0.625rem] tracking-[0.25em]">
          <span aria-hidden="true" class="bg-v2-accent h-px w-7"></span>
          Estação de trabalho &amp; sistemas
          <span aria-hidden="true" class="text-v2-text-muted/50">
            /
          </span>
          Linux
        </p>

        <h1
          id="linux-hero-title"
          class="font-v2-display text-v2-text mt-7 text-[clamp(2.5rem,4.6vw,4.9rem)] leading-[0.95] font-medium tracking-[-0.02em]"
        >
          Minha trajetória com Linux:
          <br />
          do Windows 11{' '}
          <em class="from-v2-text to-v2-text-muted bg-linear-to-r bg-clip-text pr-[0.08em] font-medium text-transparent italic">
            ao Fedora.
          </em>
        </h1>

        <p class="font-v2-sans text-v2-text-body mt-8 max-w-[42rem] text-sm leading-[1.85] font-light sm:text-base">
          Como um notebook com pouca memória RAM me levou a descobrir um sistema
          operacional que acabou mudando minha relação com a tecnologia.
        </p>

        <div class="mt-6">
          <ShareButton
            title="Minha trajetória com Linux: do Windows 11 ao Fedora — guilherme.dev"
            text="Como um notebook com pouca memória RAM me levou a descobrir um sistema operacional que acabou mudando minha relação com a tecnologia."
            url="/linux/"
          />
        </div>
      </div>

      <!-- Sumário de capítulos e cronologia -->
      <nav
        aria-label="Índice da crônica"
        class="border-v2-border/70 bg-v2-surface/45 mt-12 border p-4 sm:p-5 lg:mt-16"
      >
        <div class="border-v2-border/50 mb-3 flex items-center justify-between border-b pb-2.5">
          <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
            Índice de leitura // 07 capítulos + cronologia
          </span>
          <span
            aria-hidden="true"
            class="font-v2-mono text-v2-text-muted/60 text-[0.5625rem]"
          >
            OS-01 → OS-07
          </span>
        </div>

        <ol class="grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-4 lg:grid-cols-8">
          {chapterIndex.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                class="v2-focus group flex items-baseline gap-2 py-1.5 transition-colors motion-reduce:transition-none"
              >
                <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.14em]">
                  {item.num}
                </span>
                <span class="font-v2-sans text-v2-text-muted group-hover:text-v2-text text-xs font-light transition-colors motion-reduce:transition-none">
                  {item.label}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </header>

    <!-- Corpo da Crônica Editorial (Capítulos 01 a 07) -->
    <div data-reading-content class="divide-v2-border/70 divide-y">
      <!-- Capítulo 01 -->
      <section
        id="cap-1"
        aria-labelledby="cap-1-title"
        class="scroll-mt-8 py-16 lg:py-24"
      >
        <div class="mx-auto grid max-w-[66rem] grid-cols-1 gap-8 lg:grid-cols-[14rem_minmax(0,45rem)] lg:gap-10 xl:gap-14">
          <aside class="lg:pt-2">
            <div class="flex items-center gap-3">
              <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
                Capítulo 01
              </span>
              <span aria-hidden="true" class="bg-v2-border h-px w-5"></span>
            </div>
            <p class="font-v2-mono text-v2-text-muted mt-2 text-[0.625rem] tracking-[0.14em] uppercase">
              Conceito &amp; Liberdade
            </p>
          </aside>

          <div>
            <h2
              id="cap-1-title"
              class="font-v2-display text-v2-text text-[clamp(1.85rem,2.8vw,2.75rem)] leading-[1.08] font-medium tracking-[-0.01em]"
            >
              Linux desktop: muito além dos servidores
            </h2>

            <div class="font-v2-sans text-v2-text-body mt-7 space-y-5 text-sm leading-[1.9] font-light sm:text-[0.96875rem]">
              <p>
                Quando alguém fala sobre Linux, é comum pensar em servidores,
                terminais cheios de comandos e sistemas utilizados por
                profissionais de tecnologia. Mas Linux também está presente em
                computadores pessoais, com interfaces gráficas, navegadores,
                programas de escritório, ferramentas de desenvolvimento e até
                jogos.
              </p>
              <p>
                Diferentemente do Windows, o universo Linux oferece diversas
                distribuições, popularmente chamadas de{' '}
                <em class="text-v2-text italic">distros</em>. Cada uma combina o
                kernel Linux com um conjunto de ferramentas, programas e
                decisões próprias sobre como o sistema deve funcionar.
              </p>
              <p>
                Ubuntu, Fedora, Debian e Xubuntu são alguns exemplos. Embora
                compartilhem uma base tecnológica, podem proporcionar
                experiências bastante diferentes.
              </p>
              <p>
                Uma das características que mais me atrai nesse universo é a
                liberdade de escolha. Poder decidir qual ambiente gráfico
                utilizar, quais programas instalar e como organizar o próprio
                sistema é algo que passei a valorizar cada vez mais.
              </p>
              <p>Mas nem sempre pensei assim.</p>
              <p>
                Minha entrada no Linux não aconteceu por uma grande convicção
                sobre software livre ou por algum conhecimento avançado de
                computação. Na verdade, começou com um problema muito mais
                simples:{' '}
                <strong class="text-v2-text font-medium">
                  meu notebook não estava dando conta do Windows 11.
                </strong>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Capítulo 02 -->
      <section
        id="cap-2"
        aria-labelledby="cap-2-title"
        class="scroll-mt-8 py-16 lg:py-24"
      >
        <div class="mx-auto grid max-w-[66rem] grid-cols-1 gap-8 lg:grid-cols-[14rem_minmax(0,45rem)] lg:gap-10 xl:gap-14">
          <aside class="lg:pt-2">
            <div class="flex items-center gap-3">
              <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
                Capítulo 02
              </span>
              <span aria-hidden="true" class="bg-v2-border h-px w-5"></span>
            </div>
            <p class="font-v2-mono text-v2-text-muted mt-2 text-[0.625rem] tracking-[0.14em] uppercase">
              Windows 8 · 8.1 · 11
            </p>
          </aside>

          <div>
            <h2
              id="cap-2-title"
              class="font-v2-display text-v2-text text-[clamp(1.85rem,2.8vw,2.75rem)] leading-[1.08] font-medium tracking-[-0.01em]"
            >
              Antes do Linux: minha experiência com Windows
            </h2>

            <div class="font-v2-sans text-v2-text-body mt-7 space-y-5 text-sm leading-[1.9] font-light sm:text-[0.96875rem]">
              <p>
                Minha história com computadores começou no Windows. Durante a
                infância e a adolescência, utilizei o Windows 8 e o Windows 8.1
                em um notebook equipado com um processador Intel Core Duo e
                apenas 2 GB de memória RAM.
              </p>
              <p>
                Era um equipamento bastante limitado, mas foi nele que tive boa
                parte das minhas primeiras experiências com computadores.
              </p>
              <p>
                Depois de um tempo, o notebook acabou apresentando defeito, e
                passei um longo período sem ter um computador próprio.
              </p>
              <p>
                Isso mudou quando ganhei meu atual ASUS Vivobook 15, equipado
                com um Intel Core i3 de 12ª geração. Na época, ele possuía
                apenas 4 GB de memória RAM DDR4 — hoje já conta com 20 GB.
              </p>
              <p>O sistema instalado era o Windows 11.</p>
              <p>
                Apesar de o processador ser relativamente moderno, a pouca
                memória RAM se tornou um grande problema. O sistema apresentava
                gargalos que prejudicavam a utilização cotidiana. Mesmo assim,
                continuei usando o Windows 11 por quase um ano.
              </p>
              <p>
                Chegou um momento em que percebi que precisava fazer alguma
                coisa.
              </p>
              <p>
                Considerei duas alternativas: instalar uma versão modificada e
                mais enxuta do Windows 10, não oficial, ou experimentar Linux.
              </p>
              <p>Acabei escolhendo a segunda.</p>
              <p>
                Naquele momento, eu só queria utilizar melhor o hardware que
                tinha. Não imaginava que aquela decisão acabaria se
                transformando em um interesse tão grande pelo Linux.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Capítulo 03 -->
      <section
        id="cap-3"
        aria-labelledby="cap-3-title"
        class="scroll-mt-8 py-16 lg:py-24"
      >
        <div class="mx-auto grid max-w-[66rem] grid-cols-1 gap-8 lg:grid-cols-[14rem_minmax(0,45rem)] lg:gap-10 xl:gap-14">
          <aside class="lg:pt-2">
            <div class="flex items-center gap-3">
              <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
                Capítulo 03
              </span>
              <span aria-hidden="true" class="bg-v2-border h-px w-5"></span>
            </div>
            <p class="font-v2-mono text-v2-text-muted mt-2 text-[0.625rem] tracking-[0.14em] uppercase">
              Primeira Tentativa
            </p>
          </aside>

          <div>
            <h2
              id="cap-3-title"
              class="font-v2-display text-v2-text text-[clamp(1.85rem,2.8vw,2.75rem)] leading-[1.08] font-medium tracking-[-0.01em]"
            >
              LinuxFX: o erro de procurar outro Windows
            </h2>

            <div class="font-v2-sans text-v2-text-body mt-7 space-y-5 text-sm leading-[1.9] font-light sm:text-[0.96875rem]">
              <p>Minha primeira distribuição foi o LinuxFX.</p>
              <p>
                A escolha tinha um motivo bastante específico: eu queria algo
                que fosse o mais parecido possível com o Windows.
              </p>
              <p>
                Instalei o sistema em dual boot, mantendo a possibilidade de
                utilizar o Windows quando necessário.
              </p>
              <p>
                Visualmente, o LinuxFX realmente tentava reproduzir a
                experiência do sistema da Microsoft. O problema é que essa
                semelhança não significava que ele seria a melhor opção para meu
                computador.
              </p>
              <p>
                A distribuição não era tão leve quanto eu esperava. Além disso,
                alguns recursos de personalização visual estavam associados a
                uma versão Plus, oferecida inicialmente em um período gratuito
                de 30 dias.
              </p>
              <p>
                Aquilo me incomodou. Eu tinha procurado Linux justamente para
                encontrar uma alternativa mais leve e flexível, mas estava
                experimentando algo que não atendia tão bem às minhas
                necessidades.
              </p>
              <p>
                Hoje considero que cometi um erro nessa primeira tentativa:
                <strong class="text-v2-text font-medium">
                  procurei uma distribuição Linux querendo que ela fosse
                  praticamente igual ao Windows.
                </strong>
              </p>
              <p>
                Em vez de conhecer as possibilidades de um sistema diferente,
                tentei reproduzir a experiência que já conhecia.
              </p>
              <p>Minha trajetória com Linux poderia ter terminado ali.</p>
              <p>Felizmente, decidi tentar outra distribuição.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Capítulo 04 -->
      <section
        id="cap-4"
        aria-labelledby="cap-4-title"
        class="scroll-mt-8 py-16 lg:py-24"
      >
        <div class="mx-auto grid max-w-[66rem] grid-cols-1 gap-8 lg:grid-cols-[14rem_minmax(0,45rem)] lg:gap-10 xl:gap-14">
          <aside class="lg:pt-2">
            <div class="flex items-center gap-3">
              <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
                Capítulo 04
              </span>
              <span aria-hidden="true" class="bg-v2-border h-px w-5"></span>
            </div>
            <p class="font-v2-mono text-v2-text-muted mt-2 text-[0.625rem] tracking-[0.14em] uppercase">
              Ponto de Virada
            </p>
          </aside>

          <div>
            <h2
              id="cap-4-title"
              class="font-v2-display text-v2-text text-[clamp(1.85rem,2.8vw,2.75rem)] leading-[1.08] font-medium tracking-[-0.01em]"
            >
              Xubuntu: o verdadeiro ponto de virada
            </h2>

            <div class="font-v2-sans text-v2-text-body mt-7 space-y-5 text-sm leading-[1.9] font-light sm:text-[0.96875rem]">
              <p>Depois do LinuxFX, instalei o Xubuntu.</p>
              <p>Foi aqui que tudo começou a fazer sentido.</p>
              <p>
                O sistema era leve, responsivo e funcionava muito melhor com os
                recursos disponíveis no notebook. O gargalo de desempenho que
                havia motivado minha migração praticamente deixou de ser um
                problema.
              </p>
              <p>
                Visualmente, o Xubuntu parecia um pouco mais rústico do que
                aquilo a que eu estava acostumado, mas isso não me incomodou.
                Pelo contrário, comecei a gostar da simplicidade da interface.
              </p>
              <p>É claro que houve um período de adaptação.</p>
              <p>
                Eu precisava me acostumar com o terminal, descobrir onde estavam
                determinadas configurações e entender uma interface diferente da
                que utilizava no Windows.
              </p>
              <p>
                Uma das situações mais engraçadas foi descobrir como desligar o
                computador.
              </p>
              <p>
                Durante a primeira semana, eu simplesmente não conseguia
                encontrar o botão de desligar no Xubuntu. Minha solução foi
                utilizar um atalho de teclado para desligar o notebook. Só
                depois descobri onde estava a opção na interface.
              </p>
              <p>
                Hoje acho graça disso, mas é um bom exemplo de como grande parte
                das minhas dificuldades iniciais não tinha relação com problemas
                técnicos complexos. Era, principalmente, uma questão de costume.
              </p>
              <p>
                A distribuição também oferecia facilidades para instalar
                programas, incluindo uma loja de aplicativos. Aos poucos, fui
                deixando de depender exclusivamente da interface gráfica e
                comecei a utilizar mais o terminal.
              </p>
              <p>
                O que inicialmente parecia algo complicado passou a despertar
                minha curiosidade.
              </p>
              <p>
                E, principalmente, percebi que não sentia mais necessidade de
                voltar ao Windows.
              </p>
              <p>
                <strong class="text-v2-text font-medium">
                  O Xubuntu foi meu verdadeiro ponto de virada.
                </strong>{' '}
                Ele resolveu o problema que me levou a experimentar Linux e
                mostrou que eu poderia ter uma experiência completa sem depender
                do sistema operacional que havia utilizado durante tantos anos.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Capítulo 05 -->
      <section
        id="cap-5"
        aria-labelledby="cap-5-title"
        class="scroll-mt-8 py-16 lg:py-24"
      >
        <div class="mx-auto grid max-w-[66rem] grid-cols-1 gap-8 lg:grid-cols-[14rem_minmax(0,45rem)] lg:gap-10 xl:gap-14">
          <aside class="lg:pt-2">
            <div class="flex items-center gap-3">
              <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
                Capítulo 05
              </span>
              <span aria-hidden="true" class="bg-v2-border h-px w-5"></span>
            </div>
            <p class="font-v2-mono text-v2-text-muted mt-2 text-[0.625rem] tracking-[0.14em] uppercase">
              Proton &amp; Snap
            </p>
          </aside>

          <div>
            <h2
              id="cap-5-title"
              class="font-v2-display text-v2-text text-[clamp(1.85rem,2.8vw,2.75rem)] leading-[1.08] font-medium tracking-[-0.01em]"
            >
              Ubuntu: aprendizado, terminal e jogos
            </h2>

            <div class="font-v2-sans text-v2-text-body mt-7 space-y-5 text-sm leading-[1.9] font-light sm:text-[0.96875rem]">
              <p>
                Algum tempo depois, fiz um upgrade de memória RAM no notebook.
              </p>
              <p>
                Com mais recursos disponíveis, decidi experimentar o Ubuntu.
              </p>
              <p>
                Se o Xubuntu foi responsável por me conquistar, o Ubuntu ajudou
                a consolidar minha experiência com Linux.
              </p>
              <p>
                Passei a explorar mais o terminal, conhecer ferramentas do
                sistema e aprender sobre o funcionamento das distribuições.
              </p>
              <p>
                Também comecei a me interessar cada vez mais por jogos no Linux,
                principalmente por causa do Proton, tecnologia que permite
                executar muitos jogos desenvolvidos para Windows em sistemas
                Linux.
              </p>
              <p>
                Minha experiência com o Proton foi, de maneira geral, muito
                positiva.
              </p>
              <p>
                Ao contrário do que algumas pessoas imaginam, encontrei poucos
                problemas com a maioria dos jogos que tentei executar. A
                compatibilidade me surpreendeu e reforçou a ideia de que Linux
                já podia atender muito bem às minhas necessidades.
              </p>
              <p>Mas nem tudo eram flores.</p>

              <h3 class="border-v2-border/60 font-v2-display text-v2-text mt-10 border-t pt-8 text-2xl font-medium tracking-tight">
                A novela dos jogos da Ubisoft
              </h3>
              <p>
                Durante um período, executar jogos da Ubisoft foi uma verdadeira
                aventura — e não no bom sentido.
              </p>
              <p>
                O Ubisoft Connect, launcher utilizado pela empresa,
                frequentemente se recusava a abrir. Eu testava diferentes
                versões do Proton, procurava soluções alternativas e tentava
                todo tipo de gambiarra.
              </p>
              <p>
                Às vezes, parecia que nem por reza braba o negócio funcionaria.
              </p>
              <p>
                E quando finalmente conseguia abrir o launcher e iniciar o jogo,
                ainda existia outro problema: travamentos que aconteciam
                aproximadamente a cada 30 minutos, relacionados ao overlay do
                Ubisoft Connect.
              </p>
              <p>
                Era frustrante, principalmente porque os jogos em si nem sempre
                eram o verdadeiro problema. Muitas dificuldades estavam
                associadas ao software utilizado para executá-los.
              </p>
              <p>
                Felizmente, esse cenário melhorou com atualizações e versões
                mais recentes do Proton, e hoje já não enfrento aqueles mesmos
                problemas.
              </p>
              <p>
                Essa experiência também me ensinou algo importante: jogar no
                Linux evoluiu bastante, mas a compatibilidade ainda pode
                depender de launchers, atualizações e outros componentes além do
                próprio jogo.
              </p>

              <h3 class="border-v2-border/60 font-v2-display text-v2-text mt-10 border-t pt-8 text-2xl font-medium tracking-tight">
                A insatisfação com os Snaps
              </h3>
              <p>
                Com o passar do tempo, comecei a procurar maneiras de enxugar o
                Ubuntu e aproveitar melhor os recursos do notebook.
              </p>
              <p>
                Foi nesse processo que surgiu minha principal insatisfação com a
                distribuição: os pacotes Snap.
              </p>
              <p>
                Eu havia começado a associar Linux à liberdade de escolha.
                Entretanto, no Ubuntu, percebia que determinados aplicativos
                eram direcionados ao formato Snap, mesmo quando eu preferia
                utilizar pacotes tradicionais pelo APT.
              </p>
              <p>
                Isso me transmitia a sensação de estar preso a uma decisão que
                não era minha.
              </p>
              <p>
                Também me incomodava o armazenamento de revisões antigas de
                pacotes Snap, que podiam ocupar espaço adicional no SSD.
              </p>
              <p>
                Não significa que o Snap seja necessariamente ruim para todos.
                Ele possui suas propostas e vantagens, mas a maneira como estava
                integrado ao Ubuntu não combinava com aquilo que eu procurava.
              </p>

              <blockquote class="border-v2-border/80 bg-v2-surface/70 border-l-v2-accent my-8 border border-l-2 p-6 sm:p-7">
                <p class="font-v2-display text-v2-text text-xl leading-relaxed italic sm:text-2xl">
                  Para mim, Linux representava liberdade, e aquela experiência
                  com o Snap começou a parecer um cadeado.
                </p>
              </blockquote>

              <p>Foi então que decidi procurar outra distribuição.</p>
            </div>
