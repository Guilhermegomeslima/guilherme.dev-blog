---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OpenSourceCard from '../../components/content/OpenSourceCard.astro';
import DemoNotice from '../../components/ui/DemoNotice.astro';
import { withBase } from '../../utils/base';

const allTools = await getCollection('opensource');

// Ordenação alfabética original preservada
const sortedTools = [...allTools].sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'pt-BR'),
);

const hasDemoContent = allTools.some((t) => t.data.isDemo);

const categories = [...new Set(sortedTools.map((t) => t.data.category))];
const licenses = [
  ...new Set(sortedTools.map((t) => t.data.license).filter(Boolean)),
];
---

<BaseLayout
  variant="v2"
  title="Open Source & Ferramentas — guilherme.dev"
  description="Catálogo de softwares, programas e ferramentas de código aberto recomendados ou utilizados no dia a dia."
>
  <div class="relative overflow-hidden pb-20 md:pb-28">
    {/* Atmosfera de fundo sutil */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-[500px] overflow-hidden"
    >
      <img
        src={withBase('/images/home/open-source.webp')}
        alt=""
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover object-center opacity-[0.13] blur-[2px] filter"
      />
      <div
        class="absolute inset-0"
        style="background: radial-gradient(ellipse at 50% 0%, rgba(198, 166, 107, 0.14) 0%, rgba(7, 7, 9, 0.86) 62%, #070709 100%);"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(180deg, rgba(7, 7, 9, 0.4) 0%, rgba(7, 7, 9, 0.85) 68%, #070709 100%);"
      ></div>
    </div>

    <div class="relative mx-auto w-full max-w-[var(--container-v2)] px-5 sm:px-8">
      {/* Abertura Editorial */}
      <header class="border-b border-[var(--color-v2-border)] pt-12 pb-10 md:pt-16 md:pb-14">
        <div class="mb-4 flex items-center gap-3">
          <span
            aria-hidden="true"
            class="inline-block h-px w-8 bg-[var(--color-v2-accent-warm)]"
          ></span>
          <p class="v2-eyebrow text-[var(--color-v2-accent-warm)]">
            DIRETÓRIO DE SOFTWARE LIVRE / OPEN SOURCE
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <h1 class="font-[family-name:var(--font-v2-display)] text-4xl leading-[1.04] font-normal tracking-[-0.02em] text-[var(--color-v2-heading)] sm:text-5xl lg:text-6xl">
              Open Source &amp; Ferramentas.
            </h1>
          </div>

          <div class="lg:col-span-5">
            <p class="font-[family-name:var(--font-v2-sans)] text-sm leading-relaxed font-light text-[var(--color-v2-text)] sm:text-base">
              Diretório curado de programas, ambientes e utilitários de código
              aberto que compõem meu ecossistema no Linux — com identificação de
              categoria, licença e acesso exclusivo pelas páginas e repositórios
              oficiais.
            </p>
          </div>
        </div>

        {/* Painel de Síntese do Diretório */}
        <div class="mt-8 grid grid-cols-2 gap-3 border-t border-[var(--color-v2-border)] pt-6 sm:grid-cols-4">
          <div class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/65 px-4 py-3">
            <span class="block font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
              Programas Catalogados
            </span>
            <strong class="mt-1 block font-[family-name:var(--font-v2-display)] text-2xl font-normal text-[var(--color-v2-heading)]">
              {String(sortedTools.length).padStart(2, '0')} softwares
            </strong>
          </div>

          <div class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/65 px-4 py-3">
            <span class="block font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
              Categorias Técnicas
            </span>
            <strong class="mt-1 block font-[family-name:var(--font-v2-display)] text-2xl font-normal text-[var(--color-v2-accent-warm)]">
              {String(categories.length).padStart(2, '0')} áreas
            </strong>
          </div>

          <div class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/65 px-4 py-3">
            <span class="block font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
              Licenciamento
            </span>
            <strong class="mt-1 block truncate font-[family-name:var(--font-v2-mono)] text-xs font-normal text-[var(--color-v2-text)] sm:text-sm">
              {licenses.join(' · ')}
            </strong>
          </div>

          <div class="border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/65 px-4 py-3">
            <span class="block font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
              Verificação de Origem
            </span>
            <strong class="mt-1 block font-[family-name:var(--font-v2-display)] text-2xl font-normal text-[var(--color-v2-heading)]">
              Links oficiais
            </strong>
          </div>
        </div>
      </header>

      {hasDemoContent && <DemoNotice variant="section" class="mt-8" />}

      {/* Barra de Filtro por Categoria e Busca */}
      <section
        aria-label="Filtros do diretório Open Source"
        class="mt-8 border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/75 p-4 sm:p-6"
      >
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div
            class="flex flex-wrap items-center gap-1.5"
            role="group"
            aria-label="Filtrar por categoria de software"
          >
            <button
              type="button"
              data-os-cat="all"
              aria-pressed="true"
              class="v2-focus cursor-pointer border border-[var(--color-v2-accent-warm)]/60 bg-[var(--color-v2-accent-warm)]/15 px-3 py-1.5 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.12em] text-[var(--color-v2-heading)] uppercase transition-colors duration-200"
            >
              Todas ({sortedTools.length})
            </button>

            {categories.map((cat) => (
              <button
                type="button"
                data-os-cat={cat}
                aria-pressed="false"
                class="v2-focus cursor-pointer border border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]/70 px-3 py-1.5 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.12em] text-[var(--color-v2-muted)] uppercase transition-colors duration-200 hover:border-[var(--color-v2-border-hover)] hover:text-[var(--color-v2-text)]"
              >
                {cat}
              </button>
            ))}
          </div>

          <div class="w-full lg:max-w-xs">
            <label for="os-search" class="sr-only">
              Buscar programa por nome, categoria ou licença
            </label>
            <input
              id="os-search"
              type="search"
              placeholder="Buscar programa ou licença..."
              autocomplete="off"
              class="v2-focus w-full border border-[var(--color-v2-border)] bg-[var(--color-v2-bg)] px-3.5 py-2 font-[family-name:var(--font-v2-sans)] text-xs text-[var(--color-v2-heading)] placeholder:text-[var(--color-v2-muted)] focus:border-[var(--color-v2-accent-warm)]/60"
            />
          </div>
        </div>
      </section>

      {/* Seção 01: Dossiês do Diretório */}
      <section aria-label="Programas catalogados" class="mt-12">
        <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="font-[family-name:var(--font-v2-mono)] text-xs font-normal tracking-[0.2em] text-[var(--color-v2-accent-warm)] uppercase">
            01 // FICHAS DO DIRETÓRIO
          </h2>
          <div class="flex items-center gap-4">
            <span
              id="os-count-status"
              aria-live="polite"
              class="font-[family-name:var(--font-v2-mono)] text-xs text-[var(--color-v2-muted)]"
            >
              Exibindo {sortedTools.length} de {sortedTools.length} programas
            </span>
            <button
              id="os-reset-btn"
              type="button"
              hidden
              class="v2-focus cursor-pointer font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.14em] text-[var(--color-v2-accent-warm)] uppercase underline underline-offset-4 hover:text-[var(--color-v2-heading)]"
            >
              Limpar filtros
            </button>
          </div>
        </div>

        <div id="os-list" class="space-y-5">
          {sortedTools.map((tool, index) => (
            <OpenSourceCard tool={tool} index={index} />
          ))}
        </div>

        <div
          id="os-empty-state"
          hidden
          class="mt-8 border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/60 p-12 text-center"
        >
          <p class="font-[family-name:var(--font-v2-display)] text-2xl text-[var(--color-v2-heading)]">
            Nenhuma ferramenta encontrada com esse filtro.
          </p>
          <p class="mt-2 font-[family-name:var(--font-v2-sans)] text-sm font-light text-[var(--color-v2-muted)]">
            Selecione "Todas" ou busque por outro termo.
          </p>
        </div>
      </section>

      {/* Seção 02: Índice Rápido de Licenças e Links Oficiais */}
      <section
        aria-label="Índice rápido de licenças e links oficiais"
        class="mt-20 border-t border-[var(--color-v2-border)] pt-12"
      >
        <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
          <div>
            <span class="font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.2em] text-[var(--color-v2-muted)] uppercase">
              02 // QUADRO SINÓTICO DE REFERÊNCIA
            </span>
            <h2 class="mt-1 font-[family-name:var(--font-v2-display)] text-2xl font-normal text-[var(--color-v2-heading)] sm:text-3xl">
              Índice de Licenças &amp; Fontes Oficiais
            </h2>
          </div>
          <span class="font-[family-name:var(--font-v2-mono)] text-[11px] text-[var(--color-v2-muted)]">
            Acesso direto sem intermediários
          </span>
        </div>

        <div class="overflow-x-auto border border-[var(--color-v2-border)] bg-[var(--color-v2-surface)]/55">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]/80 font-[family-name:var(--font-v2-mono)] text-[10px] tracking-[0.18em] text-[var(--color-v2-muted)] uppercase">
                <th class="px-4 py-3.5">#</th>
                <th class="px-4 py-3.5">Software</th>
                <th class="px-4 py-3.5">Categoria</th>
                <th class="px-4 py-3.5">Licença</th>
                <th class="px-4 py-3.5 text-right">Links Oficiais</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--color-v2-border)] font-[family-name:var(--font-v2-sans)] text-xs">
              {sortedTools.map((tool, idx) => (
                <tr class="transition-colors hover:bg-[var(--color-v2-surface)]">
                  <td class="px-4 py-3.5 font-[family-name:var(--font-v2-mono)] text-[11px] text-[var(--color-v2-accent-warm)]">
                    {String(idx + 1).padStart(2, '0')}
                  </td>
                  <td class="px-4 py-3.5 font-medium text-[var(--color-v2-heading)]">
                    {tool.data.name}
                  </td>
                  <td class="px-4 py-3.5 text-[var(--color-v2-muted)]">
                    {tool.data.category}
                  </td>
                  <td class="px-4 py-3.5 font-[family-name:var(--font-v2-mono)] text-[11px] text-[var(--color-v2-text)]">
                    {tool.data.license || '—'}
                  </td>
                  <td class="px-4 py-3.5 text-right font-[family-name:var(--font-v2-mono)] text-[11px]">
                    <div class="inline-flex items-center justify-end gap-4">
                      {tool.data.websiteUrl && (
                        <a
                          href={tool.data.websiteUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="v2-focus text-[var(--color-v2-accent-warm)] hover:text-[var(--color-v2-heading)]"
                        >
                          Site &nearr;
                        </a>
                      )}
                      {tool.data.repoUrl && (
                        <a
                          href={tool.data.repoUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="v2-focus text-[var(--color-v2-muted)] hover:text-[var(--color-v2-heading)]"
                        >
                          Código &nearr;
                        </a>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {/* Navegação Cruzada no Rodapé */}
      <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--color-v2-border)] pt-8 font-[family-name:var(--font-v2-mono)] text-xs tracking-[0.14em] uppercase">
        <a
          href={withBase('/linux/')}
          class="v2-focus inline-flex items-center gap-2 text-[var(--color-v2-muted)] transition-colors hover:text-[var(--color-v2-heading)]"
        >
          <span aria-hidden="true" class="text-[var(--color-v2-accent-warm)]">
            &larr;
          </span>
          <span>Crônica &amp; Timeline Linux</span>
        </a>

        <a
          href={withBase('/projetos/')}
          class="v2-focus inline-flex items-center gap-2 text-[var(--color-v2-muted)] transition-colors hover:text-[var(--color-v2-heading)]"
        >
          <span>Projetos Autorais</span>
          <span aria-hidden="true" class="text-[var(--color-v2-accent-warm)]">
            &rarr;
          </span>
        </a>
      </footer>
    </div>
  </div>
</BaseLayout>

<script>
  import { matchesSearchTerms } from '../../utils/search';

  function initOpenSourceDirectory() {
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('[data-os-card]'),
    );
    if (cards.length === 0) return;

    const catButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-os-cat]'),
    );
    const searchInput = document.getElementById(
      'os-search',
    ) as HTMLInputElement | null;
    const countStatus = document.getElementById('os-count-status');
    const resetBtn = document.getElementById(
      'os-reset-btn',
    ) as HTMLButtonElement | null;
    const emptyState = document.getElementById('os-empty-state');

    let activeCat = 'all';
    const total = cards.length;

    function updateButtonStyles() {
      for (const btn of catButtons) {
        const isSelected = btn.dataset.osCat === activeCat;
        btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        if (isSelected) {
          btn.className =
            'v2-focus cursor-pointer border border-[var(--color-v2-accent-warm)]/60 bg-[var(--color-v2-accent-warm)]/15 px-3 py-1.5 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.12em] text-[var(--color-v2-heading)] uppercase transition-colors duration-200';
        } else {
          btn.className =
            'v2-focus cursor-pointer border border-[var(--color-v2-border)] bg-[var(--color-v2-bg)]/70 px-3 py-1.5 font-[family-name:var(--font-v2-mono)] text-[11px] tracking-[0.12em] text-[var(--color-v2-muted)] uppercase transition-colors duration-200 hover:border-[var(--color-v2-border-hover)] hover:text-[var(--color-v2-text)]';
        }
      }
    }

    function applyFilter() {
      const query = (searchInput?.value || '').trim();
      let visibleCount = 0;

      for (const card of cards) {
        const matchesCat =
          activeCat === 'all' || card.dataset.category === activeCat;
        const matchesQuery =
          !query ||
          matchesSearchTerms(
            `${card.dataset.name || ''} ${card.dataset.category || ''} ${card.dataset.description || ''} ${card.dataset.license || ''}`,
            query,
          );

        const isVisible = matchesCat && matchesQuery;
        card.hidden = !isVisible;
        if (isVisible) visibleCount++;
      }

      if (countStatus) {
        countStatus.textContent = `Exibindo ${visibleCount} de ${total} programas`;
      }

      const hasActiveFilters = activeCat !== 'all' || query.length > 0;
      if (resetBtn) {
        resetBtn.hidden = !hasActiveFilters;
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    }

    for (const btn of catButtons) {
      btn.addEventListener('click', () => {
        activeCat = btn.dataset.osCat || 'all';
        updateButtonStyles();
        applyFilter();
      });
    }

    searchInput?.addEventListener('input', applyFilter);

    resetBtn?.addEventListener('click', () => {
      activeCat = 'all';
      if (searchInput) searchInput.value = '';
      updateButtonStyles();
      applyFilter();
      searchInput?.focus({ preventScroll: true });
    });
  }

  initOpenSourceDirectory();
</script>
