---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/content/ProjectCard.astro';
import DemoNotice from '../../components/ui/DemoNotice.astro';
import { withBase } from '../../utils/base';

const allProjects = await getCollection('projects');

// Ordena projetos: primeiro os destacados, depois os demais em ordem alfabética
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.title.localeCompare(b.data.title);
});

const featuredCount = sortedProjects.filter((p) => p.data.featured).length;
const hasDemoContent = allProjects.some((p) => p.data.isDemo);
---

<BaseLayout
  variant="v2"
  title="Projetos & Aplicações — guilherme.dev"
  description="Catálogo de projetos, experimentos web e repositórios desenvolvidos por Guilherme Gomes."
>
  <div class="mx-auto w-full max-w-v2 px-6 pb-20 xl:px-0">
    <!-- Cabeçalho editorial do portfólio de projetos -->
    <header
      aria-labelledby="projetos-hero-title"
      class="border-v2-border/80 relative isolate overflow-hidden border-b pt-12 pb-16 lg:pt-20 lg:pb-24"
    >
      <!-- Fotografia atmosférica da categoria Projetos integrada ao fundo à direita -->
      <img
        src={withBase('/images/home/projetos.webp')}
        alt=""
        width="1400"
        height="933"
        decoding="async"
        class="v2-section-hero-photo pointer-events-none absolute top-0 right-0 -z-20 hidden h-full w-[55%] object-cover object-center opacity-28 brightness-[0.55] grayscale-[0.75] lg:block lg:[mask-image:linear-gradient(to_right,transparent,black_60%)]"
      />
      <div
        aria-hidden="true"
        class="from-v2-bg pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-linear-to-t to-transparent"
      ></div>

      <!-- Marcador lateral de seção -->
      <div
        aria-hidden="true"
        class="font-v2-mono text-v2-text-muted/50 absolute top-12 right-0 hidden items-center gap-3 text-[0.5rem] tracking-[0.2em] uppercase lg:top-20 lg:flex"
      >
        <span>Portfólio // SEC-01</span>
        <span class="bg-v2-accent/80 h-px w-8"></span>
      </div>

      <div class="max-w-4xl">
        <p class="v2-eyebrow text-v2-text-muted flex items-center gap-4 text-[0.625rem] tracking-[0.25em]">
          <span aria-hidden="true" class="bg-v2-accent h-px w-7"></span>
          Acervo de software
          <span aria-hidden="true" class="text-v2-text-muted/50">
            /
          </span>
          Projetos
        </p>

        <h1
          id="projetos-hero-title"
          class="font-v2-display text-v2-text mt-7 text-[clamp(2.5rem,4.6vw,4.9rem)] leading-[0.95] font-medium tracking-[-0.02em]"
        >
          Projetos, experimentos
          <br />e{' '}
          <em class="from-v2-text to-v2-text-muted bg-linear-to-r bg-clip-text pr-[0.08em] font-medium text-transparent italic">
            aplicações.
          </em>
        </h1>

        <p class="font-v2-sans text-v2-text-muted mt-8 max-w-[38rem] text-sm leading-[1.85] font-light sm:text-base">
          Repositórios de código, experimentos web e ferramentas em
          desenvolvimento prático, apresentados com capturas reais e fichas
          técnicas completas.
        </p>
      </div>

      <!-- Barra síntese do acervo de projetos -->
      <div class="border-v2-border/70 bg-v2-surface/45 mt-12 flex flex-col justify-between gap-4 border px-5 py-4 sm:flex-row sm:items-center lg:mt-16">
        <div class="flex flex-wrap items-center gap-x-8 gap-y-2">
          <div class="flex items-center gap-2.5">
            <span
              aria-hidden="true"
              class="bg-v2-accent inline-block size-1.5"
            ></span>
            <span class="font-v2-mono text-v2-text-muted text-[0.5625rem] tracking-[0.18em] uppercase">
              Total catalogado:{' '}
              <strong class="text-v2-text font-normal">
                {String(sortedProjects.length).padStart(2, '0')} projetos
              </strong>
            </span>
          </div>

          <div class="flex items-center gap-2.5">
            <span
              aria-hidden="true"
              class="bg-v2-accent-warm/80 inline-block size-1.5"
            ></span>
            <span class="font-v2-mono text-v2-text-muted text-[0.5625rem] tracking-[0.18em] uppercase">
              Em destaque:{' '}
              <strong class="text-v2-text font-normal">
                {String(featuredCount).padStart(2, '0')} registros
              </strong>
            </span>
          </div>
        </div>

        <a
          href="https://github.com/Guilhermegomeslima?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="v2-focus group font-v2-mono text-v2-accent-warm hover:text-v2-text inline-flex items-center gap-2 text-[0.5625rem] tracking-[0.2em] uppercase transition-colors motion-reduce:transition-none"
        >
          <span>Ver perfil completo no GitHub</span>
          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none"
          >
            ↗
          </span>
        </a>
      </div>
    </header>

    {hasDemoContent && <DemoNotice variant="section" class="mt-10" />}

    <!-- Lista editorial de showcases horizontais -->
    <section aria-label="Projetos catalogados" class="mt-14 lg:mt-20">
      <div class="flex flex-col gap-12 lg:gap-16">
        {sortedProjects.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    </section>

    <!-- Fechamento discreto com atalhos relacionados -->
    <div class="border-v2-border/80 bg-v2-surface/40 mt-20 grid grid-cols-1 divide-y divide-v2-border/60 border sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:mt-28">
      <a
        href={withBase('/sobre/')}
        class="v2-focus group hover:bg-v2-surface flex flex-col justify-between p-6 transition-colors motion-reduce:transition-none"
      >
        <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
          Arquivo Pessoal // Sobre
        </span>
        <p class="font-v2-display text-v2-text group-hover:text-v2-accent-warm mt-2 text-xl leading-snug font-medium transition-colors">
          Conhecer a formação, trajetória e repertório técnico por trás dos
          projetos →
        </p>
      </a>

      <a
        href="https://github.com/Guilhermegomeslima"
        target="_blank"
        rel="noopener noreferrer"
        class="v2-focus group hover:bg-v2-surface flex flex-col justify-between p-6 transition-colors motion-reduce:transition-none"
      >
        <span class="font-v2-mono text-v2-accent-warm text-[0.5625rem] tracking-[0.2em] uppercase">
          Código Fonte // GitHub
        </span>
        <p class="font-v2-display text-v2-text group-hover:text-v2-accent-warm mt-2 text-xl leading-snug font-medium transition-colors">
          Explorar todos os repositórios públicos e contribuições ↗
        </p>
      </a>
    </div>
  </div>
</BaseLayout>
